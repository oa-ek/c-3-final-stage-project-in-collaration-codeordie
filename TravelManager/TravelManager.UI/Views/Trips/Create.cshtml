@model TravelManager.UI.Models.ViewModels.CreateTripViewModel

@{
    ViewData["Title"] = "Створити поїздку";
}

<style>
    @@keyframes slideUpFade {
        from {
            opacity: 0;
            transform: translateY(30px) scale(0.97);
        }

        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    @@keyframes shimmer {
        0% {
            transform: translateX(-150%) skewX(-15deg);
        }

        100% {
            transform: translateX(150%) skewX(-15deg);
        }
    }

    @@keyframes ping {
        75%, 100% {
            transform: scale(2);
            opacity: 0;
        }
    }

    @@keyframes gradShift {
        0%, 100% {
            background-position: 0% 50%;
        }

        50% {
            background-position: 100% 50%;
        }
    }

    .stagger-1 {
        animation: slideUpFade .7s cubic-bezier(.16,1,.3,1) .05s both;
    }

    .stagger-2 {
        animation: slideUpFade .7s cubic-bezier(.16,1,.3,1) .15s both;
    }

    .stagger-3 {
        animation: slideUpFade .7s cubic-bezier(.16,1,.3,1) .25s both;
    }

    .stagger-4 {
        animation: slideUpFade .7s cubic-bezier(.16,1,.3,1) .35s both;
    }

    .stagger-5 {
        animation: slideUpFade .7s cubic-bezier(.16,1,.3,1) .45s both;
    }

    .stagger-6 {
        animation: slideUpFade .7s cubic-bezier(.16,1,.3,1) .55s both;
    }

    .animate-ping {
        animation: ping 1.5s cubic-bezier(0,0,.2,1) infinite;
    }

    /* animated gradient title */
    .grad-title {
        background: linear-gradient(120deg, #6366f1, #ec4899, #3b82f6, #6366f1);
        background-size: 250% 250%;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        animation: gradShift 6s ease infinite;
    }

    /* field */
    .tm-field {
        position: relative;
        display: flex;
        flex-direction: column;
        gap: .35rem;
    }

    .tm-label {
        font-size: .68rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: .12em;
        color: #64748b;
        padding-left: .25rem;
    }

    .tm-input-wrap {
        position: relative;
        background: white;
        border: 1.5px solid #e2e8f0;
        border-radius: 20px;
        display: flex;
        align-items: center;
        transition: border-color .2s, box-shadow .2s;
        overflow: hidden;
    }

        .tm-input-wrap:focus-within {
            border-color: #6366f1;
            box-shadow: 0 0 0 4px rgba(99,102,241,.1);
        }

        .tm-input-wrap i {
            flex-shrink: 0;
            padding: 0 0 0 1.1rem;
            font-size: 1.1rem;
            pointer-events: none;
        }

        .tm-input-wrap input,
        .tm-input-wrap textarea,
        .tm-input-wrap select {
            width: 100%;
            background: transparent;
            border: none;
            outline: none;
            font-size: .95rem;
            font-weight: 700;
            color: #0f172a;
            padding: .85rem 1.1rem;
            font-family: inherit;
        }

        .tm-input-wrap textarea {
            resize: none;
            padding-top: .9rem;
        }

    /* big title input */
    .title-input {
        width: 100%;
        background: transparent;
        border: none;
        border-bottom: 2.5px solid #e2e8f0;
        outline: none;
        font-size: clamp(1.8rem, 4vw, 2.6rem);
        font-weight: 900;
        color: #0f172a;
        padding: .5rem 0 .75rem;
        transition: border-color .2s;
        font-family: inherit;
        letter-spacing: -.02em;
    }

        .title-input:focus {
            border-color: #6366f1;
        }

        .title-input::placeholder {
            color: #cbd5e1;
        }

    /* custom select */
    .custom-scrollbar::-webkit-scrollbar {
        width: 5px;
    }

    .custom-scrollbar::-webkit-scrollbar-thumb {
        background: rgba(99,102,241,.3);
        border-radius: 10px;
    }

    /* date picker icon */
    input[type="date"]::-webkit-calendar-picker-indicator {
        background-color: transparent;
        padding: 4px;
        cursor: pointer;
        opacity: .5;
    }

    /* submit btn */
    .submit-btn {
        position: relative;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: .6rem;
        padding: 1rem 2.5rem;
        border-radius: 100px;
        border: none;
        cursor: pointer;
        overflow: hidden;
        font-weight: 900;
        font-size: .85rem;
        letter-spacing: .1em;
        text-transform: uppercase;
        color: white;
        background: linear-gradient(135deg, #4f46e5, #6366f1);
        box-shadow: 0 10px 30px rgba(99,102,241,.4);
        transition: transform .25s, box-shadow .25s;
        font-family: inherit;
    }

        .submit-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 15px 40px rgba(99,102,241,.5);
        }

        .submit-btn::after {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,.25), transparent);
            transform: translateX(-150%) skewX(-15deg);
        }

        .submit-btn:hover::after {
            animation: shimmer 1.4s infinite;
        }

    /* left panel feature pills */
    .feat-pill {
        display: inline-flex;
        align-items: center;
        gap: .5rem;
        background: white;
        border: 1px solid #e2e8f0;
        border-radius: 100px;
        padding: .5rem 1rem;
        font-size: .8rem;
        font-weight: 700;
        color: #475569;
        box-shadow: 0 2px 8px rgba(0,0,0,.04);
    }

    /* validation */
    .val-msg {
        font-size: .72rem;
        font-weight: 700;
        color: #ef4444;
        padding-left: .3rem;
        margin-top: .15rem;
    }
</style>

<div class="min-h-screen py-12 px-4">
    <div class="max-w-6xl mx-auto">

        <!-- Two-column layout -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">

            <!-- LEFT: editorial headline -->
            <div class="stagger-1 hidden lg:flex flex-col gap-8">

                <div>
                    <p class="text-indigo-500 font-black uppercase tracking-[.2em] text-xs mb-5 flex items-center gap-2">
                        <span class="relative flex h-2 w-2">
                            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-indigo-400 opacity-75"></span>
                            <span class="relative inline-flex rounded-full h-2 w-2 bg-indigo-500"></span>
                        </span>
                        Нова подорож
                    </p>

                    <h1 class="text-7xl font-black text-slate-900 tracking-tighter leading-none mb-4">
                        Світ<br>чекає<span class="grad-title">.</span>
                    </h1>
                    <p class="grad-title text-5xl font-black tracking-tighter leading-none">
                        Плануй зараз.
                    </p>
                </div>

                <p class="text-slate-500 text-lg leading-relaxed max-w-sm">
                    Заповни форму — і твоя нова пригода одразу з'явиться у стрічці поїздок. Ти автоматично станеш організатором.
                </p>

                <!-- Feature pills -->
                <div class="flex flex-wrap gap-3 stagger-2">
                    <span class="feat-pill"><i class="bi bi-map-fill text-blue-500"></i> Маршрут</span>
                    <span class="feat-pill"><i class="bi bi-wallet2 text-emerald-500"></i> Бюджет</span>
                    <span class="feat-pill"><i class="bi bi-people-fill text-violet-500"></i> Команда</span>
                    <span class="feat-pill"><i class="bi bi-robot text-indigo-500"></i> AI-поради</span>
                    <span class="feat-pill"><i class="bi bi-cloud-sun-fill text-amber-500"></i> Погода</span>
                    <span class="feat-pill"><i class="bi bi-check2-square text-teal-500"></i> Чеклісти</span>
                </div>

                <!-- Decorative orbs -->
                <div class="relative h-40 mt-4 overflow-hidden rounded-3xl stagger-3">
                    <div class="absolute inset-0 bg-gradient-to-br from-indigo-100 via-purple-50 to-pink-100 rounded-3xl"></div>
                    <div class="absolute top-4 left-6 w-24 h-24 bg-blue-400/30 rounded-full blur-2xl"></div>
                    <div class="absolute bottom-4 right-6 w-20 h-20 bg-pink-400/30 rounded-full blur-2xl"></div>
                    <div class="absolute inset-0 flex items-center justify-center">
                        <p class="text-slate-600 font-black text-center text-lg tracking-tight px-6">
                            Будуй маршрути, контролюй бюджет<br>
                            <span class="text-indigo-500">та пакуй валізи без стресу.</span>
                        </p>
                    </div>
                </div>
            </div>

            <!-- RIGHT: form card -->
            <div class="stagger-2">
                <!-- Mobile-only header -->
                <div class="lg:hidden mb-8">
                    <h1 class="text-5xl font-black text-slate-900 tracking-tighter">
                        Нова<br><span class="grad-title">пригода</span>
                    </h1>
                    <p class="text-slate-500 mt-2 text-sm">Ти автоматично станеш організатором</p>
                </div>

                <div class="bg-white/70 backdrop-blur-2xl border border-white/90 rounded-[2.5rem] p-8 md:p-10 shadow-[0_24px_64px_-12px_rgba(0,0,0,0.08)]">

                    <form asp-action="Create" method="post" class="space-y-6">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="text-red-600 text-sm font-bold bg-red-50 border border-red-100 rounded-2xl p-4"></div>

                        <!-- Title -->
                        <div class="tm-field stagger-2">
                            <span class="tm-label">Назва поїздки</span>
                            <input asp-for="Title"
                                   class="title-input"
                                   placeholder="Дай назву цій історії..." />
                            <span asp-validation-for="Title" class="val-msg"></span>
                        </div>

                        <!-- Description -->
                        <div class="tm-field stagger-3">
                            <span class="tm-label">Опис</span>
                            <div class="tm-input-wrap" style="align-items:flex-start;">
                                <textarea asp-for="Description"
                                          rows="3"
                                          placeholder="Нотатки, деталі, мрії про цю поїздку..."></textarea>
                            </div>
                        </div>

                        <!-- Departure / Return -->
                        <div class="grid grid-cols-2 gap-4 stagger-3">
                            <div class="tm-field">
                                <span class="tm-label">Звідки</span>
                                <div class="tm-input-wrap">
                                    <i class="bi bi-geo-alt-fill text-blue-500"></i>
                                    <input asp-for="DepartureLocation" placeholder="Місто відправлення" />
                                </div>
                                <span asp-validation-for="DepartureLocation" class="val-msg"></span>
                            </div>
                            <div class="tm-field">
                                <span class="tm-label">Куди (повернення)</span>
                                <div class="tm-input-wrap">
                                    <i class="bi bi-geo-fill text-emerald-500"></i>
                                    <input asp-for="ReturnLocation" placeholder="Місто повернення" />
                                </div>
                                <span asp-validation-for="ReturnLocation" class="val-msg"></span>
                            </div>
                        </div>

                        <!-- Dates -->
                        <div class="grid grid-cols-2 gap-4 stagger-4">
                            <div class="tm-field">
                                <span class="tm-label">Дата початку</span>
                                <div class="tm-input-wrap">
                                    <i class="bi bi-calendar-event text-amber-500"></i>
                                    <input asp-for="StartDate" type="date" />
                                </div>
                                <span asp-validation-for="StartDate" class="val-msg"></span>
                            </div>
                            <div class="tm-field">
                                <span class="tm-label">Дата завершення</span>
                                <div class="tm-input-wrap">
                                    <i class="bi bi-calendar-check text-amber-500"></i>
                                    <input asp-for="EndDate" type="date" />
                                </div>
                                <span asp-validation-for="EndDate" class="val-msg"></span>
                            </div>
                        </div>

                        <!-- Currency -->
                        <div class="tm-field stagger-5" style="position:relative; z-index:60;">
                            <span class="tm-label">Валюта подорожі</span>

                            <select asp-for="BaseCurrency" asp-items="ViewBag.CurrencyList"
                                    class="sr-only real-select" id="BaseCurrency"></select>

                            <div class="custom-dropdown" style="position:relative;">
                                <button type="button"
                                        class="tm-input-wrap w-full text-left cursor-pointer"
                                        style="padding:.85rem 1.1rem; border-radius:20px;"
                                        onclick="toggleDropdown(this)">
                                    <i class="bi bi-cash-coin text-violet-500" style="padding:0 .6rem 0 0; font-size:1.1rem; flex-shrink:0;"></i>
                                    <span class="selected-text font-bold text-slate-800 flex-1">
                                        @(((IEnumerable<SelectListItem>)ViewBag.CurrencyList)?.FirstOrDefault(x => x.Selected)?.Text ?? "UAH (Українська гривня)")
                                    </span>
                                    <i class="bi bi-chevron-down text-slate-400 transition-transform duration-300" style="flex-shrink:0;"></i>
                                </button>

                                <div class="dropdown-menu"
                                     style="position:absolute;left:0;right:0;top:calc(100% + 6px);background:white;border:1.5px solid #e2e8f0;border-radius:20px;box-shadow:0 20px 50px -10px rgba(0,0,0,.12);opacity:0;visibility:hidden;transform:translateY(8px);transition:all .25s;z-index:70;overflow:hidden;">
                                    <ul class="max-h-52 overflow-y-auto py-2 custom-scrollbar">
                                        @if (ViewBag.CurrencyList != null)
                                        {
                                            foreach (var item in ViewBag.CurrencyList)
                                            {
                                                <li class="px-5 py-3 text-slate-700 font-bold text-sm cursor-pointer hover:bg-indigo-50 hover:text-indigo-600 transition-colors"
                                                    onclick="selectItem(this, '@item.Value')">@item.Text</li>
                                            }
                                        }
                                    </ul>
                                </div>
                            </div>
                            <span asp-validation-for="BaseCurrency" class="val-msg"></span>
                        </div>

                        <!-- Actions -->
                        <div class="flex items-center justify-between pt-4 border-t border-slate-100 stagger-6">
                            <a asp-action="Index"
                               class="text-sm font-black text-slate-400 hover:text-slate-700 uppercase tracking-widest transition-colors">
                                Скасувати
                            </a>
                            <button type="submit" class="submit-btn">
                                <span>Створити</span>
                                <i class="bi bi-rocket-takeoff-fill text-lg"></i>
                            </button>
                        </div>

                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Date validation
        const startDate = document.getElementById('StartDate');
        const endDate   = document.getElementById('EndDate');
        startDate?.addEventListener('change', () => {
            if (endDate && endDate.value && endDate.value < startDate.value)
                endDate.value = startDate.value;
            if (endDate) endDate.min = startDate.value;
        });

        // Custom currency dropdown
        window.toggleDropdown = function(button) {
            const dropdown = button.closest('.custom-dropdown');
            const menu = dropdown.querySelector('.dropdown-menu');
            const icon = button.querySelector('.bi-chevron-down');
            const isOpen = menu.style.opacity === '1';

            // Close all
            document.querySelectorAll('.dropdown-menu').forEach(m => {
                m.style.opacity = '0';
                m.style.visibility = 'hidden';
                m.style.transform = 'translateY(8px)';
            });
            document.querySelectorAll('.bi-chevron-down').forEach(i => i.style.transform = '');

            if (!isOpen) {
                menu.style.opacity = '1';
                menu.style.visibility = 'visible';
                menu.style.transform = 'translateY(0)';
                if (icon) icon.style.transform = 'rotate(180deg)';
            }
        };

        window.selectItem = function(li, value) {
            const dropdown = li.closest('.custom-dropdown');
            const menu = dropdown.querySelector('.dropdown-menu');
            const btn  = dropdown.querySelector('.selected-text');
            const real = document.getElementById('BaseCurrency');
            const icon = dropdown.querySelector('.bi-chevron-down');

            if (btn) { btn.textContent = li.innerText.trim(); }
            if (real) { real.value = value; real.dispatchEvent(new Event('change')); }
            menu.style.opacity = '0';
            menu.style.visibility = 'hidden';
            menu.style.transform = 'translateY(8px)';
            if (icon) icon.style.transform = '';
        };

        document.addEventListener('click', e => {
            if (!e.target.closest('.custom-dropdown')) {
                document.querySelectorAll('.dropdown-menu').forEach(m => {
                    m.style.opacity = '0';
                    m.style.visibility = 'hidden';
                    m.style.transform = 'translateY(8px)';
                });
                document.querySelectorAll('.bi-chevron-down').forEach(i => i.style.transform = '');
            }
        });
    </script>
}
