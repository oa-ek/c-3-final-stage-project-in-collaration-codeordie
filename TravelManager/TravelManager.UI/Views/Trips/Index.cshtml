@* 📄 TravelManager/TravelManager.UI/Views/Trips/Index.cshtml *@

@model IEnumerable<TravelManager.UI.Models.ViewModels.TripListViewModel>

@{
    ViewData["Title"] = "Мої поїздки";
}

<style>
    @@keyframes fadeSlideUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .stagger-item {
        animation: fadeSlideUp 0.7s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        opacity: 0;
    }

    /* Video background */
    .trip-card-video {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        z-index: -10;
        transition: opacity .6s ease;
        opacity: 0;
    }

        .trip-card-video.loaded {
            opacity: 1;
        }

    .trip-card-img-fallback {
        position: absolute;
        inset: 0;
        background-size: cover;
        background-position: center;
        z-index: -11;
        transition: transform 1s ease;
    }

    .group:hover .trip-card-img-fallback {
        transform: scale(1.08);
    }

    /* Skeleton pulse while video loads */
    @@keyframes skeletonPulse {
        0%, 100% {
            opacity: .4;
        }

        50% {
            opacity: .8;
        }
    }

    .video-skeleton {
        position: absolute;
        inset: 0;
        background: linear-gradient(135deg, #1e293b, #0f172a);
        z-index: -9;
        animation: skeletonPulse 1.8s ease-in-out infinite;
    }

        .video-skeleton.hidden {
            display: none;
        }
</style>

@if (Model != null)
{
    var fallbacks = new string[]
    {
        "https://images.unsplash.com/photo-1499793983690-e29da59ef1c2?auto=format&fit=crop&w=800&q=80",
        "https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?auto=format&fit=crop&w=800&q=80",
        "https://images.unsplash.com/photo-1502602898657-3e90760b2160?auto=format&fit=crop&w=800&q=80",
        "https://images.unsplash.com/photo-1488646953014-85cb44e25828?auto=format&fit=crop&w=800&q=80",
        "https://images.unsplash.com/photo-1476514525535-07fb3b4ae5f1?auto=format&fit=crop&w=800&q=80"
    };
    int idx = 0;

    <div class="max-w-7xl mx-auto py-10 px-4">

        <div class="flex flex-col md:flex-row justify-between items-end mb-12 gap-6 stagger-item" style="animation-delay: 0.1s;">
            <div>
                <h2 class="text-6xl font-black text-slate-900 tracking-tighter leading-tight">Мої поїздки</h2>
                <p class="text-slate-500 mt-2 text-lg font-medium italic">Твої пригоди у світлих тонах.</p>
            </div>
            <a asp-action="Create" class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-4 px-8 rounded-full shadow-lg transition-all hover:-translate-y-1">
                <i class="bi bi-plus-lg"></i> Створити нову
            </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10">
            @foreach (var item in Model)
            {
                string fallback = fallbacks[idx % fallbacks.Length];
                bool canManage = item.CurrentUserRole == "Organizer";
                bool isOrganizer = item.CurrentUserRole == "Organizer";

                <!-- Search query: prefer departure location, fallback to title -->
                string videoQuery = !string.IsNullOrWhiteSpace(item.DepartureLocation)
                ? item.DepartureLocation
                : item.Title;

                <div class="relative h-[520px] rounded-[3rem] overflow-hidden group shadow-xl transition-all duration-500 hover:-translate-y-2 isolate stagger-item"
                     style="animation-delay: @(0.15 * (idx + 1))s;"
                     data-video-query="@videoQuery">

                    <!-- Skeleton loader -->
                    <div class="video-skeleton"></div>

                    <!-- Fallback image (always behind) -->
                    <div class="trip-card-img-fallback" style="background-image: url('@fallback');"></div>

                    <!-- Video element (filled by JS) -->
                    <video class="trip-card-video"
                           autoplay muted loop playsinline
                           preload="none">
                    </video>

                    <!-- Gradient overlay -->
                    <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-900/20 to-transparent opacity-90" style="z-index:-1;"></div>

                    <!-- Status & role badges -->
                    <div class="absolute top-6 left-6 z-20 flex gap-2">
                        <div class="bg-white/20 backdrop-blur-md border border-white/20 text-white text-[10px] font-black uppercase tracking-widest px-4 py-2 rounded-full">
                            <span class="inline-block w-1.5 h-1.5 rounded-full bg-emerald-400 mr-1 animate-pulse"></span>
                            @item.StatusName
                        </div>
                        <div class="bg-white/20 backdrop-blur-md border border-white/20 text-white text-[10px] font-black uppercase tracking-widest px-4 py-2 rounded-full">
                            @if (isOrganizer)
                            {
                                <i class="bi bi-star-fill text-yellow-300 mr-1"></i>
                            }
                            else if (item.CurrentUserRole == "Participant")
                            {
                                <i class="bi bi-person-fill text-blue-300 mr-1"></i>
                            }
                            else
                            {
                                <i class="bi bi-eye-fill text-white/60 mr-1"></i>
                            }
                            @item.CurrentUserRole
                        </div>
                    </div>

                    <!-- Content -->
                    <div class="absolute inset-0 p-8 flex flex-col justify-end z-10">
                        <h3 class="text-4xl font-black text-white mb-6 drop-shadow-xl transition-transform duration-500 group-hover:-translate-y-2">
                            @item.Title
                        </h3>

                        <div class="bg-white/10 backdrop-blur-xl border border-white/20 rounded-[2.5rem] p-6 space-y-4 transition-transform duration-500 group-hover:-translate-y-2 shadow-inner">
                            <div class="flex items-center gap-4 text-white">
                                <span class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center border border-white/10">
                                    <i class="bi bi-geo-alt-fill"></i>
                                </span>
                                <div>
                                    <p class="text-[9px] uppercase tracking-widest font-bold opacity-60">Відправлення</p>
                                    <p class="font-bold">@item.DepartureLocation</p>
                                </div>
                            </div>
                            <div class="flex items-center gap-4 text-white">
                                <span class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center border border-white/10">
                                    <i class="bi bi-calendar-event-fill"></i>
                                </span>
                                <div>
                                    <p class="text-[9px] uppercase tracking-widest font-bold opacity-60">Дати</p>
                                    <p class="font-bold">@item.StartDate.ToShortDateString() — @item.EndDate.ToShortDateString()</p>
                                </div>
                            </div>
                        </div>

                        <div class="mt-6 flex flex-col gap-4 transition-all duration-500 group-hover:-translate-y-2">
                            <a asp-action="Details" asp-route-id="@item.Id"
                               class="w-full bg-white/15 hover:bg-white/25 backdrop-blur-md border border-white/30 text-white font-black py-5 px-8 rounded-3xl flex justify-between items-center transition-all duration-300 group/btn shadow-lg">
                                <span class="uppercase tracking-widest text-sm">Відкрити поїздку</span>
                                <i class="bi bi-arrow-right text-xl transition-transform group-hover/btn:translate-x-2"></i>
                            </a>

                            @if (canManage)
                            {
                                <div class="flex justify-between items-center px-4 opacity-0 group-hover:opacity-100 transition-opacity delay-150">
                                    <a asp-action="Edit" asp-route-id="@item.Id"
                                       class="text-[10px] font-black text-white/60 hover:text-white uppercase tracking-widest flex items-center gap-1.5">
                                        <i class="bi bi-pencil-square"></i> Редагувати
                                    </a>
                                    @if (isOrganizer)
                                    {
                                        <form asp-action="Delete" method="post"
                                              onsubmit="return confirm('Видалити поїздку @item.Title?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit"
                                                    class="text-[10px] font-black text-white/40 hover:text-rose-400 uppercase tracking-widest flex items-center gap-1.5">
                                                <i class="bi bi-trash3"></i> Видалити
                                            </button>
                                        </form>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>

                idx++;
            }
        </div>
    </div>
}

@section Scripts {
    <script>
        (async function () {
            // Cache video URLs in sessionStorage so repeated navigation is instant
            const CACHE_PREFIX = 'pexels_v_';

            async function fetchVideoUrl(query) {
                const key = CACHE_PREFIX + query.toLowerCase();
                const cached = sessionStorage.getItem(key);
                if (cached) return cached;

                try {
                    const res = await fetch(`/PexelsProxy/Video?query=${encodeURIComponent(query)}`);
                    if (!res.ok) return null;
                    const data = await res.json();

                    // Pick a random video from results for variety
                    const videos = data.videos ?? [];
                    if (!videos.length) return null;

                    // Pick random video
                    const video = videos[Math.floor(Math.random() * Math.min(videos.length, 5))];

                    // Prefer HD file, fallback to first
                    const files = video.video_files ?? [];
                    const hd = files.find(f => f.quality === 'hd' && f.width >= 1280)
                             || files.find(f => f.quality === 'sd')
                             || files[0];

                    const url = hd?.link ?? null;
                    if (url) sessionStorage.setItem(key, url);
                    return url;
                } catch {
                    return null;
                }
            }

            // Load videos for all cards with a small stagger so we don't hammer the API
            const cards = document.querySelectorAll('[data-video-query]');

            for (let i = 0; i < cards.length; i++) {
                const card = cards[i];
                const query = card.dataset.videoQuery;
                if (!query) continue;

                // Stagger requests slightly
                await new Promise(r => setTimeout(r, i * 250));

                const url = await fetchVideoUrl(query);
                const skeleton = card.querySelector('.video-skeleton');
                const videoEl  = card.querySelector('.trip-card-video');

                if (!url || !videoEl) {
                    // No video — just hide skeleton, fallback image shows
                    skeleton?.classList.add('hidden');
                    continue;
                }

                videoEl.src = url;
                videoEl.load();

                videoEl.addEventListener('canplay', () => {
                    videoEl.classList.add('loaded');
                    skeleton?.classList.add('hidden');
                    videoEl.play().catch(() => {}); // ignore autoplay policy errors
                }, { once: true });

                // If video fails, hide skeleton and show fallback
                videoEl.addEventListener('error', () => {
                    skeleton?.classList.add('hidden');
                }, { once: true });
            }
        })();
    </script>
}
