            <!-- BUDGET -->
            <div class="dark-glass-card" style="animation-delay:.05s;">
                <div style="display:flex;justify-content:space-between;align-items:center;">
                    <div style="font-size:.7rem;font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:rgba(255,255,255,.45);">Загальний бюджет</div>
                    <a asp-controller="Expenses" asp-action="Create" asp-route-tripId="@Model.Trip.Id"
                       style="background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.18);border-radius:50px;padding:.38rem 1rem;color:white;text-decoration:none;font-size:.72rem;font-weight:700;transition:all .2s;"
                       onmouseover="this.style.background='rgba(255,255,255,.15)'"
                       onmouseout="this.style.background='rgba(255,255,255,.08)'">
                        + Витрата
                    </a>
                </div>
                <div class="budget-amount">@totalBudget.ToString("N0") @baseCurr</div>
                <div style="font-size:.82rem;color:rgba(255,255,255,.4);">@Model.Expenses.Count() витрат · з конвертацією</div>
            </div>

            <!-- ACCOMMODATION -->
            <div class="light-glass-card" style="animation-delay:.1s;">
                <div class="card-header">
                    <div class="card-header-title">
                        <div class="icon-box" style="background:linear-gradient(135deg,#14b8a6,#0d9488);"><i class="bi bi-building"></i></div>
                        Житло
                    </div>
                    <div style="display:flex;align-items:center;gap:.4rem;">
                        <a href="@bookingUrl" target="_blank" class="btn-add-small" style="background:linear-gradient(135deg,#6366f1,#ec4899);color:white;border:none;box-shadow:0 3px 10px rgba(99,102,241,.25);">
                            <i class="bi bi-globe"></i> Booking
                        </a>
                        <a asp-controller="Accommodations" asp-action="Create" asp-route-tripId="@Model.Trip.Id" class="btn-add-small">+ Додати</a>
                    </div>
                </div>
                <div style="padding:1.3rem;">
                    @if (!Model.Accommodations.Any())
                    {
                        <div style="color:#94a3b8;font-style:italic;font-size:.9rem;">Житло ще не додано.</div>
                    }
                    else
                    {
                        @foreach (var a in Model.Accommodations)
                        {
                            <div class="list-item-card">
                                <div style="font-family:'Montserrat';font-weight:800;color:#111827;font-size:1rem;margin-bottom:.2rem;">@a.Name</div>
                                <div style="font-size:.82rem;color:#64748b;margin-bottom:.7rem;">@a.Address</div>
                                <div style="display:flex;justify-content:space-between;align-items:center;">
                                    <span style="font-size:.78rem;font-weight:700;color:#475569;background:rgba(0,0,0,.04);padding:.2rem .6rem;border-radius:50px;">
                                        <i class="bi bi-calendar-check me-1"></i>@a.CheckInTime.ToString("dd.MM.yyyy")
                                    </span>
                                    <a asp-controller="Accommodations" asp-action="Edit" asp-route-id="@a.Id" style="font-size:.78rem;color:#6366f1;font-weight:800;text-decoration:none;">Ред.</a>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>

            <!-- CHECKLISTS -->
            <div class="light-glass-card" style="animation-delay:.15s;">
                <div class="card-header">
                    <div class="card-header-title">
                        <div class="icon-box" style="background:linear-gradient(135deg,#64748b,#475569);"><i class="bi bi-check2-square"></i></div>
