                </div>
            </div>

            <!-- TRANSPORT -->
            <div class="light-glass-card" style="animation-delay:.2s;">
                <div class="card-header">
                    <div class="card-header-title">
                        <div class="icon-box" style="background:linear-gradient(135deg,#8b5cf6,#6366f1);"><i class="bi bi-airplane-fill"></i></div>
                        Транспорт
                    </div>
                    <a asp-controller="Transits" asp-action="Create" asp-route-tripId="@Model.Trip.Id" class="btn-add-small">+ Квиток</a>
                </div>
                @if (!Model.Transits.Any())
                {
                    <div style="padding:1.8rem;color:#94a3b8;font-style:italic;font-size:.9rem;">Квитки відсутні.</div>
                }
                else
                {
                    <div>
                        @foreach (var t in Model.Transits)
                        {
                            var tEmoji = t.TransitType?.Name switch { "Поїзд" => "🚄", "Автобус" => "🚌", "Корабель" => "🚢", "Авто" => "🚗", _ => "✈️" };
                            var tColor = t.TransitType?.Name switch { "Поїзд" => "rgba(245,158,11,.1)", "Автобус" => "rgba(16,185,129,.1)", "Корабель" => "rgba(59,130,246,.1)", _ => "rgba(139,92,246,.1)" };
