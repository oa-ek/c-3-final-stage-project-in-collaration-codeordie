         data-video-query="@(Model.Destinations.FirstOrDefault()?.CityName ?? Model.Trip.ReturnLocation ?? Model.Trip.DepartureLocation ?? "travel")"
         data-tilt data-tilt-max="1" data-tilt-speed="1000" data-tilt-glare data-tilt-max-glare="0.05">
        <video class="hero-video-bg" id="heroBgVideo" autoplay muted loop playsinline></video>
        <div class="hero-video-overlay"></div>
        <div class="hero-dots"></div>
        <div class="hero-content">

            @if (TempData["SuccessMessage"] != null)
            {
                <div style="margin-bottom:1.2rem; padding:.9rem 1.4rem; background:rgba(16,185,129,0.15); border:1px solid rgba(16,185,129,0.35); border-radius:16px; color:#d1fae5; font-weight:700; font-size:.9rem; display:flex; align-items:center; gap:.6rem;">
                    <i class="bi bi-check-circle-fill" style="color:#4ade80;"></i> @TempData["SuccessMessage"]
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div style="margin-bottom:1.2rem; padding:.9rem 1.4rem; background:rgba(239,68,68,0.15); border:1px solid rgba(239,68,68,0.35); border-radius:16px; color:#fecaca; font-weight:700; font-size:.9rem; display:flex; align-items:center; gap:.6rem;">
                    <i class="bi bi-exclamation-triangle-fill" style="color:#f87171;"></i> @TempData["ErrorMessage"]
                </div>
            }

            <a asp-action="Index" class="btn-back">
                <i class="bi bi-arrow-left"></i> До всіх поїздок
            </a>

            <h1 class="trip-main-title">@Model.Trip.Title</h1>

            <div class="info-pills-row">
                @if (isActive)
                {
                    <span class="info-pill active-status">
                        <span class="status-dot"></span> В процесі
                    </span>
                }
                else if (isPast)
                {
                    <span class="info-pill past-status"><i class="bi bi-check-circle"></i> Завершено</span>
                }
                else
                {
                    <span class="info-pill"><i class="bi bi-clock"></i> @(daysLeft > 0 ? $"Через {daysLeft} днів" : "Сьогодні!")</span>
                }
                <span class="info-pill"><i class="bi bi-calendar3"></i> @Model.Trip.StartDate.ToString("dd MMM") — @Model.Trip.EndDate.ToString("dd MMM yyyy")</span>
                @if (!string.IsNullOrEmpty(Model.Trip.DepartureLocation))
                {
                    <span class="info-pill"><i class="bi bi-geo-alt"></i> @Model.Trip.DepartureLocation → @Model.Trip.ReturnLocation</span>
                }
                @if (ViewBag.TotalDistance > 0)
                {
                    <span class="info-pill" title="Розраховано за формулою Гаверсина">
                        <i class="bi bi-rulers"></i> @ViewBag.TotalDistance км
                    </span>
                }
                <span class="info-pill"><i class="bi bi-currency-exchange"></i> @Model.Trip.BaseCurrency</span>
            </div>

            <div class="nav-buttons-row">
                <a asp-controller="Expenses" asp-action="Create" asp-route-tripId="@Model.Trip.Id" class="nav-btn active"><i class="bi bi-cash-coin"></i> Витрата</a>
                <a asp-action="DownloadCalendar" asp-route-id="@Model.Trip.Id" class="nav-btn ghost"><i class="bi bi-calendar-plus"></i> В календар</a>
                <a asp-action="ExportToCsv" asp-route-id="@Model.Trip.Id" class="nav-btn ghost">
                    <i class="bi bi-file-earmark-excel" style="color: #10b981;"></i> В Excel
                </a>
                <a asp-action="ExportToWord" asp-route-id="@Model.Trip.Id" class="nav-btn ghost">
                    <i class="bi bi-file-earmark-word-fill" style="color: #2563eb;"></i> У Word
                </a>
                <a href="@googleCalendarUrl" target="_blank" class="nav-btn ghost">
                    <i class="bi bi-google"></i> Google Календар
                </a>
                <a asp-controller="Accommodations" asp-action="Create" asp-route-tripId="@Model.Trip.Id" class="nav-btn"><i class="bi bi-building"></i> Житло</a>
                <a asp-controller="Transits" asp-action="Create" asp-route-tripId="@Model.Trip.Id" class="nav-btn"><i class="bi bi-airplane"></i> Транзит</a>
                <a asp-controller="TripActivities" asp-action="Create" asp-route-tripId="@Model.Trip.Id" class="nav-btn"><i class="bi bi-lightning"></i> Активність</a>
                <a asp-controller="TripDestinations" asp-action="Create" asp-route-tripId="@Model.Trip.Id" class="nav-btn"><i class="bi bi-geo-alt"></i> Місто</a>
                <a asp-controller="Checklists" asp-action="Create" asp-route-tripId="@Model.Trip.Id" class="nav-btn"><i class="bi bi-check2-square"></i> Чекліст</a>
                <a asp-action="Edit" asp-route-id="@Model.Trip.Id" class="nav-btn ghost"><i class="bi bi-pencil"></i> Редагувати</a>
                <a asp-controller="Export"
   asp-action="Trip"
   asp-route-tripId="@Model.Trip.Id"
   class="nav-btn"
   title="Експорт у Excel">
    <i class="bi bi-file-earmark-spreadsheet"></i> Excel
</a>
            </div>

            @if (Model.Destinations != null && Model.Destinations.Any())
            {
                <div class="video-city-switcher" id="citySwitcher">
                    <span class="video-city-switcher-label"><i class="bi bi-camera-video"></i> Фон:</span>
                    @foreach (var d in Model.Destinations)
                    {
                        <button class="city-vid-btn"
                                onclick="switchHeroVideo('@d.CityName', this)"
                                data-city="@d.CityName">
                            🏙 @d.CityName
                        </button>
                    }
                    <button class="city-vid-btn shuffle" onclick="shuffleHeroVideo(this)">
                        🔀 Рандомне
                    </button>
                </div>
            }

        </div>
    </div>

    <div class="content-container">

        <div>
            <div class="light-glass-card" data-tilt data-tilt-max="2" data-tilt-speed="400" data-tilt-glare data-tilt-max-glare="0.1" style="animation-delay: 0.1s;">
                <div class="card-header">
                    <div class="card-header-title">
                        <div class="icon-box" style="background: #3b82f6;"><i class="bi bi-geo-alt-fill"></i></div>
                        Маршрут
                    </div>
                    <a asp-controller="TripDestinations" asp-action="Create" asp-route-tripId="@Model.Trip.Id" class="btn-add-small">+ Місто</a>
                </div>
                @if (!Model.Destinations.Any())
                {
                    <div style="padding:1.8rem; color:#94a3b8; font-style:italic; font-size:.9rem; transform: translateZ(20px);">Міста ще не додані.</div>
                }
                else
                {
                    <table class="clean-table">
                        <thead>
                            <tr>
                                <th>Місто</th>
                                <th>Прибуття</th>
                                <th>Відбуття</th>
                                <th>Погода / прапор</th>
                                <th style="text-align:right;">Дії</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var d in Model.Destinations)
                            {
                                <tr>
                                    <td style="font-weight:800; color:#111827;">@d.CityName, @d.Country</td>
                                    <td>@d.ArrivalDate.ToString("dd.MM.yyyy")</td>
                                    <td>@d.DepartureDate.ToString("dd.MM.yyyy")</td>
                                    <td>
                                        <div class="dest-weather-cell" id="wcard-@d.Id">
                                            <div class="dest-weather-skeleton"></div>
                                        </div>
                                    </td>
                                    <td style="text-align:right;">
                                        <div style="display:flex; align-items:center; justify-content:flex-end; gap:0.8rem;">
                                            <button onclick="openAiPanel('@d.CityName', '@d.Country')"
                                                    style="background:linear-gradient(135deg,#6366f1,#8b5cf6); color:white; border:none; border-radius:50px; padding:0.35rem 0.9rem; font-size:0.75rem; font-weight:800; cursor:pointer; font-family:'Montserrat',sans-serif; box-shadow:0 3px 10px rgba(99,102,241,0.35); transition:all .2s;"
                                                    onmouseover="this.style.transform='translateY(-1px)'"
                                                    onmouseout="this.style.transform=''">
                                                ✨ AI
                                            </button>
                                            <a asp-controller="TripDestinations" asp-action="Edit" asp-route-id="@d.Id" style="color:#3b82f6; font-weight:800; text-decoration:none;">Ред.</a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>

            <div class="light-glass-card" style="animation-delay: 0.2s;">
                <div class="card-header">
                    <div class="card-header-title">
                        <div class="icon-box" style="background: #f59e0b;"><i class="bi bi-map"></i></div>
                        Карта подорожі
                    </div>
                </div>
                <div id="map"></div>
            </div>

            <div class="light-glass-card" data-tilt data-tilt-max="2" data-tilt-speed="400" data-tilt-glare data-tilt-max-glare="0.1" style="animation-delay: 0.25s;">
                <div class="card-header">
                    <div class="card-header-title">
                        <div class="icon-box" style="background: #ec4899;"><i class="bi bi-clock-history"></i></div>
                        Хронологія
                    </div>
                </div>
                @if (Model.Timeline != null && Model.Timeline.Any())
                {
                    <!-- Фільтри -->
                    <div class="tl-filters">
                        <button class="tl-filter-btn active" data-filter="all" onclick="tlFilter('all', this)">🗓 Всі</button>
                        <button class="tl-filter-btn" data-filter="Transit" onclick="tlFilter('Transit', this)" style="color:#8b5cf6">✈️ Транспорт</button>
                        <button class="tl-filter-btn" data-filter="Destination" onclick="tlFilter('Destination', this)" style="color:#3b82f6">📍 Міста</button>
                        <button class="tl-filter-btn" data-filter="Accommodation" onclick="tlFilter('Accommodation', this)" style="color:#14b8a6">🏨 Житло</button>
                    </div>
                }
                <div style="transform: translateZ(20px);">
                    @if (Model.Timeline == null || !Model.Timeline.Any())
                    {
                        <div style="padding:1.5rem; color:#94a3b8; font-style:italic; font-size:.9rem;">Додайте квитки, міста або житло, щоб побачити маршрут.</div>
                    }
                    else
                    {
                        var today = DateTime.Today;
                        var nextEvent = Model.Timeline.FirstOrDefault(e => e.EventDate.Date >= today);
                        var groups = Model.Timeline.GroupBy(e => e.EventDate.Date).OrderBy(g => g.Key);

                        <div class="timeline-container" id="timelineContainer">
                            @{
                                TravelManager.UI.Models.ViewModels.TripDetailsViewModel.TimelineEvent? prevItem = null;
                            }
                            @foreach (var group in groups)
                            {
                                <!-- Дата-заголовок -->
                                <div class="tl-date-label" data-date="@group.Key.ToString("yyyy-MM-dd")">
                                    @group.Key.ToString("dd MMM yyyy")
                                    @if (group.Key == today)
                                    {
                                        <span style="color:#f59e0b">· сьогодні</span>
                                    }
                                </div>

                                @foreach (var item in group)
                                {
                                    var isNext = nextEvent is not null && item.EventDate == nextEvent.EventDate && item.Title == nextEvent.Title;
                                    var typeIcon = item.EventType switch { "Transit" => "✈️", "Destination" => "📍", "Accommodation" => "🏨", _ => "📌" };
                                    var bgAlpha = item.EventType switch { "Transit" => "rgba(139,92,246,0.15)", "Destination" => "rgba(59,130,246,0.15)", "Accommodation" => "rgba(20,184,166,0.15)", _ => "rgba(0,0,0,0.08)" };

                                    <!-- Gap між подіями -->
                                    if (prevItem is not null)
                                    {
                                        var gap = (int)(item.EventDate - prevItem.EventDate).TotalDays;
                                        if (gap >= 2 && item.EventDate.Date != prevItem.EventDate.Date)
                                        {
                                            <div class="tl-gap-label" data-type="@item.EventType">через @gap дн.</div>
                                        }
                                    }

                                    <div class="timeline-item" data-type="@item.EventType">
                                        <div class="tl-icon" style="background:@bgAlpha;">@typeIcon</div>
                                        <div class="tl-card">
                                            <div>
                                                <div class="tl-card-title">
                                                    @item.Title
                                                    @if (isNext)
                                                    {
                                                        <span class="tl-next-badge">▶ наступне</span>
                                                    }
                                                </div>
                                                @if (!string.IsNullOrEmpty(item.Subtitle))
                                                {
                                                    <div class="tl-card-sub">@item.Subtitle</div>
                                                }
                                            </div>
                                            <span class="tl-badge" style="color:@item.IconColor; background:@bgAlpha;">
                                                <i class="bi @item.IconClass"></i>
                                                @item.EventDate.ToString("HH:mm")
                                            </span>
                                        </div>
                                    </div>
                                    prevItem = item;
                                }
                            }
                        </div>
                    }
                </div>
            </div>

            <div class="light-glass-card" data-tilt data-tilt-max="2" data-tilt-speed="400" data-tilt-glare data-tilt-max-glare="0.1" style="animation-delay: 0.3s;">
                <div class="card-header">
                    <div class="card-header-title">
                        <div class="icon-box" style="background: #8b5cf6;"><i class="bi bi-airplane-fill"></i></div>
                        Транспорт
                        <span id="transitCount" style="font-size:.75rem; background:rgba(139,92,246,0.12); color:#8b5cf6; border-radius:50px; padding:.15rem .6rem; font-weight:700; margin-left:.3rem;">@Model.Transits.Count()</span>
                    </div>
                    <a asp-controller="Transits" asp-action="Create" asp-route-tripId="@Model.Trip.Id" class="btn-add-small">+ Квиток</a>
                </div>

                @if (!Model.Transits.Any())
                {
                    <div style="padding:2.5rem 1.8rem; text-align:center; transform: translateZ(20px);">
                        <div style="font-size:2.2rem; margin-bottom:.6rem;">✈️</div>
                        <div style="color:#94a3b8; font-style:italic; font-size:.9rem;">Квитки відсутні.</div>
                    </div>
                }
                else
                {
                    <!-- Панель фільтрів і сортування -->
                    <div style="padding:.75rem 1.2rem .5rem; display:flex; align-items:center; gap:.5rem; flex-wrap:wrap; border-bottom:1px solid rgba(0,0,0,0.05);">
                        <div style="display:flex; gap:.35rem; flex-wrap:wrap; flex:1;">
                            <button onclick="transitFilter('all',this)" class="tr-filter-btn tr-filter-active" data-filter="all">🗓 Всі</button>
                            <button onclick="transitFilter('Flight',this)" class="tr-filter-btn" data-filter="Flight">✈️ Рейс</button>
                            <button onclick="transitFilter('Train',this)" class="tr-filter-btn" data-filter="Train">🚄 Поїзд</button>
                            <button onclick="transitFilter('Car',this)" class="tr-filter-btn" data-filter="Car">🚗 Авто</button>
                            <button onclick="transitFilter('Other',this)" class="tr-filter-btn" data-filter="Other">🚐 Інше</button>
                        </div>
                        <div style="display:flex; align-items:center; gap:.4rem;">
                            <span style="font-size:.75rem; color:#94a3b8; font-weight:600;">Сортування:</span>
                            <select id="transitSort" onchange="transitSortFn()" style="font-size:.75rem; border:1px solid #e2e8f0; border-radius:8px; padding:.25rem .5rem; color:#475569; background:white; cursor:pointer; outline:none;">
                                <option value="date-asc">Дата ↑</option>
                                <option value="date-desc">Дата ↓</option>
                                <option value="type">Тип</option>
                                <option value="route">Маршрут A→Z</option>
                            </select>
                        </div>
                    </div>

                    <div id="transitList" style="padding:.75rem 1.2rem; transform: translateZ(20px); display:flex; flex-direction:column; gap:0.6rem;">
                        @foreach (var t in Model.Transits.OrderBy(x => x.DepartureTime))
                        {
                            var tIcon = t.TransitType?.Name switch { "Поїзд" or "Train" => "🚄", "Автобус" or "Bus" => "🚌", "Корабель" => "🚢", "Авто" or "Car" => "🚗", "Flight" => "✈️", "Other" => "🚐", _ => "✈️" };
                            var tColor = t.TransitType?.Name switch { "Поїзд" or "Train" => "#3b82f6", "Автобус" or "Bus" => "#f59e0b", "Корабель" => "#06b6d4", "Авто" or "Car" => "#10b981", "Flight" => "#8b5cf6", _ => "#8b5cf6" };
                            var tBg = t.TransitType?.Name switch { "Поїзд" or "Train" => "rgba(59,130,246,0.07)", "Автобус" or "Bus" => "rgba(245,158,11,0.07)", "Корабель" => "rgba(6,182,212,0.07)", "Авто" or "Car" => "rgba(16,185,129,0.07)", _ => "rgba(139,92,246,0.07)" };
                            var statusColor = t.BookingStatus?.Name switch { "Confirmed" or "Підтверджено" => "#10b981", "Pending" or "Очікує" => "#f59e0b", "Cancelled" or "Скасовано" => "#ef4444", _ => "#94a3b8" };
                            var statusLabel = t.BookingStatus?.Name switch { "Confirmed" => "✔ Підтверджено", "Pending" => "⏳ Очікує", "Cancelled" => "✕ Скасовано", _ => t.BookingStatus?.Name ?? "" };
                            var transitDuration = (t.ArrivalTime - t.DepartureTime);
                            var durationStr = transitDuration.TotalMinutes > 0 ? (transitDuration.TotalHours >= 24 ? $"{(int)transitDuration.TotalDays}д {transitDuration.Hours}г" : $"{(int)transitDuration.TotalHours}г {transitDuration.Minutes}хв") : "";
                            var typeName = t.TransitType?.Name ?? "Other";

                            <div class="transit-card" data-type="@typeName" data-date="@t.DepartureTime.ToString("yyyy-MM-ddTHH:mm")" data-route="@t.DepartureLocation"
                                 style="background:@tBg; border:1.5px solid @(tColor)33; border-radius:16px; overflow:hidden; transition:all .22s;">

                                <!-- Заголовок картки (клікабельний) -->
                                <div onclick="transitToggle(this)" style="display:flex; align-items:center; gap:1rem; padding:.9rem 1rem; cursor:pointer; user-select:none;">
                                    <div style="width:44px; height:44px; border-radius:13px; background:@tColor; display:flex; align-items:center; justify-content:center; font-size:1.25rem; flex-shrink:0; box-shadow:0 3px 10px @(tColor)44;">
                                        @tIcon
                                    </div>
                                    <div style="flex:1; min-width:0;">
                                        <div style="display:flex; align-items:center; gap:.5rem; flex-wrap:wrap;">
                                            <span style="font-weight:800; color:#0f172a; font-size:.95rem;">@t.DepartureLocation</span>
                                            <span style="color:@tColor; font-weight:700;">→</span>
                                            <span style="font-weight:800; color:#0f172a; font-size:.95rem;">@t.ArrivalLocation</span>
                                            @if (!string.IsNullOrEmpty(durationStr))
                                            {
                                                <span style="font-size:.68rem; background:white; border:1px solid #e2e8f0; border-radius:50px; padding:.1rem .5rem; color:#64748b; font-weight:600;">⏱ @durationStr</span>
                                            }
                                        </div>
                                        <div style="font-size:.78rem; color:#64748b; margin-top:.2rem; display:flex; align-items:center; gap:.6rem; flex-wrap:wrap;">
                                            <span><i class="bi bi-calendar3"></i> @t.DepartureTime.ToString("dd.MM.yyyy")</span>
                                            <span><i class="bi bi-clock"></i> @t.DepartureTime.ToString("HH:mm") → @t.ArrivalTime.ToString("HH:mm")</span>
                                        </div>
                                    </div>
                                    <div style="display:flex; flex-direction:column; align-items:flex-end; gap:.3rem; flex-shrink:0;">
                                        @if (!string.IsNullOrEmpty(statusLabel))
                                        {
                                            <span style="font-size:.68rem; font-weight:700; color:@statusColor; background:@(statusColor)18; border:1px solid @(statusColor)33; border-radius:50px; padding:.15rem .55rem; white-space:nowrap;">@statusLabel</span>
                                        }
                                        <i class="bi bi-chevron-down transit-chevron" style="color:#94a3b8; font-size:.8rem; transition:transform .2s;"></i>
                                    </div>
                                </div>

                                <!-- Розгорнута панель -->
                                <div class="transit-details" style="display:none; border-top:1px solid @(tColor)22; padding:.85rem 1rem; background:rgba(255,255,255,0.6);">
                                    <div style="display:grid; grid-template-columns:1fr 1fr; gap:.6rem .8rem; margin-bottom:.8rem;">
                                        <div style="font-size:.78rem; color:#475569;">
                                            <div style="font-weight:700; color:#94a3b8; font-size:.67rem; text-transform:uppercase; letter-spacing:.06em; margin-bottom:.15rem;">Тип</div>
                                            @tIcon @(t.TransitType?.Name ?? "—")
                                        </div>
                                        <div style="font-size:.78rem; color:#475569;">
                                            <div style="font-weight:700; color:#94a3b8; font-size:.67rem; text-transform:uppercase; letter-spacing:.06em; margin-bottom:.15rem;">Статус</div>
                                            @statusLabel
                                        </div>
                                        @if (!string.IsNullOrEmpty(t.CarrierInfo))
                                        {
                                            <div style="font-size:.78rem; color:#475569;">
                                                <div style="font-weight:700; color:#94a3b8; font-size:.67rem; text-transform:uppercase; letter-spacing:.06em; margin-bottom:.15rem;">Перевізник</div>
                                                <i class="bi bi-building"></i> @t.CarrierInfo
                                            </div>
                                        }
                                        @if (!string.IsNullOrEmpty(t.BookingReference))
                                        {
                                            <div style="font-size:.78rem; color:#475569;">
                                                <div style="font-weight:700; color:#94a3b8; font-size:.67rem; text-transform:uppercase; letter-spacing:.06em; margin-bottom:.15rem;">Номер квитка</div>
                                                <span style="font-family:monospace; font-weight:700; background:white; border:1px solid #e2e8f0; border-radius:6px; padding:.1rem .4rem;">🎫 @t.BookingReference</span>
                                            </div>
                                        }
                                        <div style="font-size:.78rem; color:#475569;">
                                            <div style="font-weight:700; color:#94a3b8; font-size:.67rem; text-transform:uppercase; letter-spacing:.06em; margin-bottom:.15rem;">Відправлення</div>
                                            @t.DepartureTime.ToString("dd.MM.yyyy HH:mm")
                                        </div>
                                        <div style="font-size:.78rem; color:#475569;">
                                            <div style="font-weight:700; color:#94a3b8; font-size:.67rem; text-transform:uppercase; letter-spacing:.06em; margin-bottom:.15rem;">Прибуття</div>
                                            @t.ArrivalTime.ToString("dd.MM.yyyy HH:mm")
                                        </div>
                                    </div>
                                    <!-- Кнопки дій -->
                                    <div style="display:flex; gap:.5rem; justify-content:flex-end;">
                                        <a asp-controller="Transits" asp-action="Edit" asp-route-id="@t.Id"
                                           style="font-size:.75rem; padding:.35rem .85rem; border-radius:8px; background:white; border:1.5px solid #e2e8f0; color:#475569; text-decoration:none; font-weight:700; display:flex; align-items:center; gap:.3rem; transition:all .18s;"
                                           onmouseenter="this.style.borderColor='@tColor';this.style.color='@tColor';"
                                           onmouseleave="this.style.borderColor='#e2e8f0';this.style.color='#475569';">
                                            <i class="bi bi-pencil"></i> Редагувати
                                        </a>
                                        <button onclick="transitDelete(@t.Id, '@t.DepartureLocation → @t.ArrivalLocation', this)"
                                                style="font-size:.75rem; padding:.35rem .85rem; border-radius:8px; background:white; border:1.5px solid #fecaca; color:#ef4444; font-weight:700; cursor:pointer; display:flex; align-items:center; gap:.3rem; transition:all .18s;"
                                                onmouseenter="this.style.background='#ef4444';this.style.color='white';"
                                                onmouseleave="this.style.background='white';this.style.color='#ef4444';">
                                            <i class="bi bi-trash"></i> Видалити
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Повідомлення "нічого не знайдено" -->
                    <div id="transitEmpty" style="display:none; padding:2rem; text-align:center; color:#94a3b8; font-style:italic; font-size:.9rem;">
                        Немає квитків цього типу.
                    </div>
                }
            </div>

            <!-- Прихована форма для видалення транзиту -->
            <form id="transitDeleteForm" asp-controller="Transits" asp-action="Delete" method="post" style="display:none;">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="transitDeleteId" />
            </form>

            <!-- Модальне підтвердження видалення -->
            <div id="transitDeleteModal" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.45); z-index:9999; align-items:center; justify-content:center;">
                <div style="background:white; border-radius:20px; padding:2rem; max-width:380px; width:90%; box-shadow:0 24px 60px rgba(0,0,0,0.2); animation:fadeInUp .2s ease;">
                    <div style="font-size:2rem; text-align:center; margin-bottom:.8rem;">🗑️</div>
                    <div style="font-weight:800; color:#0f172a; font-size:1.05rem; text-align:center; margin-bottom:.4rem;">Видалити квиток?</div>
                    <div id="transitDeleteName" style="text-align:center; color:#64748b; font-size:.88rem; margin-bottom:1.5rem;"></div>
                    <div style="display:flex; gap:.75rem;">
                        <button onclick="document.getElementById('transitDeleteModal').style.display='none'"
                                style="flex:1; padding:.65rem; border-radius:10px; border:1.5px solid #e2e8f0; background:white; color:#475569; font-weight:700; cursor:pointer; font-size:.88rem;">
                            Скасувати
                        </button>
                        <button onclick="document.getElementById('transitDeleteForm').submit()"
                                style="flex:1; padding:.65rem; border-radius:10px; border:none; background:#ef4444; color:white; font-weight:700; cursor:pointer; font-size:.88rem;">
                            Видалити
                        </button>
                    </div>
                </div>
            </div>

            <style>
                .tr-filter-btn {
                    font-size: .72rem;
                    padding: .25rem .65rem;
                    border-radius: 50px;
                    border: 1.5px solid #e2e8f0;
                    background: white;
                    color: #64748b;
                    font-weight: 700;
                    cursor: pointer;
                    transition: all .18s;
                    font-family: inherit;
                }

                    .tr-filter-btn:hover {
                        border-color: #8b5cf6;
                        color: #8b5cf6;
                    }

                    .tr-filter-btn.tr-filter-active {
                        background: #8b5cf6;
                        border-color: #8b5cf6;
                        color: white;
                    }

                .transit-card:hover {
                    box-shadow: 0 6px 20px rgba(0,0,0,0.08);
                    transform: translateY(-1px);
                }
            </style>

            <script>
                // Розгортання картки
                function transitToggle(header) {
                    const card = header.closest('.transit-card');
                    const details = card.querySelector('.transit-details');
                    const chevron = card.querySelector('.transit-chevron');
                    const isOpen = details.style.display !== 'none';
                    details.style.display = isOpen ? 'none' : 'block';
                    chevron.style.transform = isOpen ? '' : 'rotate(180deg)';
                }

                // Фільтрація по типу
                function transitFilter(type, btn) {
                    document.querySelectorAll('.tr-filter-btn').forEach(b => b.classList.remove('tr-filter-active'));
                    btn.classList.add('tr-filter-active');
                    let visible = 0;
                    document.querySelectorAll('.transit-card').forEach(card => {
                        const match = type === 'all' || card.dataset.type === type;
                        card.style.display = match ? '' : 'none';
                        if (match) visible++;
                    });
                    document.getElementById('transitEmpty').style.display = visible === 0 ? 'block' : 'none';
                    document.getElementById('transitCount').textContent = visible;
                }

                // Сортування
                function transitSortFn() {
                    const val = document.getElementById('transitSort').value;
                    const list = document.getElementById('transitList');
                    const cards = Array.from(list.querySelectorAll('.transit-card'));
                    cards.sort((a, b) => {
                        if (val === 'date-asc') return a.dataset.date.localeCompare(b.dataset.date);
                        if (val === 'date-desc') return b.dataset.date.localeCompare(a.dataset.date);
                        if (val === 'type') return (a.dataset.type || '').localeCompare(b.dataset.type || '');
                        if (val === 'route') return (a.dataset.route || '').localeCompare(b.dataset.route || '');
                        return 0;
                    });
                    cards.forEach(c => list.appendChild(c));
                }

                // Видалення з підтвердженням
                function transitDelete(id, name, btn) {
                    document.getElementById('transitDeleteId').value = id;
                    document.getElementById('transitDeleteName').textContent = name;
                    document.getElementById('transitDeleteModal').style.display = 'flex';
                }

                // Закрити модалку по кліку на фон
                document.getElementById('transitDeleteModal')?.addEventListener('click', function(e) {
                    if (e.target === this) this.style.display = 'none';
                });
            </script>

            @if (!string.IsNullOrEmpty(Model.Trip.Description))
            {
                <div class="light-glass-card" data-tilt data-tilt-max="2" data-tilt-speed="400" data-tilt-glare data-tilt-max-glare="0.1" style="animation-delay: 0.4s;">
                    <div class="card-header">
                        <div class="card-header-title">
                            <div class="icon-box" style="background: #10b981;"><i class="bi bi-card-text"></i></div>
                            Опис
                        </div>
                    </div>
                    <div style="padding:1.8rem; color:#475569; line-height:1.6; transform: translateZ(20px);">
                        @Model.Trip.Description
                    </div>
                </div>
            }
        </div>

        <div>
            <div class="dark-glass-card" data-tilt data-tilt-max="3" data-tilt-speed="400" data-tilt-glare data-tilt-max-glare="0.15" style="animation-delay: 0.1s;">
                <div style="display:flex; justify-content:space-between; align-items:center; transform: translateZ(20px);">
                    <div style="font-size:0.75rem; font-weight:800; letter-spacing:0.1em; text-transform:uppercase; color:rgba(255,255,255,0.6);">Загальний бюджет</div>
                    <a asp-controller="Expenses" asp-action="Create" asp-route-tripId="@Model.Trip.Id"
                       style="background:rgba(255,255,255,0.1); border:1px solid rgba(255,255,255,0.2); border-radius:50px; padding:0.4rem 1rem; color:white; text-decoration:none; font-size:0.75rem; font-weight:700; transition:all 0.2s;">
                        + Витрата
                    </a>
                </div>
                <div class="budget-amount">@totalBudget.ToString("N0") @baseCurr</div>
                <div style="font-size:0.85rem; color:rgba(255,255,255,0.5); transform: translateZ(20px);">@Model.Expenses.Count() витрат · з конвертацією</div>
            </div>

            <div class="light-glass-card" style="animation-delay: 0.12s; overflow:visible;">
                <div class="card-header" style="background:linear-gradient(135deg,rgba(99,102,241,.05),rgba(139,92,246,.05));border-bottom:1px solid rgba(99,102,241,.1);">
                    <div class="card-header-title">
                        <div class="icon-box" style="background:linear-gradient(135deg,#6366f1,#8b5cf6);"><i class="bi bi-robot"></i></div>
                        AI-аналіз витрат
                    </div>
                    <span style="font-size:.65rem;font-weight:800;background:rgba(99,102,241,.1);color:#6366f1;padding:.2rem .65rem;border-radius:50px;border:1px solid rgba(99,102,241,.2);letter-spacing:.06em;">GROQ</span>
                </div>
                <div style="padding:1.4rem;">

                    @* Idle state *@
                    <div id="aib-idle">
                        <p style="font-size:.86rem;color:#64748b;line-height:1.65;margin:0 0 1rem;">
                            Groq проаналізує ваші витрати за категоріями, порівняє з типовим бюджетом для напрямку та надасть конкретні поради щодо економії.
                        </p>

                        @{
                            var catGroups = Model.Expenses
                            .Where(e => e.Category != null)
                            .GroupBy(e => e.Category!.Name)
                            .Select(g => new { Name = g.Key, Total = g.Sum(e => e.TotalAmount) })
                            .OrderByDescending(g => g.Total)
                            .Take(5)
                            .ToList();
                            var expTotal = Model.Expenses.Sum(e => e.TotalAmount);
                            string[] barColors = { "#6366f1", "#10b981", "#f59e0b", "#ec4899", "#3b82f6" };
                        }

                        @if (catGroups.Any())
                        {
                            <div style="margin-bottom:1.1rem;">
                                @for (int ci = 0; ci < catGroups.Count; ci++)
                                {
                                    var cat = catGroups[ci];
                                    var pct = expTotal > 0 ? (int)(cat.Total / expTotal * 100) : 0;
                                    var col = barColors[ci % barColors.Length];
                                    <div style="margin-bottom:.55rem;">
                                        <div style="display:flex;justify-content:space-between;font-size:.75rem;font-weight:700;color:#475569;margin-bottom:.22rem;">
                                            <span>@cat.Name</span>
                                            <span style="color:@col;">@pct%</span>
                                        </div>
                                        <div style="height:5px;background:rgba(0,0,0,.06);border-radius:50px;overflow:hidden;">
                                            <div style="height:100%;width:@(pct)%;background:@col;border-radius:50px;transition:width 1s ease;"></div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div style="font-size:.82rem;color:#94a3b8;font-style:italic;margin-bottom:1rem;">Додайте витрати, щоб побачити аналіз.</div>
                        }

                        <button onclick="runAiBudget(@Model.Trip.Id)"
                                style="width:100%;padding:.72rem;background:linear-gradient(135deg,#6366f1,#8b5cf6);color:white;border:none;border-radius:14px;font-family:'Montserrat',sans-serif;font-weight:800;font-size:.82rem;cursor:pointer;transition:all .25s;box-shadow:0 4px 16px rgba(99,102,241,.3);display:flex;align-items:center;justify-content:center;gap:.5rem;"
                                onmouseover="this.style.transform='translateY(-2px)';this.style.boxShadow='0 8px 24px rgba(99,102,241,.45)'"
                                onmouseout="this.style.transform='';this.style.boxShadow='0 4px 16px rgba(99,102,241,.3)'">
                            <i class="bi bi-stars"></i> Проаналізувати витрати
                        </button>
                    </div>

                    @* Loading state *@
                    <div id="aib-loading" style="display:none;text-align:center;padding:2.5rem 0;">
                        <div style="width:38px;height:38px;border:3px solid rgba(99,102,241,.15);border-top-color:#6366f1;border-radius:50%;animation:spin .7s linear infinite;margin:0 auto .8rem;"></div>
                        <div style="font-weight:700;color:#6366f1;font-size:.88rem;">Аналізую витрати...</div>
                        <div style="font-size:.75rem;color:#94a3b8;margin-top:.3rem;">Groq обробляє дані</div>
                    </div>

                    @* Error state *@
                    <div id="aib-error" style="display:none;background:#fef2f2;border:1px solid #fecaca;border-radius:12px;padding:.9rem 1rem;color:#ef4444;font-weight:700;font-size:.83rem;margin-top:.5rem;"></div>

                    @* Result state *@
                    <div id="aib-result" style="display:none;">
                        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:.85rem;">
                            <span style="font-size:.7rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:#10b981;">
                                <i class="bi bi-check-circle-fill me-1"></i>Аналіз готовий
                            </span>
                            <button onclick="resetAiBudget()" style="background:none;border:none;color:#94a3b8;font-size:.75rem;cursor:pointer;text-decoration:underline;font-family:'Inter',sans-serif;padding:0;">
                                Оновити
                            </button>
                        </div>
                        <div id="aib-content"
                             style="font-size:.86rem;color:#374151;line-height:1.72;background:rgba(99,102,241,.04);border:1px solid rgba(99,102,241,.1);border-radius:14px;padding:1.1rem;">
                        </div>
                    </div>

                </div>
            </div>

            <div class="light-glass-card" data-tilt data-tilt-max="2" data-tilt-speed="400" data-tilt-glare data-tilt-max-glare="0.1" style="animation-delay: 0.2s;">
                <div class="card-header">
                    <div class="card-header-title">
                        <div class="icon-box" style="background: #14b8a6;"><i class="bi bi-building"></i></div>
                        Житло
                    </div>
                    <div style="display:flex; align-items:center; gap:0.5rem;">
                        <a href="@bookingUrl" target="_blank" class="btn-add-small" style="background: linear-gradient(135deg, #6366f1, #ec4899); color: white; border: none; box-shadow: 0 4px 10px rgba(236,72,153,0.25);">
                            <i class="bi bi-globe" style="margin-right:3px;"></i> Booking
                        </a>
                        <a asp-controller="Accommodations" asp-action="Create" asp-route-tripId="@Model.Trip.Id" class="btn-add-small">+ Додати</a>
                    </div>
                </div>
                <div style="padding:1.5rem;">
                    @if (!Model.Accommodations.Any())
                    {
                        <div style="color:#94a3b8; font-style:italic; font-size:.9rem; transform: translateZ(20px);">Житло ще не додано.</div>
                    }
                    else
                    {
                        @foreach (var a in Model.Accommodations)
                        {
                            <div class="list-item-card">
                                <div style="font-family:'Montserrat'; font-weight:800; color:#111827; font-size:1.05rem; margin-bottom:.2rem;">@a.Name</div>
                                <div style="font-size:.85rem; color:#64748b; margin-bottom:.8rem;">@a.Address</div>
                                <div style="display:flex; justify-content:space-between; align-items:center;">
                                    <span style="font-size:.8rem; font-weight:700; color:#475569;">📅 @a.CheckInTime.ToString("dd.MM.yyyy")</span>
                                    <a asp-controller="Accommodations" asp-action="Edit" asp-route-id="@a.Id" style="font-size:.8rem; color:#3b82f6; font-weight:800; text-decoration:none;">Ред.</a>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>

            <div class="light-glass-card" data-tilt data-tilt-max="2" data-tilt-speed="400" data-tilt-glare data-tilt-max-glare="0.1" style="animation-delay: 0.3s;">
                <div class="card-header">
                    <div class="card-header-title">
                        <div class="icon-box" style="background: #64748b;"><i class="bi bi-check2-square"></i></div>
                        Списки речей
                    </div>
                    <a asp-controller="Checklists" asp-action="Create" asp-route-tripId="@Model.Trip.Id" class="btn-add-small">+ Новий</a>
                </div>
                <div style="padding:1.5rem;">
                    @if (!Model.Checklists.Any())
                    {
                        <div style="color:#94a3b8; font-style:italic; font-size:.9rem; transform: translateZ(20px);">Списків ще немає.</div>
                    }
                    else
                    {
                        @foreach (var c in Model.Checklists)
                        {
                            int total = c.Items?.Count() ?? 0;
                            int checked_ = c.Items?.Count(i => i.IsChecked) ?? 0;
                            int pct = total > 0 ? (int)Math.Round((double)checked_ / total * 100) : 0;

                            <a asp-controller="Checklists" asp-action="Details" asp-route-id="@c.Id" style="display:block; text-decoration:none;" class="list-item-card">
                                <div style="display:flex; justify-content:space-between; align-items:center;">
                                    <span style="font-family:'Montserrat'; font-weight:700; font-size:.95rem; color:#0f172a;">@c.Title</span>
                                    <span style="font-size:.8rem; font-weight:800; color:#64748b;">@checked_ / @total</span>
                                </div>
                                <div style="height:6px; background:rgba(0,0,0,0.05); border-radius:50px; margin-top:0.8rem; overflow:hidden;">
                                    <div style="height:100%; width:@pct%; background:#10b981; border-radius:50px;"></div>
                                </div>
                            </a>
                        }
                    }
                </div>
            </div>

            <div class="light-glass-card" data-tilt data-tilt-max="2" data-tilt-speed="400" data-tilt-glare data-tilt-max-glare="0.1" style="animation-delay: 0.4s;">
                <div class="card-header">
                    <div class="card-header-title">
                        <div class="icon-box" style="background: #6366f1;"><i class="bi bi-people-fill"></i></div>
                        Учасники
                    </div>
                </div>
                <div style="padding:1.5rem; transform: translateZ(20px);">
                    @if (!Model.Participants.Any())
                    {
                        <div style="color:#94a3b8; font-style:italic; font-size:.9rem;">Учасників ще немає.</div>
                    }
                    else
                    {
                        @foreach (var p in Model.Participants)
                        {
                            <div style="display:flex; align-items:center; justify-content:space-between; padding:.7rem 0; border-bottom:1px solid rgba(0,0,0,0.05);">
                                <div style="display:flex; align-items:center; gap:.75rem;">
                                    <div style="width:38px; height:38px; border-radius:50%; background:linear-gradient(135deg,#6366f1,#8b5cf6); display:flex; align-items:center; justify-content:center; color:white; font-weight:800; font-size:1rem;">
                                        @(p.UserName?.Length > 0 ? p.UserName[0].ToString().ToUpper() : "?")
                                    </div>
                                    <div>
                                        <div style="font-weight:700; color:#111827; font-size:.9rem;">@p.UserName</div>
                                        <div style="font-size:.75rem; color:#64748b;">@p.Role</div>
                                    </div>
                                </div>
                                @if (Model.CurrentUserRole == "Organizer" && p.Role != "Organizer")
                                {
                                    <form asp-action="RemoveParticipant" method="post" style="margin:0;"
                                          onsubmit="return confirm('Видалити @p.UserName з поїздки?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="tripId" value="@Model.Trip.Id" />
                                        <input type="hidden" name="userId" value="@p.UserId" />
                                        <button type="submit"
                                                style="background:none; border:none; color:#ef4444; font-size:.8rem; font-weight:700; cursor:pointer; padding:.3rem .6rem; border-radius:8px; transition:background .2s;"
                                                onmouseover="this.style.background='rgba(239,68,68,0.1)'"
                                                onmouseout="this.style.background='none'">
                                            <i class="bi bi-person-dash"></i>
                                        </button>
                                    </form>
                                }
                            </div>
                        }
                    }

                    @if (Model.CurrentUserRole == "Organizer")
                    {
                        <div style="margin-top:1.2rem; padding-top:1.2rem; border-top:1px solid rgba(0,0,0,0.06);">
                            <div style="font-size:.75rem; font-weight:800; text-transform:uppercase; letter-spacing:.05em; color:#64748b; margin-bottom:.8rem;">
                                Запросити учасника
                            </div>
                            <form asp-action="InviteParticipant" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="tripId" value="@Model.Trip.Id" />
                                <div style="margin-bottom:.7rem;">
                                    <input type="email" name="email" required placeholder="Email користувача"
                                           style="width:100%; padding:.65rem 1rem; border:1px solid rgba(0,0,0,0.1); border-radius:12px; font-size:.88rem; font-family:'Inter',sans-serif; background:rgba(255,255,255,0.8); outline:none; box-sizing:border-box; transition:border-color .2s;"
                                           onfocus="this.style.borderColor='#6366f1'"
                                           onblur="this.style.borderColor='rgba(0,0,0,0.1)'" />
                                </div>
                                <div style="margin-bottom:.9rem;">
                                    <select name="roleId" required
                                            style="width:100%; padding:.65rem 1rem; border:1px solid rgba(0,0,0,0.1); border-radius:12px; font-size:.88rem; font-family:'Inter',sans-serif; background:rgba(255,255,255,0.8); outline:none; box-sizing:border-box; appearance:none; cursor:pointer; transition:border-color .2s;"
                                            onfocus="this.style.borderColor='#6366f1'"
                                            onblur="this.style.borderColor='rgba(0,0,0,0.1)'">
                                        <option value="" disabled selected>Оберіть роль</option>
                                        @foreach (var role in (IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.AvailableRoles)
                                        {
                                            if (role.Text != "Organizer" && role.Text != "Організатор")
                                            {
                                                <option value="@role.Value">@role.Text</option>
                                            }
                                        }
                                    </select>
                                </div>
                                <button type="submit"
                                        style="width:100%; background:linear-gradient(135deg,#6366f1,#8b5cf6); color:white; border:none; border-radius:12px; padding:.7rem 1rem; font-family:'Montserrat',sans-serif; font-weight:800; font-size:.85rem; cursor:pointer; transition:all .2s; box-shadow:0 4px 15px rgba(99,102,241,0.35);"
                                        onmouseover="this.style.transform='translateY(-1px)'; this.style.boxShadow='0 6px 20px rgba(99,102,241,0.5)';"
                                        onmouseout="this.style.transform=''; this.style.boxShadow='0 4px 15px rgba(99,102,241,0.35)';">
                                    <i class="bi bi-person-plus-fill"></i> Запросити
                                </button>
                            </form>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- ══════════ AI PANEL ══════════ -->
    <div id="aiOverlay" onclick="closeAiPanel()"></div>
    <div id="aiPanel">
        <!-- Header -->
        <div style="background:linear-gradient(135deg,#1e1b4b,#4338ca); padding:1.5rem; position:relative;">
            <div style="display:flex; justify-content:space-between; align-items:flex-start;">
                <div>
                    <div style="font-size:0.65rem; font-weight:800; letter-spacing:0.12em; text-transform:uppercase; color:rgba(255,255,255,0.5);">✨ Згенеровано AI · оновлено <span id="aiTime"></span></div>
                    <div id="aiPanelTitle" style="font-family:'Montserrat',sans-serif; font-weight:900; font-size:1.5rem; color:white; margin-top:0.3rem;"></div>
                </div>
                <button onclick="closeAiPanel()" style="background:rgba(255,255,255,0.1); border:1px solid rgba(255,255,255,0.2); color:white; border-radius:50%; width:36px; height:36px; cursor:pointer; font-size:1rem; flex-shrink:0;">✕</button>
            </div>
            <!-- Tabs -->
            <div style="display:flex; gap:0.4rem; margin-top:1.2rem;">
                <button class="ai-tab-btn active" id="tab-attractions" onclick="switchTab('attractions')">🏛 Атракції</button>
                <button class="ai-tab-btn" id="tab-restaurants" onclick="switchTab('restaurants')">🍽 Ресторани</button>
                <button class="ai-tab-btn" id="tab-tips" onclick="switchTab('tips')">💡 Поради</button>
            </div>
        </div>

        <!-- Body -->
        <div style="padding:1.2rem;">
            <!-- Loading -->
            <div id="aiLoading" style="text-align:center; padding:3rem 1rem; display:none;">
                <div class="ai-spinner"></div>
                <div style="font-weight:700; color:#6366f1; font-size:0.95rem;">Генерую рекомендації...</div>
                <div style="font-size:0.8rem; color:#94a3b8; margin-top:0.4rem;">Зазвичай займає 5–10 секунд</div>
            </div>
            <!-- Error -->
            <div id="aiError" style="display:none; background:#fef2f2; border:1px solid #fecaca; border-radius:16px; padding:1.2rem; text-align:center; color:#ef4444; font-weight:700; font-size:0.9rem;"></div>
            <!-- Content tabs -->
            <div id="content-attractions" class="ai-tab-content"></div>
            <div id="content-restaurants" class="ai-tab-content" style="display:none;"></div>
            <div id="content-tips" class="ai-tab-content" style="display:none;"></div>
        </div>
    </div>

</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/vanilla-tilt/1.8.1/vanilla-tilt.min.js"></script>

    <script>
        // ══ MAP ══
        var map = L.map('map').setView([48.3794, 31.1656], 5);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { attribution: '© OpenStreetMap' }).addTo(map);
        var allPoints = [], routePoints = [];
        const delay = ms => new Promise(res => setTimeout(res, ms));
        const _geoCache = {};

        async function geocodeAddress(address) {
            if (!address || !address.trim()) return null;
            const key = address.trim().toLowerCase();
            if (_geoCache[key] !== undefined) return _geoCache[key];
            try {
                await delay(1200);
                const url = `https://nominatim.openstreetmap.org/search?format=json&limit=1&accept-language=uk&q=${encodeURIComponent(address)}`;
                let response = await fetch(url, { headers: { 'Accept': 'application/json' } });
                if (!response.ok) { _geoCache[key] = null; return null; }
                let data = await response.json();
                if (data && data.length > 0) {
                    const latlng = [parseFloat(data[0].lat), parseFloat(data[0].lon)];
                    _geoCache[key] = latlng; return latlng;
                }
            } catch (e) {}
            _geoCache[key] = null; return null;
        }

        async function buildFullRoute() {
            let departureText = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Trip.DepartureLocation ?? ""));
            let returnText = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Trip.ReturnLocation ?? ""));
            let startLatLng = await geocodeAddress(departureText);
            if (startLatLng) {
                L.marker(startLatLng, { icon: L.divIcon({ html: "🟢", className: 'fs-4 border-0 bg-transparent', iconSize: [24,24], iconAnchor: [12,12] }) }).addTo(map).bindPopup("<b>Старт:</b><br>" + departureText);
                allPoints.push(startLatLng);
            }
            const destinations = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Destinations.Select(d => new { name = $"{d.CityName}, {d.Country}", hasCoords = d.Latitude.HasValue && d.Longitude.HasValue, lat = d.Latitude, lng = d.Longitude })));
            for (let dest of destinations) {
                let latlng = dest.hasCoords ? [dest.lat, dest.lng] : await geocodeAddress(dest.name);
                if (latlng) { L.marker(latlng).addTo(map).bindPopup("<b>" + dest.name + "</b>"); routePoints.push(latlng); allPoints.push(latlng); }
            }
            let endLatLng = await geocodeAddress(returnText);
            if (endLatLng) {
                L.marker(endLatLng, { icon: L.divIcon({ html: "🏁", className: 'fs-4 border-0 bg-transparent', iconSize: [24,24], iconAnchor: [12,12] }) }).addTo(map).bindPopup("<b>Фініш:</b><br>" + returnText);
                allPoints.push(endLatLng);
            }
            let fullPath = [];
            if (startLatLng) fullPath.push(startLatLng);
            fullPath = fullPath.concat(routePoints);
            if (endLatLng) fullPath.push(endLatLng);
            if (fullPath.length > 1) L.polyline(fullPath, { color: '#3b82f6', weight: 3, opacity: 0.85, dashArray: '8, 8' }).addTo(map);
            const accommodations = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Accommodations.Select(a => new { name = a.Name, address = a.Address, hasCoords = a.Latitude.HasValue && a.Longitude.HasValue, lat = a.Latitude, lng = a.Longitude })));
            for (let acc of accommodations) {
                let latlng = acc.hasCoords ? [acc.lat, acc.lng] : await geocodeAddress(acc.address ? acc.address : acc.name);
                if (latlng) {
                    L.marker(latlng, { icon: L.divIcon({ html: "<div style='background:#10b981;color:white;border-radius:50%;width:30px;height:30px;display:flex;align-items:center;justify-content:center;border:2px solid white;box-shadow:0 2px 5px rgba(0,0,0,.3);'>🏠</div>", className: '', iconSize: [30,30], iconAnchor: [15,30] }) }).addTo(map).bindPopup("<b>" + acc.name + "</b>");
                    allPoints.push(latlng);
                }
            }
            if (allPoints.length > 0) map.fitBounds(new L.LatLngBounds(allPoints), { padding: [30, 30] });
        }
        buildFullRoute();

        // ══ AI PANEL ══
        let _aiCache = {};
        let _currentTab = 'attractions';

        function openAiPanel(city, country) {
            document.getElementById('aiOverlay').style.display = 'block';
            document.getElementById('aiPanel').style.display = 'block';
            document.getElementById('aiPanelTitle').textContent = 'Рекомендації для ' + city;
            document.getElementById('aiTime').textContent = new Date().toLocaleTimeString('uk-UA', { hour: '2-digit', minute: '2-digit' });
            switchTab('attractions');
            loadAi(city, country);
        }

        function closeAiPanel() {
            document.getElementById('aiOverlay').style.display = 'none';
            document.getElementById('aiPanel').style.display = 'none';
        }

        function switchTab(tab) {
            _currentTab = tab;
            ['attractions', 'restaurants', 'tips'].forEach(t => {
                document.getElementById('tab-' + t).classList.toggle('active', t === tab);
                document.getElementById('content-' + t).style.display = t === tab ? 'block' : 'none';
            });
        }

        async function loadAi(city, country) {
            const key = city + '|' + country;
            if (_aiCache[key]) { renderAi(_aiCache[key]); return; }

            document.getElementById('aiLoading').style.display = 'block';
            document.getElementById('aiError').style.display = 'none';
            ['attractions', 'restaurants', 'tips'].forEach(t => document.getElementById('content-' + t).innerHTML = '');

            try {
                const res = await fetch(`/TripDestinations/AiRecommendations?city=${encodeURIComponent(city)}&country=${encodeURIComponent(country)}`);
                if (!res.ok) throw new Error('HTTP ' + res.status);
                const data = await res.json();
                if (!data || data.error) throw new Error(data?.error || 'Порожня відповідь');
                _aiCache[key] = data;
                renderAi(data);
            } catch (e) {
                document.getElementById('aiLoading').style.display = 'none';
                document.getElementById('aiError').style.display = 'block';
                document.getElementById('aiError').textContent = '😔 Не вдалося завантажити рекомендації. ' + e.message;
            }
        }

        function renderAi(data) {
            document.getElementById('aiLoading').style.display = 'none';

            // Attractions
            let aHtml = '';
            (data.attractions || []).forEach(p => {
                aHtml += `<div class="ai-place-card">
                    <div style="display:flex; align-items:center; gap:0.8rem; margin-bottom:0.5rem;">
                        <span style="font-size:1.6rem;">${p.emoji || '📍'}</span>
                        <div>
                            <div style="font-family:'Montserrat',sans-serif; font-weight:800; color:#111827; font-size:0.95rem;">${p.name}</div>
                            <div style="font-size:0.75rem; color:#64748b;">${p.category}</div>
                        </div>
                    </div>
                    <div style="font-size:0.85rem; color:#475569; line-height:1.5; margin-bottom:0.7rem;">${p.description}</div>
                    <div style="display:flex; gap:0.5rem; flex-wrap:wrap;">
                        <span style="font-size:0.72rem; font-weight:700; background:#ede9fe; color:#7c3aed; border-radius:50px; padding:0.25rem 0.7rem;">${p.priceRange}</span>
                        <span style="font-size:0.72rem; font-weight:700; background:#e0f2fe; color:#0369a1; border-radius:50px; padding:0.25rem 0.7rem;">⏰ ${p.bestTime}</span>
                    </div>
                </div>`;
            });
            document.getElementById('content-attractions').innerHTML = aHtml || '<div style="color:#94a3b8; font-style:italic; padding:1rem;">Немає даних</div>';

            // Restaurants
            let rHtml = '';
            (data.restaurants || []).forEach(p => {
                rHtml += `<div class="ai-place-card">
                    <div style="display:flex; align-items:center; gap:0.8rem; margin-bottom:0.5rem;">
                        <span style="font-size:1.6rem;">${p.emoji || '🍽'}</span>
                        <div>
                            <div style="font-family:'Montserrat',sans-serif; font-weight:800; color:#111827; font-size:0.95rem;">${p.name}</div>
                            <div style="font-size:0.75rem; color:#64748b;">${p.category}</div>
                        </div>
                    </div>
                    <div style="font-size:0.85rem; color:#475569; line-height:1.5; margin-bottom:0.7rem;">${p.description}</div>
                    <div style="display:flex; gap:0.5rem; flex-wrap:wrap;">
                        <span style="font-size:0.72rem; font-weight:700; background:#fef3c7; color:#d97706; border-radius:50px; padding:0.25rem 0.7rem;">${p.priceRange}</span>
                        <span style="font-size:0.72rem; font-weight:700; background:#e0f2fe; color:#0369a1; border-radius:50px; padding:0.25rem 0.7rem;">⏰ ${p.bestTime}</span>
                    </div>
                </div>`;
            });
            document.getElementById('content-restaurants').innerHTML = rHtml || '<div style="color:#94a3b8; font-style:italic; padding:1rem;">Немає даних</div>';

            // Tips
            let tHtml = '';
            (data.tips || []).forEach(t => {
                tHtml += `<div class="ai-place-card">
                    <div style="display:flex; align-items:flex-start; gap:0.8rem;">
                        <span style="font-size:1.6rem; flex-shrink:0;">${t.emoji || '💡'}</span>
                        <div>
                            <div style="font-family:'Montserrat',sans-serif; font-weight:800; color:#111827; font-size:0.95rem; margin-bottom:0.3rem;">${t.title}</div>
                            <div style="font-size:0.85rem; color:#475569; line-height:1.5;">${t.body}</div>
                        </div>
                    </div>
                </div>`;
            });
            document.getElementById('content-tips').innerHTML = tHtml || '<div style="color:#94a3b8; font-style:italic; padding:1rem;">Немає даних</div>';
        }

        // ══ AI BUDGET ANALYSIS ══
        async function runAiBudget(tripId) {
            document.getElementById('aib-idle').style.display = 'none';
            document.getElementById('aib-loading').style.display = 'block';
            document.getElementById('aib-error').style.display = 'none';
            document.getElementById('aib-result').style.display = 'none';
            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
                const res = await fetch(`/Expenses/AiAnalyze?tripId=${tripId}`, {
                    method: 'POST',
                    headers: { 'RequestVerificationToken': token }
                });
                if (!res.ok) throw new Error('HTTP ' + res.status);
                const data = await res.json();
                document.getElementById('aib-loading').style.display = 'none';
                if (data.error) {
                    document.getElementById('aib-error').style.display = 'block';
                    document.getElementById('aib-error').textContent = data.error;
                    document.getElementById('aib-idle').style.display = 'block';
                    return;
                }
                document.getElementById('aib-content').innerHTML = data.html;
                document.getElementById('aib-result').style.display = 'block';
            } catch(e) {
                document.getElementById('aib-loading').style.display = 'none';
                document.getElementById('aib-error').style.display = 'block';
                document.getElementById('aib-error').textContent = '😔 ' + e.message;
                document.getElementById('aib-idle').style.display = 'block';
            }
        }
        function resetAiBudget() {
            document.getElementById('aib-result').style.display = 'none';
            document.getElementById('aib-idle').style.display = 'block';
        }
    </script>
}

@* ── Timeline filter ────────────────────────────────────────────────────── *@
<script>
    function tlFilter(type, btn) {
        document.querySelectorAll('.tl-filter-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        const items  = document.querySelectorAll('.timeline-item');
        const gaps   = document.querySelectorAll('.tl-gap-label');
        const labels = document.querySelectorAll('.tl-date-label');

        items.forEach(el => {
            el.style.display = (type === 'all' || el.dataset.type === type) ? '' : 'none';
        });
        gaps.forEach(el => {
            el.style.display = (type === 'all' || el.dataset.type === type) ? '' : 'none';
        });

        // Ховаємо дату-заголовок якщо в групі немає видимих подій
        labels.forEach(label => {
            const date = label.dataset.date;
            const groupItems = document.querySelectorAll(`.timeline-item[data-type]`);
            const visibleInGroup = [...document.querySelectorAll('.timeline-item')]
                .filter(el => el.style.display !== 'none');
            label.style.display = visibleInGroup.length === 0 ? 'none' : '';
        });
    }
</script>

@* ── Destination weather cards ──────────────────────────────────────────── *@
<script>
    (function () {
        const destIds = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                                                Model.Destinations.Select(d => d.Id).ToList()
                                ));

        destIds.forEach(id => {
            fetch(`/TripDestinations/WeatherCard?destinationId=${id}`)
                .then(r => r.ok ? r.json() : null)
                .then(data => {
                    const cell = document.getElementById(`wcard-${id}`);
                    if (!cell) return;

                    if (!data || (data.temp == null && !data.flagUrl)) {
                        cell.innerHTML = '<span style="color:#94a3b8; font-size:0.75rem;">—</span>';
                        return;
                    }

                    const temp = data.temp != null ? `${Math.round(data.temp)}°C` : '';
                    const icon = data.icon || '';
                    const desc = data.desc || '';

                    let html = '';

                    if (data.flagUrl) {
                        html += `<img class="dest-flag" src="${data.flagUrl}" alt="${data.flagAlt || data.country || ''}" title="${data.country || ''}">`;
                    }

                    if (temp) {
                        html += `<div class="dest-weather-info">
                            <span class="dest-weather-temp">${icon} ${temp}</span>
                            <span class="dest-weather-desc">${desc}</span>
                        </div>`;
                    }

                    cell.innerHTML = html || '<span style="color:#94a3b8; font-size:0.75rem;">—</span>';
                })
                .catch(() => {
                    const cell = document.getElementById(`wcard-${id}`);
                    if (cell) cell.innerHTML = '<span style="color:#94a3b8; font-size:0.75rem;">—</span>';
                });
        });
    })();
</script>

@* ── Hero video background ──────────────────────────────────────────────── *@
<script>
    // ── Hero video: shared helpers ──────────────────────────────────────────
    const _heroCard = document.getElementById('heroCard');
    const _heroBgVideo = document.getElementById('heroBgVideo');

    function _applyHeroVideo(src) {
        if (!_heroBgVideo) return;
        _heroBgVideo.classList.remove('loaded');
        _heroBgVideo.src = src;
        _heroBgVideo.oncanplay = () => {
            _heroBgVideo.classList.add('loaded');
            _heroCard && _heroCard.classList.remove('video-loading');
        };
        _heroBgVideo.onerror = () => _heroCard && _heroCard.classList.remove('video-loading');
        _heroBgVideo.load();
    }

    function _fetchAndPlayVideo(query, btn) {
        const cacheKey = 'hero_video_' + query.toLowerCase().replace(/\s+/g, '_');
        const cached = sessionStorage.getItem(cacheKey);
        if (cached) { _applyHeroVideo(cached); return; }

        fetch(`/PexelsProxy/Video?query=${encodeURIComponent(query)}`)
            .then(r => { if (!r.ok) throw new Error(r.status); return r.json(); })
            .then(data => {
                const videos = (data.videos || []).filter(v => v.duration >= 5 && v.duration <= 20);
                if (!videos.length) { _heroCard && _heroCard.classList.remove('video-loading'); return; }

                const pick = videos[Math.floor(Math.random() * Math.min(videos.length, 5))];
                const file =
                    pick.video_files.find(f => f.quality === 'sd' && f.width <= 640) ||
                    pick.video_files.find(f => f.quality === 'sd') ||
                    pick.video_files.sort((a, b) => (a.width || 9999) - (b.width || 9999))[0];

                if (!file) { _heroCard && _heroCard.classList.remove('video-loading'); return; }
                sessionStorage.setItem(cacheKey, file.link);
                _applyHeroVideo(file.link);
            })
            .catch(() => _heroCard && _heroCard.classList.remove('video-loading'))
            .finally(() => {
                if (btn) btn.innerHTML = btn.dataset.origLabel;
            });
    }

    // ── Auto-load on page open ───────────────────────────────────────────────
    (function () {
        if (!_heroCard || !_heroBgVideo) return;
        const rawQuery = (_heroCard.dataset.videoQuery || 'travel').trim();

        // Активуємо першу кнопку-місто якщо є
        const firstBtn = document.querySelector('.city-vid-btn[data-city]');
        if (firstBtn) firstBtn.classList.add('active');

        _fetchAndPlayVideo(rawQuery, null);
    })();

    // ── Перемикач міст ───────────────────────────────────────────────────────
    function switchHeroVideo(city, btn) {
        // Скидаємо активний стан з усіх кнопок
        document.querySelectorAll('.city-vid-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        // Показуємо спінер
        btn.dataset.origLabel = btn.innerHTML;
        btn.innerHTML = `<span class="spin">⏳</span> ${city}`;

        _heroCard && _heroCard.classList.add('video-loading');
        _fetchAndPlayVideo(city, btn);
    }

    function shuffleHeroVideo(btn) {
        // Збираємо всі міста з кнопок
        const cityBtns = [...document.querySelectorAll('.city-vid-btn[data-city]')];
        if (!cityBtns.length) return;

        document.querySelectorAll('.city-vid-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        const randomBtn = cityBtns[Math.floor(Math.random() * cityBtns.length)];
        const city = randomBtn.dataset.city;

        // Видаляємо кеш щоб отримати інше відео
        const cacheKey = 'hero_video_' + city.toLowerCase().replace(/\s+/g, '_');
        sessionStorage.removeItem(cacheKey);

        btn.dataset.origLabel = btn.innerHTML;
        btn.innerHTML = `<span class="spin">⏳</span> Рандомне`;

        _heroCard && _heroCard.classList.add('video-loading');
        _fetchAndPlayVideo(city, btn);
    }
</script>
