@model TravelManager.UI.Models.ViewModels.TripDetailsViewModel

@{
    ViewData["Title"] = "План: " + Model.Trip.Title;
    var daysLeft = (Model.Trip.StartDate - DateTime.Today).Days;
    var isActive = DateTime.Today >= Model.Trip.StartDate && DateTime.Today <= Model.Trip.EndDate;
    var isPast = DateTime.Today > Model.Trip.EndDate;
    var duration = (Model.Trip.EndDate - Model.Trip.StartDate).Days;

    decimal totalBudget = 0;
    string baseCurr = Model.Trip.BaseCurrency ?? "UAH";
    decimal usdRate = 43.83m, eurRate = 50.88m, plnRate = 11.10m, gbpRate = 59.50m;
    if (Model.Expenses != null)
    {
        foreach (var exp in Model.Expenses)
        {
            decimal amt = exp.TotalAmount;
            if (exp.Currency != baseCurr && baseCurr == "UAH")
            {
                if (exp.Currency == "USD") amt *= usdRate;
                else if (exp.Currency == "EUR") amt *= eurRate;
                else if (exp.Currency == "PLN") amt *= plnRate;
                else if (exp.Currency == "GBP") amt *= gbpRate;
            }
            totalBudget += amt;
        }
    }

    var checkIn = Model.Trip.StartDate.ToString("yyyy-MM-dd");
    var checkOut = Model.Trip.EndDate.ToString("yyyy-MM-dd");
    var city = Model.Destinations.FirstOrDefault()?.CityName ?? "";
    var bookingUrl = $"https://www.booking.com/searchresults.html?ss={Uri.EscapeDataString(city)}&checkin={checkIn}&checkout={checkOut}";
    var gcTitle = Uri.EscapeDataString("Подорож: " + (Model.Trip.Title ?? ""));
    var gcDetails = Uri.EscapeDataString(Model.Trip.Description ?? "Запланована подорож у TravelManager");
    var gcLocation = Uri.EscapeDataString($"{Model.Trip.DepartureLocation} - {Model.Trip.ReturnLocation}");
    var gcStartDate = Model.Trip.StartDate.ToString("yyyyMMdd");
    var gcEndDate = Model.Trip.EndDate.AddDays(1).ToString("yyyyMMdd");
    var googleCalendarUrl = $"https://calendar.google.com/calendar/render?action=TEMPLATE&text={gcTitle}&dates={gcStartDate}/{gcEndDate}&details={gcDetails}&location={gcLocation}";
}

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
