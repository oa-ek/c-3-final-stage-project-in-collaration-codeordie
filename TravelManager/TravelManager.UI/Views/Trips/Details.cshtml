@model TravelManager.UI.Models.ViewModels.TripDetailsViewModel

@{
    ViewData["Title"] = "План: " + Model.Trip.Title;
    var daysLeft = (Model.Trip.StartDate - DateTime.Today).Days;
    var isActive = DateTime.Today >= Model.Trip.StartDate && DateTime.Today <= Model.Trip.EndDate;
    var isPast = DateTime.Today > Model.Trip.EndDate;
    var duration = (Model.Trip.EndDate - Model.Trip.StartDate).Days;

    decimal totalBudget = 0;
    string baseCurr = Model.Trip.BaseCurrency ?? "UAH";
    decimal usdRate = 43.83m, eurRate = 50.88m, plnRate = 11.10m, gbpRate = 59.50m;
    if (Model.Expenses != null)
    {
        foreach (var exp in Model.Expenses)
        {
            decimal amt = exp.TotalAmount;
            if (exp.Currency != baseCurr && baseCurr == "UAH")
            {
                if (exp.Currency == "USD") amt *= usdRate;
                else if (exp.Currency == "EUR") amt *= eurRate;
                else if (exp.Currency == "PLN") amt *= plnRate;
                else if (exp.Currency == "GBP") amt *= gbpRate;
            }
            totalBudget += amt;
        }
    }

    var checkIn = Model.Trip.StartDate.ToString("yyyy-MM-dd");
    var checkOut = Model.Trip.EndDate.ToString("yyyy-MM-dd");
    var city = Model.Destinations.FirstOrDefault()?.CityName ?? "";
    var bookingUrl = $"https://www.booking.com/searchresults.html?ss={Uri.EscapeDataString(city)}&checkin={checkIn}&checkout={checkOut}";
    var gcTitle = Uri.EscapeDataString("Подорож: " + (Model.Trip.Title ?? ""));
    var gcDetails = Uri.EscapeDataString(Model.Trip.Description ?? "Запланована подорож у TravelManager");
    var gcLocation = Uri.EscapeDataString($"{Model.Trip.DepartureLocation} - {Model.Trip.ReturnLocation}");
    var gcStartDate = Model.Trip.StartDate.ToString("yyyyMMdd");
    var gcEndDate = Model.Trip.EndDate.AddDays(1).ToString("yyyyMMdd");
    var googleCalendarUrl = $"https://calendar.google.com/calendar/render?action=TEMPLATE&text={gcTitle}&dates={gcStartDate}/{gcEndDate}&details={gcDetails}&location={gcLocation}";
}

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@700;800;900&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
    body {
        background: #eef4f9;
        margin: 0;
        padding: 0;
    }

    .det-root {
        font-family: 'Inter', sans-serif;
        background: #eef4f9;
        min-height: 100vh;
        padding-bottom: 5rem;
        padding-top: 2rem;
    }

    @@keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(24px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
        }

        to {
            opacity: 1;
        }
    }

    @@keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }

    @@keyframes pulse-ring {
        0% {
            transform: scale(1);
            opacity: .6;
        }

        100% {
            transform: scale(2.2);
            opacity: 0;
        }
    }

    @@keyframes slideIn {
        from {
            transform: translateX(100%);
            opacity: 0;
        }

        to {
            transform: translateX(0);
            opacity: 1;
        }
    }

    @@keyframes floatBadge {
        0%, 100% {
            transform: translateY(0);
        }

        50% {
            transform: translateY(-4px);
        }
    }

    @@keyframes shimmer {
        0% {
            background-position: -200% center;
        }

        100% {
            background-position: 200% center;
        }
    }

    /* ─── HERO ─────────────────────────────────── */
    .hero-glass-card {
        max-width: 1200px;
        margin: 0 auto 2rem auto;
        background: linear-gradient(135deg, rgba(17,24,39,.88) 0%, rgba(30,27,75,.88) 100%);
        backdrop-filter: blur(24px);
        -webkit-backdrop-filter: blur(24px);
        border: 1px solid rgba(255,255,255,.1);
        border-radius: 32px;
        padding: 3rem;
        box-shadow: 0 20px 60px rgba(0,0,0,.2);
        position: relative;
        overflow: hidden;
        animation: fadeUp .5s ease both;
    }

    .hero-dots {
        position: absolute;
        inset: 0;
        opacity: .04;
        background-image: radial-gradient(circle,#fff 1px,transparent 1px);
        background-size: 24px 24px;
        pointer-events: none;
    }

    /* animated gradient orb */
    .hero-orb {
        position: absolute;
        border-radius: 50%;
        filter: blur(60px);
        pointer-events: none;
        opacity: .15;
    }

    .hero-orb-1 {
        width: 300px;
        height: 300px;
        background: #6366f1;
        top: -80px;
        right: -60px;
        animation: floatBadge 6s ease-in-out infinite;
    }

    .hero-orb-2 {
        width: 200px;
        height: 200px;
        background: #10b981;
        bottom: -60px;
        left: 10%;
        animation: floatBadge 8s ease-in-out infinite reverse;
    }

    .hero-content {
        position: relative;
        z-index: 2;
    }

    .btn-back {
        display: inline-flex;
        align-items: center;
        gap: .5rem;
        background: rgba(255,255,255,.08);
        border: 1px solid rgba(255,255,255,.15);
        color: white;
        padding: .6rem 1.2rem;
        border-radius: 50px;
        font-size: .85rem;
        font-weight: 600;
        text-decoration: none;
        margin-bottom: 2rem;
        transition: all .2s ease;
    }

        .btn-back:hover {
            background: rgba(255,255,255,.15);
            transform: translateX(-3px);
            color: white;
        }

    .trip-main-title {
        font-family: 'Montserrat', sans-serif;
        font-size: clamp(3rem,6vw,4.5rem);
        font-weight: 900;
        color: white;
        line-height: 1;
        letter-spacing: -.03em;
        margin-bottom: 1.5rem;
    }

    /* shimmer on title */
    .title-shimmer {
        background: linear-gradient(90deg, white 0%, #a5b4fc 40%, white 60%, #6ee7b7 100%);
        background-size: 200% auto;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        animation: shimmer 4s linear infinite;
    }

    .info-pills-row {
        display: flex;
        flex-wrap: wrap;
        gap: .7rem;
        margin-bottom: 2.5rem;
    }

    .info-pill {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        background: rgba(255,255,255,.1);
        border: 1px solid rgba(255,255,255,.15);
        border-radius: 50px;
        padding: .5rem 1.2rem;
        font-size: .8rem;
        font-weight: 700;
        color: white;
        backdrop-filter: blur(10px);
        transition: all .2s;
    }

        .info-pill:hover {
            background: rgba(255,255,255,.18);
            transform: translateY(-1px);
        }

        .info-pill.active-status {
            background: rgba(16,185,129,.2);
            border-color: rgba(16,185,129,.4);
        }

        .info-pill.past-status {
            background: rgba(148,163,184,.2);
            border-color: rgba(148,163,184,.4);
        }

    .status-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #4ade80;
        box-shadow: 0 0 0 0 rgba(74,222,128,.5);
        animation: pulse-ring 1.5s ease-out infinite;
    }

    .nav-buttons-row {
        display: flex;
        flex-wrap: wrap;
        gap: .8rem;
    }

    .nav-btn {
        display: inline-flex;
        align-items: center;
        gap: .5rem;
        background: white;
        color: #0f172a;
        font-family: 'Montserrat', sans-serif;
        font-weight: 800;
        font-size: .85rem;
        padding: .8rem 1.5rem;
        border-radius: 50px;
        text-decoration: none;
        transition: all .25s ease;
        box-shadow: 0 4px 15px rgba(0,0,0,.12);
        border: none;
        cursor: pointer;
    }

        .nav-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(0,0,0,.15);
            color: #0f172a;
        }

        .nav-btn.active {
            background: #10b981;
            color: white;
            box-shadow: 0 4px 20px rgba(16,185,129,.4);
        }

            .nav-btn.active:hover {
                color: white;
                box-shadow: 0 8px 28px rgba(16,185,129,.5);
            }

        .nav-btn.ghost {
            background: rgba(255,255,255,.1);
            border: 1px solid rgba(255,255,255,.2);
            color: white;
            box-shadow: none;
        }

            .nav-btn.ghost:hover {
                background: rgba(255,255,255,.2);
                color: white;
            }

    /* ─── LAYOUT ───────────────────────────────── */
    .content-container {
        max-width: 1200px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: 1fr 380px;
        gap: 1.5rem;
        align-items: start;
    }

    @@media(max-width:900px) {
        .content-container {
            grid-template-columns: 1fr;
        }
    }

    /* ─── CARDS ────────────────────────────────── */
    .light-glass-card {
        background: rgba(255,255,255,.82);
        backdrop-filter: blur(24px);
        -webkit-backdrop-filter: blur(24px);
        border: 1px solid rgba(255,255,255,1);
        border-radius: 24px;
        box-shadow: 0 8px 32px rgba(0,0,0,.06);
        overflow: hidden;
        margin-bottom: 1.5rem;
        animation: fadeUp .6s ease both;
        transition: box-shadow .3s, transform .3s;
    }

        .light-glass-card:hover {
            box-shadow: 0 16px 48px rgba(0,0,0,.1);
        }

    .card-header {
        padding: 1.4rem 1.8rem;
        border-bottom: 1px solid rgba(0,0,0,.05);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .card-header-title {
        font-family: 'Montserrat', sans-serif;
        font-size: 1rem;
        font-weight: 800;
        color: #0f172a;
        display: flex;
        align-items: center;
        gap: .6rem;
    }

    .icon-box {
        width: 34px;
        height: 34px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 1rem;
        box-shadow: 0 4px 10px rgba(0,0,0,.15);
    }

    .btn-add-small {
        background: rgba(0,0,0,.04);
        color: #475569;
        font-family: 'Montserrat', sans-serif;
        font-size: .75rem;
        font-weight: 700;
        padding: .45rem .9rem;
        border-radius: 50px;
        text-decoration: none;
        transition: all .2s;
        border: 1px solid transparent;
    }

        .btn-add-small:hover {
            background: white;
            box-shadow: 0 4px 12px rgba(0,0,0,.08);
            color: #0f172a;
            border-color: rgba(0,0,0,.05);
        }

    /* ─── ROUTE TABLE ──────────────────────────── */
    .clean-table {
        width: 100%;
        border-collapse: collapse;
    }

        .clean-table th {
            padding: .9rem 1.8rem;
            text-align: left;
            font-size: .68rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: .06em;
            color: #94a3b8;
        }

        .clean-table td {
            padding: 1.1rem 1.8rem;
            font-size: .9rem;
            border-bottom: 1px solid rgba(0,0,0,.04);
        }

        .clean-table tr:last-child td {
            border-bottom: none;
        }

        .clean-table tbody tr {
            transition: background .15s;
        }

            .clean-table tbody tr:hover {
                background: rgba(99,102,241,.03);
            }

    /* ─── MAP CARD ─────────────────────────────── */
    .map-wrapper {
        position: relative;
        border-radius: 0 0 24px 24px;
        overflow: hidden;
    }

    #map {
        height: 380px;
        width: 100%;
        z-index: 1;
    }

    /* Custom Leaflet marker styles */
    .marker-pin-start,
    .marker-pin-dest,
    .marker-pin-end,
    .marker-pin-hotel {
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50% 50% 50% 0;
        transform: rotate(-45deg);
        box-shadow: 0 4px 16px rgba(0,0,0,.25);
        border: 3px solid white;
    }

    .marker-pin-start {
        background: #10b981;
        width: 36px;
        height: 36px;
    }

    .marker-pin-dest {
        background: #6366f1;
        width: 32px;
        height: 32px;
    }

    .marker-pin-end {
        background: #ef4444;
        width: 36px;
        height: 36px;
    }

    .marker-pin-hotel {
        background: #f59e0b;
        width: 28px;
        height: 28px;
        border-radius: 8px;
        transform: none;
    }

        .marker-pin-start span,
        .marker-pin-dest span,
        .marker-pin-end span,
        .marker-pin-hotel span {
            transform: rotate(45deg);
            font-size: 15px;
            display: block;
        }

        .marker-pin-hotel span {
            transform: none;
        }

    /* pulse ring under dest markers */
    .marker-pulse {
        position: absolute;
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: rgba(99,102,241,.3);
        top: 0;
        left: 0;
        animation: pulse-ring 2s ease-out infinite;
    }

    /* Leaflet popup */
    .leaflet-popup-content-wrapper {
        border-radius: 16px !important;
        box-shadow: 0 8px 30px rgba(0,0,0,.15) !important;
        border: none !important;
        font-family: 'Inter', sans-serif !important;
    }

    .leaflet-popup-tip {
        display: none !important;
    }

    /* ─── TIMELINE ─────────────────────────────── */
    .timeline-container {
        position: relative;
        padding-left: 2rem;
        margin-top: .5rem;
    }

        .timeline-container::before {
            content: '';
            position: absolute;
            left: 6px;
            top: 6px;
            bottom: 6px;
            width: 2px;
            background: linear-gradient(to bottom, #6366f1, #10b981, #f59e0b);
            border-radius: 2px;
            opacity: .25;
        }

    .timeline-item {
        position: relative;
        margin-bottom: 1.4rem;
    }

        .timeline-item:last-child {
            margin-bottom: 0;
        }

    .timeline-dot {
        position: absolute;
        left: -2.2rem;
        top: .2rem;
        width: 14px;
        height: 14px;
        border-radius: 50%;
        border: 3px solid white;
        box-shadow: 0 2px 8px rgba(0,0,0,.15);
        transition: transform .2s;
    }

    .timeline-item:hover .timeline-dot {
        transform: scale(1.3);
    }

    /* ─── TRANSPORT ────────────────────────────── */
    .transit-row {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1.1rem 1.8rem;
        border-bottom: 1px solid rgba(0,0,0,.04);
        transition: background .15s;
    }

        .transit-row:hover {
            background: rgba(139,92,246,.03);
        }

        .transit-row:last-child {
            border-bottom: none;
        }

    .transit-icon-box {
        width: 44px;
        height: 44px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.3rem;
        flex-shrink: 0;
        transition: transform .2s;
    }

    .transit-row:hover .transit-icon-box {
        transform: scale(1.1) rotate(-5deg);
    }

    /* ─── SIDEBAR DARK ─────────────────────────── */
    .dark-glass-card {
        background: linear-gradient(135deg, rgba(15,23,42,.92) 0%, rgba(30,27,75,.92) 100%);
        backdrop-filter: blur(24px);
        -webkit-backdrop-filter: blur(24px);
        border: 1px solid rgba(255,255,255,.08);
        border-radius: 24px;
        padding: 2rem;
        color: white;
        margin-bottom: 1.5rem;
        box-shadow: 0 16px 48px rgba(0,0,0,.18);
        animation: fadeUp .6s ease both;
        position: relative;
        overflow: hidden;
    }

        .dark-glass-card::after {
            content: '';
            position: absolute;
            bottom: -40px;
            right: -40px;
            width: 160px;
            height: 160px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(99,102,241,.3), transparent 70%);
            pointer-events: none;
        }

    .budget-amount {
        font-family: 'Montserrat', sans-serif;
        font-size: 2.8rem;
        font-weight: 900;
        line-height: 1;
        margin: .8rem 0 .4rem;
        letter-spacing: -.02em;
        background: linear-gradient(90deg, #fff, #a5b4fc);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    /* ─── LIST ITEM ────────────────────────────── */
    .list-item-card {
        border: 1px solid rgba(0,0,0,.05);
        border-radius: 16px;
        padding: 1.1rem;
        background: rgba(255,255,255,.55);
        margin-bottom: .75rem;
        transition: all .25s;
    }

        .list-item-card:hover {
            background: white;
            border-color: rgba(0,0,0,.08);
            box-shadow: 0 6px 20px rgba(0,0,0,.06);
            transform: translateY(-2px);
        }

    /* ─── AI PANEL ─────────────────────────────── */
    #aiOverlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,.45);
        z-index: 9998;
        backdrop-filter: blur(6px);
    }

    #aiPanel {
        display: none;
        position: fixed;
        top: 72px;
        right: 0;
        width: 450px;
        max-width: 100vw;
        height: calc(100vh - 72px);
        background: #f8fafc;
        box-shadow: -12px 0 50px rgba(0,0,0,.2);
        z-index: 9999;
        overflow-y: auto;
        font-family: 'Inter', sans-serif;
        animation: slideIn .3s cubic-bezier(.22,.68,0,1.2) both;
    }

    .ai-panel-header {
        background: linear-gradient(135deg,#1e1b4b,#312e81);
        padding: 1.5rem;
        position: sticky;
        top: 0;
        z-index: 1;
    }

    .ai-panel-city {
        font-family: 'Montserrat', sans-serif;
        font-weight: 900;
        font-size: 1.45rem;
        color: white;
        margin-top: .25rem;
    }

    .ai-panel-meta {
        font-size: .62rem;
        font-weight: 800;
        letter-spacing: .12em;
        text-transform: uppercase;
        color: rgba(255,255,255,.45);
    }

    .ai-close-btn {
        position: absolute;
        top: 1.2rem;
        right: 1.2rem;
        background: rgba(255,255,255,.1);
        border: 1px solid rgba(255,255,255,.2);
        color: white;
        border-radius: 50%;
        width: 34px;
        height: 34px;
        cursor: pointer;
        font-size: .9rem;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: background .2s;
    }

        .ai-close-btn:hover {
            background: rgba(255,255,255,.2);
        }

    .ai-tabs {
        display: flex;
        gap: .4rem;
        margin-top: 1.1rem;
    }

    .ai-tab-btn {
        flex: 1;
        padding: .5rem .3rem;
        border: none;
        border-radius: 50px;
        font-family: 'Montserrat', sans-serif;
        font-weight: 800;
        font-size: .7rem;
        cursor: pointer;
        transition: all .2s;
        background: rgba(255,255,255,.1);
        color: rgba(255,255,255,.55);
    }

        .ai-tab-btn.active {
            background: white;
            color: #312e81;
        }

    .ai-place-card {
        background: white;
        border-radius: 16px;
        padding: .95rem 1.1rem;
        margin-bottom: .75rem;
        border: 1px solid rgba(0,0,0,.05);
        box-shadow: 0 2px 8px rgba(0,0,0,.04);
        transition: all .2s;
    }

        .ai-place-card:hover {
            box-shadow: 0 6px 20px rgba(0,0,0,.08);
            transform: translateY(-1px);
        }

    .ai-spinner {
        width: 38px;
        height: 38px;
        border: 3px solid rgba(99,102,241,.15);
        border-top-color: #6366f1;
        border-radius: 50%;
        animation: spin .7s linear infinite;
        margin: 0 auto 1rem;
    }
</style>

<div class="det-root">

    <!-- ══ HERO ══ -->
    <div class="hero-glass-card" data-tilt data-tilt-max="1" data-tilt-speed="1000" data-tilt-glare data-tilt-max-glare="0.04">
        <div class="hero-dots"></div>
        <div class="hero-orb hero-orb-1"></div>
        <div class="hero-orb hero-orb-2"></div>
        <div class="hero-content">

            @if (TempData["SuccessMessage"] != null)
            {
                <div style="margin-bottom:1.2rem;padding:.9rem 1.4rem;background:rgba(16,185,129,.15);border:1px solid rgba(16,185,129,.35);border-radius:16px;color:#d1fae5;font-weight:700;font-size:.9rem;display:flex;align-items:center;gap:.6rem;">
                    <i class="bi bi-check-circle-fill" style="color:#4ade80;"></i> @TempData["SuccessMessage"]
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div style="margin-bottom:1.2rem;padding:.9rem 1.4rem;background:rgba(239,68,68,.15);border:1px solid rgba(239,68,68,.35);border-radius:16px;color:#fecaca;font-weight:700;font-size:.9rem;display:flex;align-items:center;gap:.6rem;">
                    <i class="bi bi-exclamation-triangle-fill" style="color:#f87171;"></i> @TempData["ErrorMessage"]
                </div>
            }

            <a asp-action="Index" class="btn-back">
                <i class="bi bi-arrow-left"></i> До всіх поїздок
            </a>

            <h1 class="trip-main-title">
                <span class="title-shimmer">@Model.Trip.Title</span>
            </h1>

            <div class="info-pills-row">
                @if (isActive)
                {
                    <span class="info-pill active-status">
                        <span class="status-dot"></span> В процесі
                    </span>
                }
                else if (isPast)
                {
                    <span class="info-pill past-status"><i class="bi bi-check-circle"></i> Завершено</span>
                }
                else
                {
                    <span class="info-pill"><i class="bi bi-clock"></i> @(daysLeft > 0 ? $"Через {daysLeft} днів" : "Сьогодні!")</span>
                }
                <span class="info-pill"><i class="bi bi-calendar3"></i> @Model.Trip.StartDate.ToString("dd MMM") — @Model.Trip.EndDate.ToString("dd MMM yyyy")</span>
                @if (!string.IsNullOrEmpty(Model.Trip.DepartureLocation))
                {
                    <span class="info-pill"><i class="bi bi-geo-alt"></i> @Model.Trip.DepartureLocation → @Model.Trip.ReturnLocation</span>
                }
                @if (ViewBag.TotalDistance > 0)
                {
                    <span class="info-pill" title="Розраховано за формулою Гаверсина">
                        <i class="bi bi-rulers"></i> @ViewBag.TotalDistance км
                    </span>
                }
                <span class="info-pill"><i class="bi bi-currency-exchange"></i> @Model.Trip.BaseCurrency</span>
            </div>

            <div class="nav-buttons-row">
                <a asp-controller="Expenses" asp-action="Create" asp-route-tripId="@Model.Trip.Id" class="nav-btn active"><i class="bi bi-cash-coin"></i> Витрата</a>
                <a asp-action="DownloadCalendar" asp-route-id="@Model.Trip.Id" class="nav-btn ghost"><i class="bi bi-calendar-plus"></i> В календар</a>
                <a asp-action="ExportToCsv" asp-route-id="@Model.Trip.Id" class="nav-btn ghost"><i class="bi bi-file-earmark-excel" style="color:#10b981;"></i> Excel</a>
                <a asp-action="ExportToWord" asp-route-id="@Model.Trip.Id" class="nav-btn ghost"><i class="bi bi-file-earmark-word-fill" style="color:#2563eb;"></i> Word</a>
                <a href="@googleCalendarUrl" target="_blank" class="nav-btn ghost"><i class="bi bi-google"></i> Google Cal</a>
                <a asp-controller="Accommodations" asp-action="Create" asp-route-tripId="@Model.Trip.Id" class="nav-btn"><i class="bi bi-building"></i> Житло</a>
                <a asp-controller="Transits" asp-action="Create" asp-route-tripId="@Model.Trip.Id" class="nav-btn"><i class="bi bi-airplane"></i> Транзит</a>
                <a asp-controller="TripActivities" asp-action="Create" asp-route-tripId="@Model.Trip.Id" class="nav-btn"><i class="bi bi-lightning"></i> Активність</a>
                <a asp-controller="TripDestinations" asp-action="Create" asp-route-tripId="@Model.Trip.Id" class="nav-btn"><i class="bi bi-geo-alt"></i> Місто</a>
                <a asp-controller="Checklists" asp-action="Create" asp-route-tripId="@Model.Trip.Id" class="nav-btn"><i class="bi bi-check2-square"></i> Чекліст</a>
                <a asp-action="Edit" asp-route-id="@Model.Trip.Id" class="nav-btn ghost"><i class="bi bi-pencil"></i> Редагувати</a>
            </div>
        </div>
    </div>

    <!-- ══ CONTENT GRID ══ -->
    <div class="content-container">

        <!-- LEFT -->
        <div>

            <!-- ROUTE -->
            <div class="light-glass-card" style="animation-delay:.05s;">
                <div class="card-header">
                    <div class="card-header-title">
                        <div class="icon-box" style="background:linear-gradient(135deg,#3b82f6,#6366f1);"><i class="bi bi-geo-alt-fill"></i></div>
                        Маршрут
                    </div>
                    <a asp-controller="TripDestinations" asp-action="Create" asp-route-tripId="@Model.Trip.Id" class="btn-add-small">+ Місто</a>
                </div>
                @if (!Model.Destinations.Any())
                {
                    <div style="padding:1.8rem;color:#94a3b8;font-style:italic;font-size:.9rem;">Міста ще не додані.</div>
                }
                else
                {
                    <table class="clean-table">
                        <thead>
                            <tr>
                                <th>Місто</th>
                                <th>Прибуття</th>
                                <th>Відбуття</th>
                                <th style="text-align:right;">Дії</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var d in Model.Destinations)
                            {
                                <tr>
                                    <td style="font-weight:800;color:#111827;">@d.CityName, @d.Country</td>
                                    <td style="color:#64748b;">@d.ArrivalDate.ToString("dd.MM.yyyy")</td>
                                    <td style="color:#64748b;">@d.DepartureDate.ToString("dd.MM.yyyy")</td>
                                    <td style="text-align:right;">
                                        <div style="display:flex;align-items:center;justify-content:flex-end;gap:.7rem;">
                                            <button onclick="openAiPanel('@d.CityName', '@d.Country')"
                                                    style="background:linear-gradient(135deg,#6366f1,#8b5cf6);color:white;border:none;border-radius:50px;padding:.35rem .95rem;font-size:.72rem;font-weight:800;cursor:pointer;font-family:'Montserrat',sans-serif;box-shadow:0 3px 12px rgba(99,102,241,.35);transition:all .2s;"
                                                    onmouseover="this.style.transform='translateY(-2px)';this.style.boxShadow='0 6px 18px rgba(99,102,241,.5)'"
                                                    onmouseout="this.style.transform='';this.style.boxShadow='0 3px 12px rgba(99,102,241,.35)'">
                                                ✦ AI
                                            </button>
                                            <a asp-controller="TripDestinations" asp-action="Edit" asp-route-id="@d.Id" style="color:#6366f1;font-weight:800;text-decoration:none;font-size:.85rem;">Ред.</a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>

            <!-- MAP -->
            <div class="light-glass-card" style="animation-delay:.1s;">
                <div class="card-header">
                    <div class="card-header-title">
                        <div class="icon-box" style="background:linear-gradient(135deg,#f59e0b,#f97316);"><i class="bi bi-map-fill"></i></div>
                        Карта подорожі
                    </div>
                </div>
                <div class="map-wrapper">
                    <div id="map"></div>
                </div>
            </div>

            <!-- TIMELINE -->
            <div class="light-glass-card" style="animation-delay:.15s;">
                <div class="card-header">
                    <div class="card-header-title">
                        <div class="icon-box" style="background:linear-gradient(135deg,#ec4899,#f43f5e);"><i class="bi bi-clock-history"></i></div>
                        Хронологія
                    </div>
                </div>
                <div style="padding:1.5rem;">
                    @if (Model.Timeline == null || !Model.Timeline.Any())
                    {
                        <div style="color:#94a3b8;font-style:italic;font-size:.9rem;">Додайте квитки, міста або житло, щоб побачити маршрут.</div>
                    }
                    else
                    {
                        <div class="timeline-container">
                            @foreach (var item in Model.Timeline)
                            {
                                <div class="timeline-item">
                                    <div class="timeline-dot" style="background:@item.IconColor;"></div>
                                    <div style="display:flex;justify-content:space-between;align-items:flex-start;">
                                        <div>
                                            <div style="font-family:'Montserrat';font-weight:800;color:#111827;font-size:.95rem;">@item.Title</div>
                                            <div style="font-size:.82rem;color:#64748b;margin-top:.15rem;">@item.Subtitle</div>
                                        </div>
                                        <span style="font-size:.72rem;font-weight:800;color:@item.IconColor;background:rgba(255,255,255,.9);border:1px solid rgba(0,0,0,.06);padding:.28rem .65rem;border-radius:50px;white-space:nowrap;margin-left:.5rem;">
                                            <i class="bi @item.IconClass me-1"></i>@item.EventDate.ToString("dd MMM HH:mm")
                                        </span>
