                                        }
                                    </select>
                                </div>
                                <button type="submit"
                                        style="width:100%;background:linear-gradient(135deg,#6366f1,#8b5cf6);color:white;border:none;border-radius:12px;padding:.68rem;font-family:'Montserrat',sans-serif;font-weight:800;font-size:.82rem;cursor:pointer;transition:all .2s;box-shadow:0 4px 15px rgba(99,102,241,.3);"
                                        onmouseover="this.style.transform='translateY(-1px)';this.style.boxShadow='0 6px 22px rgba(99,102,241,.45)'"
                                        onmouseout="this.style.transform='';this.style.boxShadow='0 4px 15px rgba(99,102,241,.3)'">
                                    <i class="bi bi-person-plus-fill me-1"></i> Запросити
                                </button>
                            </form>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- ══ AI PANEL ══ -->
    <div id="aiOverlay" onclick="closeAiPanel()"></div>
    <div id="aiPanel">
        <div class="ai-panel-header">
            <div class="ai-panel-meta">✦ AI рекомендації · <span id="aiTime"></span></div>
            <div class="ai-panel-city" id="aiPanelTitle"></div>
            <button class="ai-close-btn" onclick="closeAiPanel()">✕</button>
            <div class="ai-tabs">
                <button class="ai-tab-btn active" id="tab-attractions" onclick="switchTab('attractions')">🏛 Атракції</button>
                <button class="ai-tab-btn" id="tab-restaurants" onclick="switchTab('restaurants')">🍽 Ресторани</button>
                <button class="ai-tab-btn" id="tab-tips" onclick="switchTab('tips')">💡 Поради</button>
            </div>
        </div>
        <div style="padding:1.1rem;">
            <div id="aiLoading" style="text-align:center;padding:3rem 1rem;display:none;">
                <div class="ai-spinner"></div>
                <div style="font-weight:700;color:#6366f1;font-size:.95rem;">Генерую рекомендації...</div>
                <div style="font-size:.8rem;color:#94a3b8;margin-top:.35rem;">Зазвичай 5–10 секунд</div>
            </div>
            <div id="aiError" style="display:none;background:#fef2f2;border:1px solid #fecaca;border-radius:16px;padding:1.1rem;text-align:center;color:#ef4444;font-weight:700;font-size:.88rem;"></div>
            <div id="content-attractions"></div>
            <div id="content-restaurants" style="display:none;"></div>
            <div id="content-tips" style="display:none;"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/vanilla-tilt/1.8.1/vanilla-tilt.min.js"></script>
    <script>
        // ══ MAP ══════════════════════════════════════════
        var map = L.map('map', { zoomControl: false }).setView([48.3794,31.1656], 5);
        L.control.zoom({ position: 'bottomright' }).addTo(map);

        L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png', {
            attribution: '© OpenStreetMap © CARTO',
            maxZoom: 19
        }).addTo(map);

        var allPoints = [], routePoints = [];
        const delay = ms => new Promise(res => setTimeout(res, ms));
        const _geoCache = {};

        async function geocodeAddress(address) {
            if (!address?.trim()) return null;
            const key = address.trim().toLowerCase();
            if (_geoCache[key] !== undefined) return _geoCache[key];
            try {
                await delay(1200);
                const r = await fetch(`https://nominatim.openstreetmap.org/search?format=json&limit=1&accept-language=uk&q=${encodeURIComponent(address)}`, { headers: { Accept: 'application/json' } });
                const d = await r.json();
                if (d?.length) { const ll = [parseFloat(d[0].lat), parseFloat(d[0].lon)]; _geoCache[key] = ll; return ll; }
            } catch {}
            _geoCache[key] = null; return null;
        }

        function mkPin(type, label) {
            const configs = {
                start: { color: '#10b981', size: 38, emoji: '🟢' },
                dest:  { color: '#6366f1', size: 34, emoji: '📍' },
                end:   { color: '#ef4444', size: 38, emoji: '🏁' },
                hotel: { color: '#f59e0b', size: 30, emoji: '🏨' }
            };
            const c = configs[type];
            const html = `
                <div style="position:relative;width:${c.size}px;height:${c.size + 8}px;">
                    ${type === 'dest' ? `<div style="position:absolute;inset:0;border-radius:50%;background:${c.color};opacity:.2;animation:pulse-ring 2s ease-out infinite;"></div>` : ''}
                    <div style="
                        width:${c.size}px;height:${c.size}px;
                        background:${c.color};
                        border-radius:${type === 'hotel' ? '10px' : '50% 50% 50% 0'};
                        transform:${type === 'hotel' ? 'none' : 'rotate(-45deg)'};
                        border:3px solid white;
                        box-shadow:0 4px 16px rgba(0,0,0,.25);
                        display:flex;align-items:center;justify-content:center;
                        position:relative;z-index:1;
                    ">
                        <span style="transform:${type === 'hotel' ? 'none' : 'rotate(45deg)'};font-size:${c.size * .4}px;display:block;line-height:1;">${c.emoji}</span>
                    </div>
                </div>`;
            return L.divIcon({ html, className: '', iconSize: [c.size, c.size + 8], iconAnchor: [c.size/2, c.size + 8] });
        }

        function mkPopup(title, sub) {
            return `<div style="font-family:'Inter',sans-serif;min-width:140px;">
                <div style="font-weight:800;color:#111827;font-size:.92rem;">${title}</div>
                ${sub ? `<div style="font-size:.78rem;color:#64748b;margin-top:.2rem;">${sub}</div>` : ''}
            </div>`;
        }

        async function buildFullRoute() {
            const dep = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Trip.DepartureLocation ?? ""));
            const ret = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Trip.ReturnLocation ?? ""));

            let startLL = await geocodeAddress(dep);
            if (startLL) {
                L.marker(startLL, { icon: mkPin('start') }).addTo(map)
                    .bindPopup(mkPopup('Старт', dep));
                allPoints.push(startLL);
            }

            const dests = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Destinations.Select(d => new { name = $"{d.CityName}, {d.Country}", hasCoords = d.Latitude.HasValue && d.Longitude.HasValue, lat = d.Latitude, lng = d.Longitude })));
            for (const dest of dests) {
                const ll = dest.hasCoords ? [dest.lat, dest.lng] : await geocodeAddress(dest.name);
                if (ll) {
                    L.marker(ll, { icon: mkPin('dest') }).addTo(map)
                        .bindPopup(mkPopup(dest.name));
                    routePoints.push(ll); allPoints.push(ll);
                }
            }

            let endLL = await geocodeAddress(ret);
            if (endLL) {
                L.marker(endLL, { icon: mkPin('end') }).addTo(map)
                    .bindPopup(mkPopup('Фініш', ret));
                allPoints.push(endLL);
            }

            const path = [startLL, ...routePoints, endLL].filter(Boolean);
            if (path.length > 1) {
                // Shadow line
                L.polyline(path, { color: '#000', weight: 6, opacity: .08 }).addTo(map);
                // Main line
                L.polyline(path, { color: '#6366f1', weight: 3, opacity: .85, dashArray: '10,6' }).addTo(map);
            }

            const accs = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Accommodations.Select(a => new { name = a.Name, address = a.Address, hasCoords = a.Latitude.HasValue && a.Longitude.HasValue, lat = a.Latitude, lng = a.Longitude })));
            for (const acc of accs) {
                const ll = acc.hasCoords ? [acc.lat, acc.lng] : await geocodeAddress(acc.address || acc.name);
                if (ll) {
                    L.marker(ll, { icon: mkPin('hotel') }).addTo(map)
                        .bindPopup(mkPopup(acc.name, '🏨 Житло'));
                    allPoints.push(ll);
                }
            }

            if (allPoints.length) map.fitBounds(L.latLngBounds(allPoints), { padding: [40,40] });
        }
        buildFullRoute();

        // ══ AI PANEL ══════════════════════════════════════
        let _aiCache = {}, _currentTab = 'attractions';

        function openAiPanel(city, country) {
            document.getElementById('aiOverlay').style.display = 'block';
            document.getElementById('aiPanel').style.display = 'block';
            document.getElementById('aiPanelTitle').textContent = 'Рекомендації для ' + city;
            document.getElementById('aiTime').textContent = new Date().toLocaleTimeString('uk-UA',{hour:'2-digit',minute:'2-digit'});
            switchTab('attractions');
            loadAi(city, country);
        }

        function closeAiPanel() {
            document.getElementById('aiOverlay').style.display = 'none';
            document.getElementById('aiPanel').style.display = 'none';
        }

        function switchTab(tab) {
            _currentTab = tab;
            ['attractions','restaurants','tips'].forEach(t => {
                document.getElementById('tab-' + t).classList.toggle('active', t === tab);
                document.getElementById('content-' + t).style.display = t === tab ? 'block' : 'none';
            });
        }

        async function loadAi(city, country) {
            const key = city + '|' + country;
            if (_aiCache[key]) { renderAi(_aiCache[key]); return; }
            document.getElementById('aiLoading').style.display = 'block';
            document.getElementById('aiError').style.display = 'none';
            ['attractions','restaurants','tips'].forEach(t => document.getElementById('content-'+t).innerHTML='');
            try {
                const res = await fetch(`/TripDestinations/AiRecommendations?city=${encodeURIComponent(city)}&country=${encodeURIComponent(country)}`);
                if (!res.ok) throw new Error('HTTP '+res.status);
                const data = await res.json();
                if (!data||data.error) throw new Error(data?.error||'Порожня відповідь');
                _aiCache[key] = data;
                renderAi(data);
            } catch(e) {
                document.getElementById('aiLoading').style.display = 'none';
                document.getElementById('aiError').style.display = 'block';
                document.getElementById('aiError').textContent = '😔 ' + e.message;
            }
        }

        function mkCard(p, isPlace) {
            return `<div class="ai-place-card">
                <div style="display:flex;align-items:center;gap:.8rem;margin-bottom:.5rem;">
                    <span style="font-size:1.7rem;">${p.emoji||'📍'}</span>
                    <div>
                        <div style="font-family:'Montserrat',sans-serif;font-weight:800;color:#111827;font-size:.93rem;">${p.name}</div>
                        <div style="font-size:.72rem;color:#94a3b8;">${p.category}</div>
                    </div>
                </div>
                <div style="font-size:.84rem;color:#475569;line-height:1.55;margin-bottom:.65rem;">${p.description}</div>
                <div style="display:flex;gap:.4rem;flex-wrap:wrap;">
                    <span style="font-size:.7rem;font-weight:700;background:${isPlace?'#ede9fe':'#fef3c7'};color:${isPlace?'#7c3aed':'#d97706'};border-radius:50px;padding:.2rem .65rem;">${p.priceRange}</span>
                    <span style="font-size:.7rem;font-weight:700;background:#e0f2fe;color:#0369a1;border-radius:50px;padding:.2rem .65rem;">⏰ ${p.bestTime}</span>
                </div>
            </div>`;
        }

        function renderAi(data) {
            document.getElementById('aiLoading').style.display = 'none';
            document.getElementById('content-attractions').innerHTML = (data.attractions||[]).map(p=>mkCard(p,true)).join('') || '<div style="color:#94a3b8;font-style:italic;padding:1rem;">Немає даних</div>';
            document.getElementById('content-restaurants').innerHTML = (data.restaurants||[]).map(p=>mkCard(p,false)).join('') || '<div style="color:#94a3b8;font-style:italic;padding:1rem;">Немає даних</div>';
            document.getElementById('content-tips').innerHTML = (data.tips||[]).map(t=>`
                <div class="ai-place-card">
                    <div style="display:flex;align-items:flex-start;gap:.8rem;">
                        <span style="font-size:1.7rem;flex-shrink:0;">${t.emoji||'💡'}</span>
                        <div>
                            <div style="font-family:'Montserrat',sans-serif;font-weight:800;color:#111827;font-size:.93rem;margin-bottom:.3rem;">${t.title}</div>
                            <div style="font-size:.84rem;color:#475569;line-height:1.55;">${t.body}</div>
                        </div>
                    </div>
                </div>`).join('') || '<div style="color:#94a3b8;font-style:italic;padding:1rem;">Немає даних</div>';
        }
    </script>
}
