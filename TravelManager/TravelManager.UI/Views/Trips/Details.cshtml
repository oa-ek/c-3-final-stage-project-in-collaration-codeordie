                                           onfocus="this.style.borderColor='#6366f1'" onblur="this.style.borderColor='rgba(0,0,0,.1)'" />
                                </div>
                                <div style="margin-bottom:.85rem;">
                                    <select name="roleId" required
                                            style="width:100%;padding:.62rem 1rem;border:1px solid rgba(0,0,0,.1);border-radius:12px;font-size:.86rem;font-family:'Inter',sans-serif;background:rgba(255,255,255,.8);outline:none;box-sizing:border-box;appearance:none;cursor:pointer;transition:border-color .2s;"
                                            onfocus="this.style.borderColor='#6366f1'" onblur="this.style.borderColor='rgba(0,0,0,.1)'">
