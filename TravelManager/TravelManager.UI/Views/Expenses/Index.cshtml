@model IEnumerable<TravelManager.UI.Models.ViewModels.ExpenseListViewModel>

@{
    ViewData["Title"] = "Витрати";
    // Групуємо витрати за поїздками, щоб рахувати суму для кожної конкретної подорожі окремо
    var groupedExpenses = Model.GroupBy(x => x.TripTitle).ToList();
}

<style>
    @@keyframes fadeSlideUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes shimmer {
        0% {
            transform: translateX(-150%) skewX(-15deg);
        }

        100% {
            transform: translateX(150%) skewX(-15deg);
        }
    }

    .stagger-item {
        animation: fadeSlideUp 0.7s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        opacity: 0;
    }
</style>

<div class="relative w-full max-w-7xl mx-auto min-h-[75vh] py-10 z-10 px-4">

    <div class="absolute top-10 left-10 w-[30rem] h-[30rem] bg-amber-400/20 rounded-full blur-[120px] animate-pulse pointer-events-none -translate-x-1/2"></div>
    <div class="absolute bottom-10 right-10 w-[35rem] h-[35rem] bg-indigo-400/15 rounded-full blur-[140px] animate-pulse pointer-events-none translate-x-1/4" style="animation-delay: 2s;"></div>

    <!-- Заголовок та головні дії -->
    <div class="relative z-20 flex flex-col md:flex-row justify-between items-start md:items-center gap-6 mb-10 border-b border-slate-100 pb-6 stagger-item" style="animation-delay: 0.05s">
        <div>
            <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/60 backdrop-blur-md border border-white shadow-sm mb-4">
                <i class="bi bi-wallet2 text-amber-500 text-sm"></i>
                <span class="text-[10px] font-black text-slate-500 uppercase tracking-widest">Мій бюджет</span>
            </div>
            <h1 class="text-4xl md:text-5xl font-black text-slate-800 tracking-tighter leading-none mb-1">
                Витрати
            </h1>
            <p class="text-slate-500 font-medium text-sm mt-1">Перелік фінансових операцій за вашими подорожами</p>
        </div>

        <div class="flex flex-wrap items-center gap-3 w-full md:w-auto">
            <!-- КНОПКА: Перехід до сторінки боргів -->
            <a asp-controller="ExpenseSplits" asp-action="Index" class="inline-flex items-center justify-center px-6 py-4 font-black text-slate-700 bg-white hover:bg-slate-50 border border-slate-200 rounded-full shadow-sm hover:shadow transition-all text-xs uppercase tracking-widest gap-2">
                <i class="bi bi-person-dash-fill text-amber-500 text-base"></i> Борги та розподіли
            </a>

            @if (ViewBag.CurrentUserRole != "Viewer" && ViewBag.CurrentUserRole != "None")
            {
                <!-- КНОПКА: Додати витрату -->
                <a asp-action="Create" asp-route-returnUrl="@Context.Request.Path" class="group relative inline-flex items-center justify-center px-8 py-4 font-black text-white transition-all duration-300 bg-slate-900 rounded-full shadow-lg hover:shadow-xl hover:-translate-y-0.5 uppercase tracking-widest text-xs overflow-hidden active:scale-95">
                    <span class="absolute inset-0 w-[200%] bg-gradient-to-r from-transparent via-white/20 to-transparent -translate-x-[150%] group-hover:animate-[shimmer_1.5s_infinite]"></span>
                    <span class="relative flex items-center gap-2">
                        Додати витрату <i class="bi bi-plus-circle-fill text-sm"></i>
                    </span>
                </a>
            }
        </div>
    </div>

    <!-- Вивід витрат, згрупованих за кожною конкретною подорожжю -->
    <div class="relative z-20 space-y-12">
        @if (!Model.Any())
        {
            <div class="bg-white/60 backdrop-blur-md border border-dashed border-slate-200 rounded-[2.5rem] p-12 text-center shadow-sm stagger-item" style="animation-delay: 0.15s">
                <div class="w-16 h-16 bg-amber-50 text-amber-500 rounded-full flex items-center justify-center mx-auto mb-4 border border-amber-100 shadow-sm">
                    <i class="bi bi-wallet2 text-3xl"></i>
                </div>
                <h3 class="text-xl font-black text-slate-700 tracking-tight">Жодної витрати не знайдено</h3>
                <p class="text-slate-400 font-medium text-sm mt-1">Додайте вашу першу витрату для початку фінансового обліку.</p>
            </div>
        }
        else
        {
            var animDelay = 0.15m;
            foreach (var tripGroup in groupedExpenses)
            {
                var groupSum = tripGroup.Sum(x => x.Amount);
                var groupCurrency = tripGroup.FirstOrDefault()?.Currency ?? "UAH";
                var tripId = tripGroup.FirstOrDefault()?.TripId ?? 0;

                <div class="space-y-4 stagger-item" style="animation-delay: @(animDelay.ToString(System.Globalization.CultureInfo.InvariantCulture))s;">

                    <!-- Шапка групи подорожі із підрахованою сумою тільки для неї та посиланням на Ексель звіт -->
                    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center px-6 py-4 bg-slate-100/60 border border-slate-200/50 rounded-2xl gap-3">
                        <div class="flex items-center gap-2">
                            <i class="bi bi-airplane-engines text-indigo-500"></i>
                            <h3 class="font-black text-slate-800 text-lg">@tripGroup.Key</h3>
                        </div>

                        <div class="flex flex-wrap items-center gap-3 w-full sm:w-auto">
                            <a asp-controller="Export" asp-action="Trip" asp-route-tripId="@tripId" class="inline-flex items-center gap-1.5 text-xs font-bold text-emerald-700 hover:text-emerald-950 transition-colors bg-emerald-50 border border-emerald-200/60 px-4 py-1.5 rounded-full shadow-inner">
                                Звіт Excel подорожі
                            </a>

                            <div class="text-sm font-bold text-slate-600 bg-white px-4 py-1.5 rounded-full border border-slate-200/60 shadow-inner">
                                Загалом на подорож: <span class="text-emerald-600 font-black">@groupSum @groupCurrency</span>
                            </div>
                        </div>
                    </div>

                    <!-- Список витрат цієї подорожі -->
                    <div class="grid grid-cols-1 gap-4">
                        @foreach (var item in tripGroup)
                        {
                            <div class="group bg-white/70 backdrop-blur-2xl border border-white/80 rounded-3xl p-5 md:p-6 shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col md:flex-row md:items-center justify-between gap-4">
                                <div class="flex items-center gap-4 flex-1 min-w-0">
                                    <div class="w-12 h-12 rounded-2xl bg-amber-50 text-amber-500 flex items-center justify-center text-xl shrink-0 group-hover:scale-105 transition-transform duration-300 border border-amber-100">
                                        @if (item.CategoryName.Contains("Food") || item.CategoryName.Contains("Їжа"))
                                        {
                                            <i class="bi bi-egg-fried"></i>
                                        }
                                        else if (item.CategoryName.Contains("Transport") || item.CategoryName.Contains("Транспорт"))
                                        {
                                            <i class="bi bi-car-front-fill"></i>
                                        }
                                        else if (item.CategoryName.Contains("Accommodation") || item.CategoryName.Contains("Житло"))
                                        {
                                            <i class="bi bi-house-door-fill"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-credit-card-2-back-fill"></i>
                                        }
                                    </div>
                                    <div class="min-w-0 flex-1">
                                        <div class="flex items-center gap-2 flex-wrap mb-1">
                                            <span class="text-[10px] font-black text-indigo-600 uppercase tracking-widest bg-indigo-50 border border-indigo-100/50 px-2.5 py-0.5 rounded-full">
                                                @item.CategoryName
                                            </span>
                                            <span class="text-slate-400 text-xs font-bold">@item.Date.ToShortDateString()</span>
                                        </div>
                                        <h4 class="font-black text-slate-800 text-lg tracking-tight truncate">@item.Description</h4>

                                        <!-- ПОВЕРНУТО: Посилання на чек витрати (Receipt Link) -->
                                        @if (!string.IsNullOrEmpty(item.ReceiptImageUrl))
                                        {
                                            <div class="mt-2">
                                                <a href="@item.ReceiptImageUrl" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-xs font-bold text-indigo-600 hover:text-indigo-800 transition-colors bg-indigo-50/50 hover:bg-indigo-50 border border-indigo-100/30 px-3 py-1.5 rounded-xl">
                                                    <i class="bi bi-file-earmark-image"></i> Переглянути чек <i class="bi bi-box-arrow-up-right text-[10px]"></i>
                                                </a>
                                            </div>
                                        }
                                    </div>
                                </div>

                                <div class="flex items-center justify-between md:justify-end gap-6 shrink-0 border-t border-slate-100 pt-3 md:pt-0 md:border-0">
                                    <div class="text-left md:text-right">
                                        <span class="block text-xs font-black uppercase tracking-widest text-slate-400">Сума</span>
                                        <span class="text-2xl font-black text-slate-800">
                                            @item.Amount <span class="text-emerald-500">@item.Currency</span>
                                        </span>
                                    </div>

                                    @if (ViewBag.CurrentUserRole != "Viewer" && ViewBag.CurrentUserRole != "None")
                                    {
                                        <div class="flex items-center gap-2 opacity-100 md:opacity-0 md:group-hover:opacity-100 transition-opacity duration-300">
                                            <a asp-action="Edit" asp-route-id="@item.Id" asp-route-returnUrl="@Context.Request.Path" class="w-11 h-11 rounded-xl bg-white border border-slate-100 flex items-center justify-center text-slate-400 hover:text-amber-600 hover:bg-amber-50 hover:border-amber-200 transition-all shadow-sm hover:scale-105" title="Редагувати">
                                                <i class="bi bi-pencil-fill text-sm"></i>
                                            </a>
                                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="m-0" onsubmit="return confirm('Ви впевнені, що хочете видалити цю транзакцію?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="w-11 h-11 rounded-xl bg-white border border-slate-100 flex items-center justify-center text-slate-400 hover:text-rose-600 hover:bg-rose-50 hover:border-rose-200 transition-all shadow-sm hover:scale-105" title="Видалити">
                                                    <i class="bi bi-trash3-fill text-sm"></i>
                                                </button>
                                            </form>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>

                </div>
                animDelay += 0.1m;
            }
        }
    </div>
</div>