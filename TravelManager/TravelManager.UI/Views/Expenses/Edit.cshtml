@model TravelManager.UI.Models.ViewModels.ExpenseFormViewModel

@{
    ViewData["Title"] = "Редагувати витрату";
    var returnUrl = ViewBag.ReturnUrl as string;
}

<style>
    /* Анімація появи */
    @@keyframes fadeSlideUp {
        0% {
            opacity: 0;
            transform: translateY(20px);
        }

        100% {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .stagger-item {
        animation: fadeSlideUp 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    /* Дуже компактний скролбар для учасників */
    .custom-scrollbar::-webkit-scrollbar {
        width: 4px;
    }

    .custom-scrollbar::-webkit-scrollbar-track {
        background: transparent;
    }

    .custom-scrollbar::-webkit-scrollbar-thumb {
        background: rgba(251, 191, 36, 0.4);
        border-radius: 4px;
    }

        .custom-scrollbar::-webkit-scrollbar-thumb:hover {
            background: rgba(245, 158, 11, 0.7);
        }

    input[type="date"]::-webkit-calendar-picker-indicator {
        background-color: white;
        padding: 4px;
        cursor: pointer;
        border-radius: 6px;
    }
</style>

<!-- Головний адаптивний контейнер, адаптований під 100% висоти екрану без скролу -->
<div class="relative w-full max-w-6xl mx-auto py-4 z-10 px-4 flex flex-col justify-start">

    <!-- Компактна шапка -->
    <div class="text-center mb-4 stagger-item">
        <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-white shadow-sm border border-slate-100 mb-2">
            <i class="bi bi-pencil-square text-xl text-amber-500"></i>
        </div>
        <h1 class="text-3xl font-black text-slate-800 tracking-tight">Редагування витрати 💸</h1>
        <p class="text-slate-400 text-xs font-semibold">Внесіть необхідні зміни до витрати</p>
    </div>

    <!-- Обгортка форми БЕЗ overflow-hidden, щоб випадаючі списки не обрізалися -->
    <div class="relative bg-white/70 backdrop-blur-2xl border border-white/80 rounded-[2rem] p-5 shadow-lg stagger-item">

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="text-rose-600 mb-4 p-3 bg-rose-100/80 backdrop-blur-md rounded-xl text-xs font-bold border border-rose-200 flex items-center gap-2">
                <i class="bi bi-exclamation-triangle-fill"></i> @TempData["ErrorMessage"]
            </div>
        }

        <form asp-action="Edit" method="post" id="expenseForm">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-rose-600 mb-4 text-xs font-bold text-center bg-rose-100/50 py-2 rounded-xl border border-rose-200/50"></div>
            <input type="hidden" name="returnUrl" value="@returnUrl" />

            <!-- Двоколонкова компактна структура -->
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 items-start">

                <!-- ЛІВА КОЛОНКА: Основні поля введення -->
                <div class="lg:col-span-6 space-y-4">

                    <!-- Поїздка & Категорія в один рядок -->
                    <div class="grid grid-cols-2 gap-4">
                        <div class="flex flex-col relative z-[100]">
                            <label class="text-[10px] font-black uppercase tracking-widest text-slate-400 mb-1 ml-2 flex items-center gap-1">
                                <i class="bi bi-airplane-engines"></i> Поїздка
                            </label>
                            <select asp-for="TripId" asp-items="Model.TripList" class="sr-only real-select" id="TripId"></select>
                            <div class="relative custom-dropdown w-full">
                                <button type="button" class="w-full bg-white border border-slate-200 rounded-xl py-2 px-3 text-sm font-bold text-slate-700 outline-none flex justify-between items-center" onclick="toggleDropdown(this)">
                                    <span class="selected-text text-slate-800 truncate">
                                        @(Model.TripList?.FirstOrDefault(x => x.Selected)?.Text ?? "-- Оберіть поїздку --")
                                    </span>
                                    <i class="bi bi-chevron-down text-slate-400 text-xs"></i>
                                </button>
                                <div class="dropdown-menu absolute left-0 right-0 mt-1 bg-white border border-slate-200 rounded-xl shadow-lg opacity-0 invisible translate-y-1 transition-all duration-200 overflow-hidden z-[1000]">
                                    <ul class="max-h-40 overflow-y-auto py-1 custom-scrollbar">
                                        @if (Model.TripList != null)
                                        {
                                            foreach (var item in Model.TripList)
                                            {
                                                <li class="px-4 py-2 text-slate-700 text-xs font-bold cursor-pointer hover:bg-indigo-50 hover:text-indigo-600 transition-colors" onclick="selectItem(this, '@item.Value')">@item.Text</li>
                                            }
                                        }
                                    </ul>
                                </div>
                            </div>
                        </div>

                        <div class="flex flex-col relative z-[90]">
                            <label class="text-[10px] font-black uppercase tracking-widest text-slate-400 mb-1 ml-2 flex items-center gap-1">
                                <i class="bi bi-tags-fill"></i> Категорія
                            </label>
                            <select asp-for="CategoryId" asp-items="Model.CategoryList" class="sr-only real-select"></select>
                            <div class="relative custom-dropdown w-full">
                                <button type="button" class="w-full bg-white border border-slate-200 rounded-xl py-2 px-3 text-sm font-bold text-slate-700 outline-none flex justify-between items-center" onclick="toggleDropdown(this)">
                                    <span class="selected-text text-slate-800 truncate">
                                        @(Model.CategoryList?.FirstOrDefault(x => x.Selected)?.Text ?? "-- Оберіть --")
                                    </span>
                                    <i class="bi bi-chevron-down text-slate-400 text-xs"></i>
                                </button>
                                <div class="dropdown-menu absolute left-0 right-0 mt-1 bg-white border border-slate-200 rounded-xl shadow-lg opacity-0 invisible translate-y-1 transition-all duration-200 overflow-hidden z-[1000]">
                                    <ul class="max-h-40 overflow-y-auto py-1 custom-scrollbar">
                                        @if (Model.CategoryList != null)
                                        {
                                            foreach (var item in Model.CategoryList)
                                            {
                                                <li class="px-4 py-2 text-slate-700 text-xs font-bold cursor-pointer hover:bg-fuchsia-50 hover:text-fuchsia-600 transition-colors" onclick="selectItem(this, '@item.Value')">@item.Text</li>
                                            }
                                        }
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Що купили -->
                    <div class="flex flex-col relative">
                        <label asp-for="Description" class="text-[10px] font-black uppercase tracking-widest text-slate-400 mb-1 ml-2 flex items-center gap-1">
                            <i class="bi bi-chat-square-quote-fill"></i> Що купили?
                        </label>
                        <input asp-for="Description" placeholder="Кава з круасаном на Монмартрі 🥐☕" class="w-full bg-white border border-slate-200 rounded-xl py-2 px-4 text-sm font-bold text-slate-800 outline-none focus:border-amber-400 hover:bg-slate-50 transition-all" />
                        <span asp-validation-for="Description" class="text-[10px] text-rose-500 font-bold block"></span>
                    </div>

                    <!-- Сума, Валюта та Дата -->
                    <div class="grid grid-cols-12 gap-3 items-end">
                        <div class="col-span-5 flex flex-col relative">
                            <label asp-for="TotalAmount" class="text-[10px] font-black uppercase tracking-widest text-slate-400 mb-1 ml-2 flex items-center gap-1">
                                <i class="bi bi-cash-coin"></i> Сума
                            </label>
                            <input asp-for="TotalAmount" id="TotalAmountInput" type="number" step="0.01" placeholder="0.00" class="w-full bg-white border border-slate-200 rounded-xl py-2 px-3 text-lg font-black text-slate-800 outline-none focus:border-emerald-400 hover:bg-slate-50 transition-all" />
                            <span asp-validation-for="TotalAmount" class="text-[10px] text-rose-500 font-bold block"></span>
                        </div>

                        <div class="col-span-4 flex flex-col relative z-[80]">
                            <label class="text-[10px] font-black uppercase tracking-widest text-slate-400 mb-1 ml-2">
                                Валюта
                            </label>
                            <select asp-for="Currency" asp-items="Model.CurrencyList" class="sr-only real-select" id="Currency"></select>
                            <div class="relative custom-dropdown w-full">
                                <button type="button" class="w-full bg-white border border-slate-200 rounded-xl py-2.5 px-2.5 text-xs font-bold text-slate-700 outline-none flex justify-between items-center" onclick="toggleDropdown(this)">
                                    <span class="selected-text text-slate-800 truncate">
                                        @(Model.CurrencyList?.FirstOrDefault(x => x.Selected)?.Text ?? "UAH")
                                    </span>
                                    <i class="bi bi-chevron-down text-slate-400 text-[10px]"></i>
                                </button>
                                <div class="dropdown-menu absolute left-0 right-0 mt-1 bg-white border border-slate-200 rounded-xl shadow-lg opacity-0 invisible translate-y-1 transition-all duration-200 overflow-hidden z-[5000]">
                                    <ul class="max-h-40 overflow-y-auto py-1 custom-scrollbar">
                                        @if (Model.CurrencyList != null)
                                        {
                                            foreach (var item in Model.CurrencyList)
                                            {
                                                <li class="px-3 py-2 text-slate-700 text-xs font-bold cursor-pointer hover:bg-cyan-50 hover:text-cyan-600 transition-colors" onclick="selectItem(this, '@item.Value')">@item.Text</li>
                                            }
                                        }
                                    </ul>
                                </div>
                            </div>
                        </div>

                        <div class="col-span-3 flex flex-col relative">
                            <label asp-for="Date" class="text-[10px] font-black uppercase tracking-widest text-slate-400 mb-1 ml-2">Дата</label>
                            <input asp-for="Date" type="date" class="w-full bg-white border border-slate-200 rounded-xl py-2 px-2 text-xs font-bold text-slate-700 outline-none hover:bg-slate-50 transition-all cursor-pointer" />
                        </div>
                    </div>

                    <!-- Хто заплатив -->
                    <div class="flex flex-col relative z-[70]">
                        <label class="text-[10px] font-black uppercase tracking-widest text-slate-400 mb-1 ml-2 flex items-center gap-1">
                            <i class="bi bi-person-fill-check"></i> Хто заплатив?
                        </label>
                        <select asp-for="PayerId" asp-items="Model.PayerList" class="sr-only real-select" id="PayerIdSelect"></select>
                        <div class="relative custom-dropdown w-full">
                            <button type="button" class="w-full bg-white border border-slate-200 rounded-xl py-2 px-3 text-sm font-bold text-slate-700 outline-none flex justify-between items-center" onclick="toggleDropdown(this)">
                                <span class="selected-text text-slate-800">
                                    @(Model.PayerList?.FirstOrDefault(x => x.Selected)?.Text ?? "-- Оберіть платника --")
                                </span>
                                <i class="bi bi-chevron-down text-slate-400 text-xs"></i>
                            </button>
                            <div class="dropdown-menu absolute left-0 right-0 mt-1 bg-white border border-slate-200 rounded-xl shadow-lg opacity-0 invisible translate-y-1 transition-all duration-200 overflow-hidden z-[1000]">
                                <ul class="max-h-40 overflow-y-auto py-1 custom-scrollbar">
                                    <li class="px-4 py-2 text-slate-400 text-xs font-bold cursor-pointer hover:bg-slate-100 transition-colors" onclick="selectItem(this, '')">-- Оберіть платника --</li>
                                    @if (Model.PayerList != null)
                                    {
                                        foreach (var item in Model.PayerList)
                                        {
                                            <li class="px-4 py-2 text-slate-700 font-bold cursor-pointer hover:bg-emerald-50 hover:text-emerald-600 transition-colors flex items-center gap-2" id="payer-option-@item.Value" onclick="selectItem(this, '@item.Value')">
                                                <i class="bi bi-person-circle text-emerald-300"></i> @item.Text
                                            </li>
                                        }
                                    }
                                </ul>
                            </div>
                        </div>
                        <span asp-validation-for="PayerId" class="text-[10px] text-rose-500 font-bold block"></span>
                    </div>

                    <!-- Чек -->
                    <div class="flex flex-col relative">
                        <label asp-for="ReceiptImageUrl" class="text-[10px] font-black uppercase tracking-widest text-slate-400 mb-1 ml-2 flex items-center gap-1">
                            <i class="bi bi-link-45deg"></i> Чек (Опціонально)
                        </label>
                        <input asp-for="ReceiptImageUrl" placeholder="https://..." class="w-full bg-white border border-slate-200 rounded-xl py-2 px-3 text-xs font-bold text-slate-800 outline-none focus:border-blue-400 hover:bg-slate-50 transition-all" />
                        <span asp-validation-for="ReceiptImageUrl" class="text-[10px] text-rose-500 font-bold block"></span>
                    </div>

                </div>

                <!-- ПРАВА КОЛОНКА: Роподіл боргів та прив'язки -->
                <div class="lg:col-span-6 space-y-4">

                    <!-- Розподіл часток -->
                    <div class="border border-slate-200/80 bg-slate-50/50 rounded-2xl p-4">
                        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-3">
                            <h4 class="text-sm font-black text-slate-800 m-0 flex items-center gap-1">
                                <i class="bi bi-people-fill text-indigo-500"></i> Борги учасників
                            </h4>
                            <div class="flex items-center gap-1.5">
                                <button type="button" onclick="splitOnlyToPayer()" class="px-2.5 py-1.5 bg-amber-100 text-amber-700 hover:bg-amber-200 font-bold text-[10px] rounded-lg transition-all flex items-center gap-1">
                                    <i class="bi bi-person-check-fill"></i> Оплатив сам
                                </button>
                                <button type="button" id="btnSplitEqually" class="px-2.5 py-1.5 bg-indigo-100 text-indigo-700 hover:bg-indigo-200 font-bold text-[10px] rounded-lg transition-all flex items-center gap-1">
                                    <i class="bi bi-calculator"></i> Порівну
                                </button>
                            </div>
                        </div>

                        <div class="max-h-[160px] overflow-y-auto pr-1 space-y-2 custom-scrollbar" id="splitsContainer">
                            @for (int i = 0; i < Model.Splits.Count; i++)
                            {
                                <div class="flex items-center justify-between p-2.5 bg-white border border-slate-100 rounded-xl shadow-xs">
                                    <input type="hidden" asp-for="Splits[i].UserId" class="split-user-hidden" data-index="@i" />
                                    <input type="hidden" asp-for="Splits[i].UserName" />
                                    <input type="hidden" asp-for="Splits[i].OwedAmount" class="split-amount-hidden" data-index="@i" />

                                    <div class="font-bold text-slate-700 text-xs flex items-center gap-2">
                                        <div class="w-6 h-6 bg-indigo-50 text-indigo-500 rounded-full flex items-center justify-center text-xs">
                                            <i class="bi bi-person"></i>
                                        </div>
                                        @Model.Splits[i].UserName
                                    </div>

                                    <div class="w-1/3 relative">
                                        <input type="number" step="0.01" min="0" data-index="@i" class="split-ui-input w-full bg-white border border-slate-200 text-slate-800 text-xs font-bold rounded-lg focus:border-emerald-400 block px-2.5 py-1.5 pr-8 transition-all outline-none text-right" value="@Model.Splits[i].OwedAmount" />
                                        <div class="absolute inset-y-0 right-0 flex items-center pr-2 pointer-events-none">
                                            <span class="currency-addon text-[9px] font-black text-slate-400">UAH</span>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- ОНОВЛЕНИЙ БЛОК ПРИВ'ЯЗОК ДО ПОЇЗДКИ (Красивий дизайн) -->
                    <div class="p-4 bg-gradient-to-br from-slate-50 to-white border border-slate-200/60 rounded-2xl shadow-sm relative z-[60]">
                        <h4 class="text-xs font-black text-slate-700 mb-3 flex items-center gap-1.5">
                            <i class="bi bi-paperclip text-slate-400"></i> Деталі прив'язки
                            <span class="text-[9px] font-medium text-slate-400 ml-auto uppercase tracking-widest">(Опціонально)</span>
                        </h4>

                        <div class="grid grid-cols-1 gap-3">
                            <div class="flex items-center gap-3">
                                <div class="w-8 h-8 rounded-lg bg-blue-50 text-blue-500 flex items-center justify-center shrink-0">
                                    <i class="bi bi-car-front-fill"></i>
                                </div>
                                <div class="flex-1">
                                    <select asp-for="TransitId" asp-items="Model.TransitList" class="w-full bg-white border border-slate-200 hover:border-blue-300 rounded-lg py-1.5 px-3 text-xs font-medium text-slate-700 outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all cursor-pointer">
                                        <option value="">-- Обрати транспорт --</option>
                                    </select>
                                </div>
                            </div>

                            <div class="flex items-center gap-3">
                                <div class="w-8 h-8 rounded-lg bg-fuchsia-50 text-fuchsia-500 flex items-center justify-center shrink-0">
                                    <i class="bi bi-house-door-fill"></i>
                                </div>
                                <div class="flex-1">
                                    <select asp-for="AccommodationId" asp-items="Model.AccommodationList" class="w-full bg-white border border-slate-200 hover:border-fuchsia-300 rounded-lg py-1.5 px-3 text-xs font-medium text-slate-700 outline-none focus:ring-2 focus:ring-fuchsia-500/20 focus:border-fuchsia-500 transition-all cursor-pointer">
                                        <option value="">-- Обрати житло --</option>
                                    </select>
                                </div>
                            </div>

                            <div class="flex items-center gap-3">
                                <div class="w-8 h-8 rounded-lg bg-amber-50 text-amber-500 flex items-center justify-center shrink-0">
                                    <i class="bi bi-ticket-perforated-fill"></i>
                                </div>
                                <div class="flex-1">
                                    <select asp-for="TripActivityId" asp-items="Model.ActivityList" class="w-full bg-white border border-slate-200 hover:border-amber-300 rounded-lg py-1.5 px-3 text-xs font-medium text-slate-700 outline-none focus:ring-2 focus:ring-amber-500/20 focus:border-amber-500 transition-all cursor-pointer">
                                        <option value="">-- Обрати активність --</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>

            <!-- Компактні кнопки дій внизу форми -->
            <div class="mt-4 flex flex-row items-center justify-end gap-3 pt-3 border-t border-slate-100 relative z-10">
                @if (!string.IsNullOrEmpty(returnUrl))
                {
                    <a href="@returnUrl" class="px-5 py-2.5 rounded-full font-black text-slate-400 hover:text-slate-600 text-xs uppercase tracking-widest text-center transition-colors">
                        Скасувати
                    </a>
                }
                else
                {
                    <button type="button" onclick="history.back()" class="px-5 py-2.5 rounded-full font-black text-slate-400 hover:text-slate-600 text-xs uppercase tracking-widest text-center transition-colors">
                        Скасувати
                    </button>
                }

                <button type="submit" class="group relative inline-flex items-center justify-center px-8 py-3 font-black text-white transition-all duration-300 bg-slate-900 rounded-full shadow-md hover:shadow-lg uppercase tracking-widest text-xs overflow-hidden active:scale-95">
                    <span class="absolute inset-0 w-[200%] bg-gradient-to-r from-transparent via-white/30 to-transparent -translate-x-[150%] group-hover:animate-[shimmer_1.5s_infinite]"></span>
                    <span class="relative flex items-center gap-1.5">
                        Зберегти зміни <i class="bi bi-save2-fill text-xs"></i>
                    </span>
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // ЛОГІКА КАСТОМНИХ СЕЛЕКТІВ
            window.toggleDropdown = function(button) {
                document.querySelectorAll('.dropdown-menu').forEach(menu => {
                    if (menu !== button.nextElementSibling) {
                        menu.classList.add('opacity-0', 'invisible', 'translate-y-1');
                        menu.previousElementSibling.querySelector('.bi-chevron-down').classList.remove('rotate-180');
                        menu.parentElement.classList.remove('z-[1000]');
                    }
                });

                const menu = button.nextElementSibling;
                const icon = button.querySelector('.bi-chevron-down');
                const container = button.parentElement;
                const isOpening = menu.classList.contains('opacity-0');

                if (isOpening) {
                    menu.classList.remove('opacity-0', 'invisible', 'translate-y-1');
                    icon.classList.add('rotate-180');
                    container.classList.add('z-[1000]');
                } else {
                    menu.classList.add('opacity-0', 'invisible', 'translate-y-1');
                    icon.classList.remove('rotate-180');
                    setTimeout(() => container.classList.remove('z-[1000]'), 200);
                }
            };

            window.selectItem = function(liElement, value) {
                const text = liElement.innerText.trim();
                const container = liElement.closest('.custom-dropdown');
                const triggerBtn = container.querySelector('.selected-text');
                const realSelect = container.parentElement.querySelector('.real-select');
                const menu = container.querySelector('.dropdown-menu');
                const icon = container.querySelector('.bi-chevron-down');

                triggerBtn.innerText = text;
                triggerBtn.classList.remove('text-slate-400');
                triggerBtn.classList.add('text-slate-800');
                realSelect.value = value;

                // Перезавантаження при зміні поїздки
                if (realSelect.id === 'TripId') {
                    const rUrl = encodeURIComponent(document.getElementsByName('returnUrl')[0]?.value || '');
                    window.location.href = '/Expenses/Edit/@Model.Id?tripId=' + value + '&returnUrl=' + rUrl;
                    return;
                }

                realSelect.dispatchEvent(new Event('change'));
                if (typeof $(realSelect).valid === "function") $(realSelect).valid();

                menu.classList.add('opacity-0', 'invisible', 'translate-y-1');
                icon.classList.remove('rotate-180');
                setTimeout(() => container.classList.remove('z-[1000]'), 200);
            };

            document.addEventListener('click', (e) => {
                if (!e.target.closest('.custom-dropdown')) {
                    document.querySelectorAll('.dropdown-menu').forEach(menu => {
                        menu.classList.add('opacity-0', 'invisible', 'translate-y-1');
                        menu.parentElement.classList.remove('z-[1000]');
                    });
                    document.querySelectorAll('.bi-chevron-down').forEach(icon => {
                        icon.classList.remove('rotate-180');
                    });
                }
            });

            // ЛОГІКА ДЛЯ БОРГІВ І ВАЛЮТИ
            const totalInput = document.getElementById('TotalAmountInput');
            const currencySelect = document.getElementById('Currency');
            const splitUIInputs = document.querySelectorAll('.split-ui-input');
            const currencyAddons = document.querySelectorAll('.currency-addon');
            const btnSplitEqually = document.getElementById('btnSplitEqually');

            if (currencySelect) {
                currencySelect.addEventListener('change', function() {
                    const selectedText = this.options[this.selectedIndex].text.split(' ')[0];
                    currencyAddons.forEach(addon => addon.textContent = selectedText);
                });
            }

            if (btnSplitEqually) {
                btnSplitEqually.addEventListener('click', function() {
                    const total = parseFloat(totalInput.value);
                    if (isNaN(total) || total <= 0) {
                        alert("Спочатку введіть загальну суму!");
                        return;
                    }

                    const count = splitUIInputs.length;
                    if (count === 0) return;

                    const splitAmount = Math.floor((total / count) * 100) / 100;
                    let remainder = total - (splitAmount * count);

                    splitUIInputs.forEach((input, index) => {
                        let amount = splitAmount;
                        if (index === 0) {
                            amount += remainder;
                        }
                        input.value = amount.toFixed(2);
                    });
                });
            }

            // ШВИДКИЙ ЗАПИС НА ПЛАТНИКА
            window.splitOnlyToPayer = function() {
                const total = parseFloat(totalInput?.value || 0);
                if (isNaN(total) || total <= 0) {
                    alert("Спочатку введіть загальну суму!");
                    return;
                }

                const payerId = document.getElementById('PayerIdSelect')?.value;
                if (!payerId) {
                    alert("Будь ласка, оберіть того, хто заплатив!");
                    return;
                }

                splitUIInputs.forEach(uiInput => {
                    const idx = uiInput.dataset.index;
                    const userId = document.querySelector(`.split-user-hidden[data-index="${idx}"]`)?.value;

                    if (userId === payerId) {
                        uiInput.value = total.toFixed(2);
                    } else {
                        uiInput.value = '0.00';
                    }
                });
            };

            // Синхронізація перед відправкою
            document.getElementById('expenseForm').addEventListener('submit', function (e) {
                splitUIInputs.forEach(uiInput => {
                    const idx = uiInput.dataset.index;
                    const hiddenAmount = document.querySelector(`.split-amount-hidden[data-index="${idx}"]`);
                    if (hiddenAmount) {
                        hiddenAmount.value = uiInput.value;
                    }
                });
            });
        });
    </script>
}