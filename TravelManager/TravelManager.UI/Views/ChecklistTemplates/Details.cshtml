@model TravelManager.UI.Models.ViewModels.TemplateEditViewModel

@{
    ViewData["Title"] = "Перегляд шаблону";
}

<div class="relative w-full max-w-2xl mx-auto min-h-[85vh] py-10 z-10 px-4">
    <div class="mb-6">
        <a asp-action="Index" class="inline-flex items-center gap-2 text-xs font-black uppercase tracking-widest text-slate-400 hover:text-slate-600 transition-colors">
            <i class="bi bi-arrow-left"></i> Назад до шаблонів
        </a>
    </div>

    <div class="bg-white border border-slate-100 rounded-3xl p-6 md:p-8 shadow-xl">
        <div class="border-b border-slate-100 pb-4 mb-6">
            <span class="text-[10px] font-black uppercase tracking-widest text-indigo-500 bg-indigo-50 px-2.5 py-1 rounded-full border border-indigo-100">
                Вміст шаблону
            </span>
            <h1 class="text-3xl font-black tracking-tight text-slate-800 mt-2">
                @Model.Title
            </h1>
        </div>

        <div class="space-y-2">
            @if (!Model.Items.Any())
            {
                <p class="text-center text-slate-400 py-6 font-bold">У цьому шаблоні ще немає жодної речі.</p>
            }
            else
            {
                @foreach (var item in Model.Items)
                {
                    <div class="flex items-center gap-3 p-4 bg-slate-50 border border-slate-100 rounded-2xl">
                        <i class="bi bi-check2-circle text-emerald-500 text-lg"></i>
                        <span class="font-bold text-slate-700">@item.Content</span>
                    </div>
                }
            }
        </div>
    </div>
</div>