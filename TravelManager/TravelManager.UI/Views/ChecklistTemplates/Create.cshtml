@model TravelManager.UI.Models.ViewModels.TemplateCreateViewModel

@{
    ViewData["Title"] = "Створити шаблон з нуля";
}

<div class="relative w-full max-w-xl mx-auto min-h-[85vh] py-10 z-10 px-4">
    <div class="mb-6">
        <a asp-action="Index" class="inline-flex items-center gap-2 text-xs font-black uppercase tracking-widest text-slate-400 hover:text-slate-600 transition-colors">
            <i class="bi bi-arrow-left"></i> Назад
        </a>
    </div>

    <div class="bg-white border border-slate-100 rounded-[2rem] p-6 md:p-8 shadow-xl">
        <div class="text-center mb-6">
            <h1 class="text-3xl font-black text-slate-800 tracking-tight">✨ Створення шаблону</h1>
            <p class="text-sm font-medium text-slate-400 mt-1">Опишіть ваш новий базовий набір речей</p>
        </div>

        <form asp-action="Create" method="post">
            <div class="mb-5">
                <label asp-for="Title" class="block text-xs font-black uppercase tracking-widest text-slate-400 mb-2">Назва шаблону</label>
                <input asp-for="Title" class="w-full bg-slate-50 border border-slate-200 rounded-2xl px-4 py-3 text-slate-800 font-bold focus:outline-none focus:border-indigo-500 focus:bg-white transition-all shadow-inner" placeholder="напр: У відпустку з дитиною, На риболовлю..." required />
                <span asp-validation-for="Title" class="text-rose-500 text-xs font-bold mt-1 block"></span>
            </div>

            <div class="mb-8">
                <label asp-for="Description" class="block text-xs font-black uppercase tracking-widest text-slate-400 mb-2">Короткий опис шаблону</label>
                <input asp-for="Description" class="w-full bg-slate-50 border border-slate-200 rounded-2xl px-4 py-3 text-slate-800 font-medium focus:outline-none focus:border-indigo-500 focus:bg-white transition-all shadow-inner" placeholder="напр: Обов'язкові іграшки та засоби гігієни" />
                <span asp-validation-for="Description" class="text-rose-500 text-xs font-bold mt-1 block"></span>
            </div>

            <div class="flex items-center justify-end gap-3 border-t border-slate-100 pt-6">
                <a asp-action="Index" class="px-6 py-3 rounded-full font-black text-slate-500 hover:bg-slate-50 transition-all text-xs uppercase tracking-widest">
                    Скасувати
                </a>
                <button type="submit" class="px-6 py-3 rounded-full font-black text-white bg-indigo-600 hover:bg-indigo-700 hover:shadow-lg transition-all text-xs uppercase tracking-widest">
                    Створити & Додати речі <i class="bi bi-arrow-right ml-1"></i>
                </button>
            </div>
        </form>
    </div>
</div>