@model TravelManager.UI.Models.ViewModels.TemplateEditViewModel

@{
    ViewData["Title"] = "Редагування шаблону";
}

<div class="relative w-full max-w-3xl mx-auto min-h-[85vh] py-10 z-10 px-4">
    <div class="mb-8">
        <a asp-action="Index" class="inline-flex items-center gap-2 text-xs font-black uppercase tracking-widest text-slate-400 hover:text-slate-600 transition-colors mb-4">
            <i class="bi bi-arrow-left"></i> Назад до шаблонів
        </a>
        <h1 class="text-3xl font-black tracking-tight text-slate-800">
            ✏️ Редагувати: @Model.Title
        </h1>
    </div>

    <div class="bg-white/80 backdrop-blur-md border border-slate-100 rounded-3xl p-6 md:p-8 shadow-xl">
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="Id" />

            <div class="mb-6">
                <label asp-for="Title" class="block text-xs font-black uppercase tracking-widest text-slate-400 mb-2">Назва шаблону</label>
                <input asp-for="Title" class="w-full bg-slate-50 border border-slate-200 rounded-2xl px-4 py-3 text-slate-800 font-bold focus:outline-none focus:border-cyan-500 focus:bg-white transition-all shadow-inner" required />
                <span asp-validation-for="Title" class="text-rose-500 text-xs font-bold mt-1 block"></span>
            </div>

            <div class="mb-8">
                <label class="block text-xs font-black uppercase tracking-widest text-slate-400 mb-4">Елементи шаблону (Речі)</label>

                <div class="space-y-3">
                    @for (int i = 0; i < Model.Items.Count; i++)
                    {
                        <div class="flex items-center gap-3 bg-slate-50/50 border border-slate-100 rounded-2xl p-3 shadow-sm">
                            <input type="hidden" asp-for="@Model.Items[i].Id" />
                            <div class="w-8 h-8 rounded-xl bg-slate-100 flex items-center justify-center text-slate-400 font-black text-xs">
                                @(i + 1)
                            </div>
                            <input asp-for="@Model.Items[i].Content" class="flex-1 bg-transparent border-0 font-bold text-slate-700 focus:ring-0 p-0 outline-none" />
                        </div>
                    }
                </div>
            </div>

            <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-100">
                <button type="submit" class="px-6 py-3 rounded-full font-black text-white bg-cyan-600 hover:bg-cyan-700 hover:shadow-lg active:scale-95 transition-all text-xs uppercase tracking-widest">
                    Зберегти зміни <i class="bi bi-check-circle-fill ml-1"></i>
                </button>
            </div>
        </form>
    </div>
</div>