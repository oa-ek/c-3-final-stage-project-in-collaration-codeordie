@model IEnumerable<TravelManager.UI.Models.ViewModels.ExpenseSplitListViewModel>

@{
    ViewData["Title"] = "Розподіл витрат (Борги)";
    var groupedSplits = Model.GroupBy(x => x.TripName).ToList();
    var currentUserId = ViewBag.CurrentUserId as string;
}

<style>
    @@keyframes fadeSlideUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .stagger-item {
        animation: fadeSlideUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        opacity: 0;
    }

    @@keyframes blob {
        0% {
            transform: translate(0px, 0px) scale(1);
        }

        33% {
            transform: translate(30px, -50px) scale(1.1);
        }

        66% {
            transform: translate(-20px, 20px) scale(0.9);
        }

        100% {
            transform: translate(0px, 0px) scale(1);
        }
    }

    .animate-blob {
        animation: blob 7s infinite alternate;
    }
</style>

<div class="relative w-full max-w-7xl mx-auto min-h-[85vh] py-12 z-10 px-4">

    <!-- Фонові ефекти -->
    <div class="absolute inset-0 flex items-center justify-center pointer-events-none z-0">
        <div class="absolute top-0 right-20 w-[30rem] h-[30rem] bg-indigo-300/20 rounded-full blur-[100px] animate-blob"></div>
        <div class="absolute bottom-0 left-10 w-[20rem] h-[20rem] bg-fuchsia-300/20 rounded-full blur-[100px] animate-blob" style="animation-delay: 2s;"></div>
    </div>

    <!-- Заголовок сторінки -->
    <div class="relative z-20 flex flex-col md:flex-row justify-between items-start md:items-center gap-6 mb-10 border-b border-slate-100 pb-6 stagger-item" style="animation-delay: 0.1s;">
        <div>
            <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/60 backdrop-blur-md border border-white shadow-sm mb-4">
                <i class="bi bi-people-fill text-indigo-500 text-sm"></i>
                <span class="text-[10px] font-black text-slate-500 uppercase tracking-widest">Фінанси учасників</span>
            </div>
            <h1 class="text-4xl md:text-5xl font-black text-slate-800 tracking-tighter leading-none mb-1">
                Розподіл витрат
            </h1>
            <p class="text-slate-500 font-medium text-sm mt-1">Керуйте заборгованостями між учасниками подорожі</p>
        </div>

        <div class="shrink-0 flex items-center gap-3">
            <a asp-controller="Expenses" asp-action="Index" class="inline-flex items-center justify-center px-6 py-4 font-black text-slate-500 transition-all duration-300 bg-white hover:bg-slate-50 border border-slate-200 rounded-full shadow-sm hover:shadow uppercase tracking-widest text-xs">
                <i class="bi bi-arrow-left text-sm mr-2"></i> Назад до витрат
            </a>
        </div>
    </div>

    <div class="relative z-20 space-y-12">
        @if (!Model.Any())
        {
            <div class="bg-white/60 backdrop-blur-md border border-dashed border-slate-200 rounded-[2.5rem] p-12 text-center shadow-sm stagger-item" style="animation-delay: 0.2s;">
                <div class="w-16 h-16 bg-emerald-50 text-emerald-500 rounded-full flex items-center justify-center mx-auto mb-4 border border-emerald-100 shadow-sm">
                    <i class="bi bi-check-all text-3xl"></i>
                </div>
                <h3 class="text-xl font-black text-slate-700 tracking-tight">Усі розрахувалися!</h3>
                <p class="text-slate-400 font-medium text-sm mt-1">Жодних активних заборгованостей не знайдено.</p>
            </div>
        }
        else
        {
            var delay = 0.2m;

            foreach (var group in groupedSplits)
            {
                var firstItem = group.FirstOrDefault();
                var tripId = firstItem != null ? firstItem.TripId : 0;

                <div class="space-y-4 stagger-item" style="animation-delay: @(delay.ToString(System.Globalization.CultureInfo.InvariantCulture))s;">

                    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center px-6 py-4 bg-slate-100/60 border border-slate-200/50 rounded-2xl gap-3">
                        <div class="flex items-center gap-2">
                            <i class="bi bi-airplane-engines text-indigo-500"></i>
                            <h3 class="font-black text-slate-800 text-lg">@group.Key</h3>
                        </div>

                        @if (tripId > 0)
                        {
                            <a asp-controller="Export" asp-action="Trip" asp-route-tripId="@tripId" class="inline-flex items-center gap-1.5 text-xs font-bold text-emerald-700 hover:text-emerald-950 transition-colors bg-emerald-50 border border-emerald-200/60 px-4 py-1.5 rounded-full shadow-inner">
                                <i class="bi bi-file-earmark-spreadsheet-fill"></i> Звіт Excel подорожі
                            </a>
                        }
                    </div>

                    <div class="grid grid-cols-1 gap-4">
                        @foreach (var item in group)
                        {
                            <div class="group relative bg-white/70 backdrop-blur-2xl border border-white/80 rounded-3xl p-5 shadow-sm hover:shadow-xl transition-all duration-300">

                                <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 relative z-10">

                                    <div class="flex-1 min-w-0">
                                        <div class="flex items-center gap-2 mb-2 flex-wrap">
                                            @if (item.IsSettled)
                                            {
                                                <span class="text-[10px] font-black text-emerald-600 uppercase tracking-widest bg-emerald-50 border border-emerald-100/50 px-2.5 py-0.5 rounded-full flex items-center gap-1">
                                                    <i class="bi bi-check-circle-fill"></i> Розраховано
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-[10px] font-black text-amber-600 uppercase tracking-widest bg-amber-50 border border-amber-100/50 px-2.5 py-0.5 rounded-full flex items-center gap-1">
                                                    <i class="bi bi-hourglass-split"></i> Борг
                                                </span>
                                            }
                                            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-widest px-2.5 py-0.5 bg-slate-50 border border-slate-100 rounded-full">
                                                @item.ExpenseTitle
                                            </span>
                                        </div>

                                        <div class="flex flex-col sm:flex-row sm:items-center gap-3 mt-3">
                                            <div class="flex items-center gap-2 bg-rose-50/50 border border-rose-100/50 px-3 py-1.5 rounded-xl">
                                                <i class="bi bi-person-down text-rose-400"></i>
                                                <span class="text-sm font-black text-slate-700">@item.DebtorName</span>
                                            </div>

                                            <i class="bi bi-arrow-right text-slate-300 hidden sm:block"></i>
                                            <i class="bi bi-arrow-down text-slate-300 sm:hidden ml-4"></i>

                                            <div class="flex items-center gap-2 bg-emerald-50/50 border border-emerald-100/50 px-3 py-1.5 rounded-xl">
                                                <i class="bi bi-person-up text-emerald-500"></i>
                                                <span class="text-sm font-black text-slate-700">@item.PayerName</span>
                                            </div>
                                        </div>

                                        @if (!string.IsNullOrEmpty(item.ReceiptImageUrl))
                                        {
                                            <div class="mt-3">
                                                <a href="@item.ReceiptImageUrl" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-xs font-bold text-indigo-600 hover:text-indigo-800 transition-colors bg-indigo-50/50 border border-indigo-100/30 px-3 py-1.5 rounded-xl">
                                                    <i class="bi bi-receipt"></i> Переглянути чек витрати <i class="bi bi-box-arrow-up-right text-[10px]"></i>
                                                </a>
                                            </div>
                                        }
                                    </div>

                                    <!-- Сума боргу -->
                                    <div class="flex flex-col md:items-end justify-center shrink-0 border-t border-slate-100 pt-4 md:pt-0 md:border-0 md:pl-6 md:border-l">
                                        <span class="text-[10px] font-black uppercase tracking-widest text-slate-400 mb-1">Сума</span>
                                        <div class="text-3xl font-black text-slate-800">
                                            @item.OwedAmount <span class="text-emerald-500 text-lg">@item.Currency</span>
                                        </div>
                                    </div>

                                    <!-- ДІЇ: Сплатити або Підтвердити -->
                                    <div class="flex items-center gap-3 mt-4 md:mt-0 shrink-0">

                                        @if (!item.IsSettled)
                                        {
                                            <!-- Якщо поточний користувач - боржник: ПРОСТА кнопка "Позначити сплаченим" -->
                                            @if (currentUserId == item.DebtorId)
                                            {
                                                <form asp-action="MarkAsSettled" asp-route-id="@item.Id" method="post" class="m-0" onsubmit="return confirm('Позначити цей борг як сплачений?');">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit"
                                                            class="px-5 py-3 rounded-2xl bg-emerald-600 hover:bg-emerald-700 text-white font-black text-xs uppercase tracking-widest shadow-md hover:shadow-lg transition-all flex items-center gap-2 hover:-translate-y-0.5 active:scale-95">
                                                        <i class="bi bi-check-circle text-sm"></i> Позначити сплаченим
                                                    </button>
                                                </form>
                                            }
                                            else if (currentUserId == item.PayerId)
                                            {
                                                <form asp-action="MarkAsSettled" asp-route-id="@item.Id" method="post" class="m-0">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit"
                                                            class="w-11 h-11 rounded-xl bg-white border border-slate-200 flex items-center justify-center text-slate-400 hover:text-emerald-600 hover:bg-emerald-50 hover:border-emerald-200 transition-all shadow-sm hover:scale-105"
                                                            title="Підтвердити отримання коштів">
                                                        <i class="bi bi-check2-circle text-lg"></i>
                                                    </button>
                                                </form>
                                            }
                                        }

                                        <!-- Кнопка видалення (доступна всім учасникам з роллю) -->
                                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="m-0"
                                              onsubmit="return confirm('Видалити цей борг?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit"
                                                    class="w-11 h-11 rounded-xl bg-white border border-slate-200 flex items-center justify-center text-slate-400 hover:text-rose-600 hover:bg-rose-50 hover:border-rose-200 transition-all shadow-sm hover:scale-105"
                                                    title="Видалити">
                                                <i class="bi bi-trash3-fill text-sm"></i>
                                            </button>
                                        </form>
                                    </div>

                                </div>
                            </div>
                        }
                    </div>
                </div>
                delay += 0.1m;
            }
        }
    </div>
</div>