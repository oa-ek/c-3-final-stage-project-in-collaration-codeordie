@model TravelManager.UI.Models.ViewModels.AccommodationFormViewModel

@{
    ViewData["Title"] = "Редагувати житло";
}

<link href="https://fonts.googleapis.com/css2?family=Syne:wght@700;800;900&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">

<style>
    * {
        box-sizing: border-box;
    }

    .form-root {
        font-family: 'DM Sans', sans-serif;
        min-height: 100vh;
        padding: 2rem 1rem 4rem;
        position: relative;
        overflow: hidden;
    }

        .form-root::before {
            content: '';
            position: fixed;
            inset: 0;
            background: radial-gradient(ellipse 80% 60% at 10% 20%, rgba(99,102,241,0.12) 0%, transparent 60%), radial-gradient(ellipse 60% 80% at 90% 80%, rgba(236,72,153,0.10) 0%, transparent 60%), radial-gradient(ellipse 50% 50% at 50% 50%, rgba(16,185,129,0.06) 0%, rgba(248,250,252,1) 100%);
            z-index: -1;
        }

    .reveal {
        opacity: 0;
        transform: translateY(20px);
        animation: revUp 0.6s cubic-bezier(.16,1,.3,1) forwards;
    }

    @@keyframes revUp {
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .d1 {
        animation-delay: .05s
    }

    .d2 {
        animation-delay: .12s
    }

    .d3 {
        animation-delay: .19s
    }

    .d4 {
        animation-delay: .26s
    }

    .d5 {
        animation-delay: .33s
    }

    .d6 {
        animation-delay: .40s
    }

    .page-title {
        font-family: 'Syne', sans-serif;
        font-size: clamp(2rem, 5vw, 3.5rem);
        font-weight: 900;
        color: #0f172a;
        line-height: 1;
        letter-spacing: -0.03em;
    }

        .page-title span {
            background: linear-gradient(135deg, #6366f1, #ec4899, #f43f5e);
            background-size: 300% 300%;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            animation: gradFlow 6s ease infinite;
        }

    @@keyframes gradFlow {
        0%, 100% {
            background-position: 0% 50%
        }

        50% {
            background-position: 100% 50%
        }
    }

    .form-wrapper {
        background: rgba(255,255,255,0.8);
        backdrop-filter: blur(24px);
        border: 1px solid rgba(255,255,255,0.9);
        border-radius: 2rem;
        padding: 2.5rem;
        box-shadow: 0 10px 40px rgba(99,102,241,0.06);
    }

    .section-lbl {
        font-family: 'Syne', sans-serif;
        font-size: 1.1rem;
        font-weight: 800;
        color: #1e293b;
        margin: 1.5rem 0 1rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .field-wrap {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
    }

        .field-wrap.full {
            grid-column: 1 / -1;
        }

    .field-label {
        font-size: 0.75rem;
        font-weight: 700;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .field-input, .field-select {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 1rem;
        padding: 0.9rem 1.2rem;
        font-family: 'DM Sans', sans-serif;
        font-size: 0.95rem;
        color: #0f172a;
        font-weight: 500;
        outline: none;
        transition: all 0.2s;
    }

        .field-input:focus, .field-select:focus {
            border-color: #6366f1;
            background: #ffffff;
            box-shadow: 0 0 0 3px rgba(99,102,241,0.1);
        }

    .two-col {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.2rem;
    }

    @@media(max-width:640px) {
        .two-col {
            grid-template-columns: 1fr;
        }
    }

    .val-error {
        color: #ef4444;
        font-size: 0.75rem;
        font-weight: 600;
        margin-top: 0.2rem;
    }

    .optional-tag {
        font-size: 0.6rem;
        background: rgba(99,102,241,0.1);
        color: #6366f1;
        padding: 0.1rem 0.4rem;
        border-radius: 99px;
        margin-left: 0.3rem;
        vertical-align: middle;
    }

    .save-btn {
        background: linear-gradient(135deg, #6366f1, #ec4899);
        color: white;
        border: none;
        border-radius: 1.2rem;
        padding: 1rem 2.5rem;
        font-family: 'Syne', sans-serif;
        font-weight: 800;
        font-size: 1rem;
        cursor: pointer;
        transition: all 0.3s;
        box-shadow: 0 4px 20px rgba(236,72,153,0.3);
    }

        .save-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 30px rgba(236,72,153,0.4);
        }

    .cancel-btn {
        background: transparent;
        color: #64748b;
        font-weight: 700;
        text-decoration: none;
        padding: 1rem 2rem;
        border-radius: 1.2rem;
        transition: all 0.3s;
        border: 1.5px solid #e2e8f0;
    }

        .cancel-btn:hover {
            background: #f1f5f9;
            color: #0f172a;
        }
</style>

<div class="form-root">
    <div style="max-width:800px; margin:0 auto;">

        <div class="reveal d1" style="margin-bottom:2rem; text-align:center;">
            <div class="inline-flex items-center justify-center w-14 h-14 rounded-full bg-white shadow-sm border border-slate-100 mb-3 text-2xl text-fuchsia-500">
                <i class="bi bi-pencil-square"></i>
            </div>
            <h1 class="page-title">Редагувати <span>житло</span></h1>
            <p style="color:#64748b;font-weight:500;margin-top:0.4rem;">Онови дані про готель або апартаменти</p>
        </div>

        <div class="form-wrapper reveal d2">
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <div asp-validation-summary="ModelOnly" class="val-error" style="text-align:center;margin-bottom:1rem;"></div>

                <div class="section-lbl reveal d3"><i class="bi bi-airplane-engines text-indigo-500"></i> Основна інформація</div>
                <div class="two-col reveal d3">
                    <div class="field-wrap">
                        <label class="field-label">Поїздка</label>
                        <select asp-for="TripId" asp-items="Model.TripList" class="field-select">
                            <option disabled selected value="">— Оберіть —</option>
                        </select>
                        <span asp-validation-for="TripId" class="val-error"></span>
                    </div>
                    <div class="field-wrap full">
                        <label class="field-label">Назва житла (Готель/Апартаменти)</label>
                        <input asp-for="Name" class="field-input" placeholder="Напр. Hilton Paris Opera" />
                        <span asp-validation-for="Name" class="val-error"></span>
                    </div>
                </div>

                <div class="section-lbl reveal d4"><i class="bi bi-clock-history text-indigo-500"></i> Дати та час</div>
                <div class="two-col reveal d4">
                    <div class="field-wrap">
                        <label class="field-label">Заїзд (Check-in)</label>
                        <input asp-for="CheckInTime" class="field-input" type="datetime-local" />
                        <span asp-validation-for="CheckInTime" class="val-error"></span>
                    </div>
                    <div class="field-wrap">
                        <label class="field-label">Виїзд (Check-out)</label>
                        <input asp-for="CheckOutTime" class="field-input" type="datetime-local" />
                        <span asp-validation-for="CheckOutTime" class="val-error"></span>
                    </div>
                </div>

                <div class="section-lbl reveal d5"><i class="bi bi-geo-alt-fill text-indigo-500"></i> Локація та Контакти</div>
                <div class="two-col reveal d5">
                    <div class="field-wrap full">
                        <label class="field-label">Адреса</label>
                        <input asp-for="Address" class="field-input" placeholder="Вулиця, місто, країна..." />
                        <span asp-validation-for="Address" class="val-error"></span>
                    </div>
                    <div class="field-wrap">
                        <label class="field-label">Телефон <span class="optional-tag">необов'язково</span></label>
                        <input asp-for="ContactPhone" class="field-input" placeholder="+380..." type="tel" />
                    </div>
                    <div class="field-wrap">
                        <label class="field-label">Вебсайт / Booking <span class="optional-tag">необов'язково</span></label>
                        <input asp-for="WebsiteUrl" class="field-input" placeholder="https://..." type="url" />
                    </div>

                    <div class="field-wrap">
                        <label class="field-label">Широта (Latitude) <span class="optional-tag">опційно</span></label>
                        <input asp-for="Latitude" class="field-input" placeholder="Напр. 48.8566" type="number" step="any" />
                    </div>
                    <div class="field-wrap">
                        <label class="field-label">Довгота (Longitude) <span class="optional-tag">опційно</span></label>
                        <input asp-for="Longitude" class="field-input" placeholder="Напр. 2.3522" type="number" step="any" />
                    </div>
                </div>

                <div class="section-lbl reveal d6"><i class="bi bi-info-circle-fill text-indigo-500"></i> Додатково</div>
                <div class="field-wrap full reveal d6">
                    <label class="field-label">Номер бронювання (PNR) <span class="optional-tag">необов'язково</span></label>
                    <input asp-for="BookingReference" class="field-input" placeholder="Напр. BK-12345678..." />
                </div>

                <div style="display:flex;justify-content:space-between;align-items:center;margin-top:2.5rem;" class="reveal d6">
                    <a asp-action="Index" class="cancel-btn">
                        <i class="bi bi-x-lg"></i> Скасувати
                    </a>
                    <button type="submit" class="save-btn">
                        <i class="bi bi-check2-circle mr-2"></i> Зберегти зміни
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}