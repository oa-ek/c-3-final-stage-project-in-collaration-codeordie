@model IEnumerable<TravelManager.UI.Models.ViewModels.AccommodationListViewModel>

@{
    ViewData["Title"] = "Житло";
    // Групуємо за назвою поїздки
    var groupedAccommodations = Model.GroupBy(x => x.TripTitle ?? "Без назви подорожі").ToList();
}

<link href="https://fonts.googleapis.com/css2?family=Syne:wght@700;800;900&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">

<style>
    .acc-root {
        font-family: 'DM Sans', sans-serif;
        min-height: 100vh;
        padding: 2rem 1rem 4rem;
        position: relative;
        overflow: hidden;
    }

        .acc-root::before {
            content: '';
            position: fixed;
            inset: 0;
            background: radial-gradient(ellipse 80% 60% at 10% 20%, rgba(99,102,241,0.12) 0%, transparent 60%), radial-gradient(ellipse 60% 80% at 90% 80%, rgba(236,72,153,0.10) 0%, transparent 60%), radial-gradient(ellipse 50% 50% at 50% 50%, rgba(255,255,255,0.8) 0%, rgba(248,250,252,1) 100%);
            z-index: -1;
        }

    .reveal {
        opacity: 0;
        transform: translateY(20px);
        animation: revUp 0.65s cubic-bezier(.16,1,.3,1) forwards;
    }

    @@keyframes revUp {
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .d1 {
        animation-delay: .05s
    }

    .page-title {
        font-family: 'Syne', sans-serif;
        font-size: clamp(2rem, 5vw, 3.5rem);
        font-weight: 900;
        color: #0f172a;
        line-height: 1;
        letter-spacing: -0.03em;
    }

        .page-title span {
            background: linear-gradient(135deg, #6366f1, #ec4899, #f43f5e);
            background-size: 300% 300%;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            animation: gradFlow 6s ease infinite;
        }

    @@keyframes gradFlow {
        0%, 100% {
            background-position: 0% 50%
        }

        50% {
            background-position: 100% 50%
        }
    }

    .add-btn {
        background: linear-gradient(135deg, #6366f1, #ec4899);
        color: white;
        border: none;
        border-radius: 1.2rem;
        padding: 0.85rem 1.8rem;
        font-family: 'Syne', sans-serif;
        font-weight: 800;
        font-size: 0.95rem;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        transition: all 0.35s cubic-bezier(.34,1.56,.64,1);
        box-shadow: 0 4px 20px rgba(236,72,153,0.3);
    }

        .add-btn:hover {
            transform: translateY(-3px) scale(1.05);
            box-shadow: 0 10px 35px rgba(236,72,153,0.5);
            color: white;
        }

    .list-wrapper {
        background: rgba(255,255,255,0.65);
        backdrop-filter: blur(24px);
        border: 1px solid rgba(255,255,255,0.8);
        border-radius: 2rem;
        box-shadow: 0 10px 40px rgba(99,102,241,0.06);
        overflow: hidden;
    }

    .acc-table {
        width: 100%;
        border-collapse: collapse;
    }

        .acc-table th {
            background: rgba(255,255,255,0.5);
            padding: 1.2rem 1.5rem;
            text-align: left;
            font-size: 0.75rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: #64748b;
            border-bottom: 1px solid rgba(226,232,240,0.8);
        }

        .acc-table td {
            padding: 1.2rem 1.5rem;
            vertical-align: middle;
            border-bottom: 1px solid rgba(226,232,240,0.5);
            transition: background 0.2s;
        }

        .acc-table tr:last-child td {
            border-bottom: none;
        }

        .acc-table tr:hover td {
            background: rgba(255,255,255,0.9);
        }

    .acc-name {
        font-family: 'Syne', sans-serif;
        font-weight: 800;
        font-size: 1.1rem;
        color: #0f172a;
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .acc-icon {
        width: 42px;
        height: 42px;
        background: linear-gradient(135deg, #6366f1, #8b5cf6);
        color: white;
        border-radius: 1rem;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
        box-shadow: 0 4px 12px rgba(99,102,241,0.25);
    }

    .acc-addr {
        font-size: 0.85rem;
        color: #64748b;
        font-weight: 500;
        margin-top: 0.2rem;
        display: block;
    }

    .date-badge {
        display: inline-flex;
        flex-direction: column;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 0.75rem;
        padding: 0.4rem 0.8rem;
    }

    .date-lbl {
        font-size: 0.65rem;
        text-transform: uppercase;
        color: #94a3b8;
        font-weight: 700;
    }

    .date-val {
        font-size: 0.85rem;
        color: #334155;
        font-weight: 700;
    }

    .status-pill {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        padding: 0.4rem 1rem;
        border-radius: 99px;
        font-size: 0.75rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .pill-ok {
        background: rgba(16,185,129,0.1);
        color: #059669;
    }

    .pill-wait {
        background: rgba(245,158,11,0.1);
        color: #d97706;
    }

    .actions-cell {
        display: flex;
        gap: 0.5rem;
        justify-content: flex-end;
    }

    .icon-btn {
        width: 38px;
        height: 38px;
        border-radius: 1rem;
        display: flex;
        align-items: center;
        justify-content: center;
        border: none;
        cursor: pointer;
        transition: all 0.25s;
        text-decoration: none;
        font-size: 0.9rem;
    }

    .btn-edit {
        background: rgba(99,102,241,0.1);
        color: #6366f1;
    }

        .btn-edit:hover {
            background: #6366f1;
            color: white;
            transform: scale(1.1);
            box-shadow: 0 4px 12px rgba(99,102,241,0.3);
        }

    .btn-delete {
        background: rgba(239,68,68,0.1);
        color: #ef4444;
    }

        .btn-delete:hover {
            background: #ef4444;
            color: white;
            transform: scale(1.1);
            box-shadow: 0 4px 12px rgba(239,68,68,0.3);
        }

</style>

<div class="acc-root">
    <div style="max-width:1100px; margin:0 auto;">

        <div class="reveal d1" style="display:flex; justify-content:space-between; align-items:flex-end; flex-wrap:wrap; gap:1rem; margin-bottom:3rem;">
            <div>
                <h1 class="page-title">Твоє <span>Житло</span></h1>
                <p style="color:#64748b;font-weight:500;margin-top:0.4rem;">Готелі, апартаменти та вілли для відпочинку</p>
            </div>
            <a asp-action="Create" class="add-btn">
                <i class="bi bi-plus-lg"></i> Додати житло
            </a>
        </div>

        @if (!Model.Any())
        {
            <div class="reveal d1" style="background: rgba(255,255,255,0.65); backdrop-filter: blur(24px); border: 2px dashed rgba(236,72,153,0.3); border-radius: 2rem; padding: 5rem 2rem; text-align: center;">
                <h3 style="font-family:'Syne',sans-serif;font-weight:900;color:#0f172a;font-size:1.5rem;margin-bottom:0.5rem;">Де плануєш зупинитись?</h3>
                <p style="color:#94a3b8;font-weight:500;margin-bottom:1.5rem;">Ще немає жодного збереженого варіанту житла.</p>
                <a asp-action="Create" class="add-btn" style="margin:0 auto;"><i class="bi bi-plus-lg"></i> Додати</a>
            </div>
        }
        else
        {
            var animDelay = 0.15m;
            <div style="display:flex; flex-direction:column; gap:3rem;">

                @foreach (var group in groupedAccommodations)
                {
                    <div class="space-y-4 reveal" style="animation-delay: @(animDelay.ToString(System.Globalization.CultureInfo.InvariantCulture))s;">

                        <!-- Шапка групи подорожі -->
                        <div class="flex items-center gap-2 px-6 py-4 bg-white/40 backdrop-blur-md border border-slate-200/50 rounded-2xl mb-4">
                            <i class="bi bi-airplane-engines text-indigo-500"></i>
                            <h3 class="font-black text-slate-800 text-lg m-0">@group.Key</h3>
                        </div>

                        <!-- Таблиця житла для поїздки -->
                        <div class="list-wrapper">
                            <table class="acc-table">
                                <thead>
                                    <tr>
                                        <th>Назва та адреса</th>
                                        <th>Дати проживання</th>
                                        <th>Статус</th>
                                        <th style="text-align:right;">Дії</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in group)
                                    {
                                        <tr>
                                            <td>
                                                <div class="acc-name">
                                                    <div class="acc-icon"><i class="bi bi-house-door-fill"></i></div>
                                                    <div>
                                                        @item.Name
                                                        <span class="acc-addr"><i class="bi bi-geo-alt-fill text-pink-400"></i> @item.Address</span>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                <div style="display:flex; gap:0.5rem; align-items:center;">
                                                    <div class="date-badge">
                                                        <span class="date-lbl">Заїзд</span>
                                                        <span class="date-val">@item.CheckInDate.ToString("dd.MM.yyyy")</span>
                                                    </div>
                                                    <i class="bi bi-arrow-right text-slate-300"></i>
                                                    <div class="date-badge">
                                                        <span class="date-lbl">Виїзд</span>
                                                        <span class="date-val">@item.CheckOutDate.ToString("dd.MM.yyyy")</span>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                <span class="status-pill @(item.BookingStatusName == "Підтверджено" ? "pill-ok" : "pill-wait")">
                                                    <i class="bi @(item.BookingStatusName == "Підтверджено" ? "bi-check-circle-fill" : "bi-clock-fill")"></i>
                                                    @item.BookingStatusName
                                                </span>
                                            </td>
                                            <td>
                                                <div class="actions-cell">
                                                    <a asp-action="Edit" asp-route-id="@item.Id" class="icon-btn btn-edit" title="Редагувати">
                                                        <i class="bi bi-pencil-fill"></i>
                                                    </a>
                                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" style="margin:0;" onsubmit="return confirm('Ви впевнені, що хочете видалити житло @item.Name?')">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="icon-btn btn-delete" title="Видалити">
                                                            <i class="bi bi-trash3-fill"></i>
                                                        </button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                    animDelay += 0.1m;
                }
            </div>
        }
    </div>
</div>