@model TravelManager.UI.Models.ViewModels.ChecklistItemFormViewModel

@{
    ViewData["Title"] = "Редагувати річ";
}

<style>
    @@keyframes fadeSlideUp {
        0% {
            opacity: 0;
            transform: translateY(40px) scale(0.95);
        }

        100% {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    .stagger-item {
        animation: fadeSlideUp 0.8s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
        opacity: 0;
    }

    @@keyframes blob {
        0% {
            transform: translate(0px, 0px) scale(1);
        }

        50% {
            transform: translate(30px, -50px) scale(1.1);
        }

        100% {
            transform: translate(0px, 0px) scale(1);
        }
    }

    .animate-blob {
        animation: blob 8s infinite alternate;
    }

    @@keyframes shimmer {
        0% {
            transform: translateX(-100%) skewX(-15deg);
        }

        100% {
            transform: translateX(200%) skewX(-15deg);
        }
    }
</style>

<div class="relative w-full max-w-2xl mx-auto min-h-[85vh] py-14 z-10 px-4">

    <!-- Фонові декорації -->
    <div class="absolute top-20 right-0 w-72 h-72 bg-emerald-400/20 rounded-full blur-[100px] pointer-events-none animate-blob"></div>
    <div class="absolute bottom-20 left-0 w-72 h-72 bg-cyan-400/20 rounded-full blur-[100px] pointer-events-none animate-blob" style="animation-delay: 2s;"></div>

    <div class="relative z-20 text-center mb-10 stagger-item" style="animation-delay: 0.1s;">
        <div class="inline-flex items-center justify-center w-16 h-16 rounded-3xl bg-white shadow-xl border border-slate-100 mb-6 relative group overflow-hidden">
            <div class="absolute inset-0 bg-emerald-500 opacity-0 group-hover:opacity-10 transition-opacity duration-300"></div>
            <i class="bi bi-pencil-square text-3xl text-emerald-500 drop-shadow-sm group-hover:scale-110 transition-transform duration-300"></i>
        </div>
        <h1 class="text-4xl md:text-5xl font-black text-slate-800 tracking-tighter leading-none mb-3">Редагувати річ</h1>
        <p class="text-slate-500 font-medium text-base">Внесіть необхідні зміни</p>
    </div>

    <div class="relative z-20 bg-white/70 backdrop-blur-2xl border border-white/80 rounded-[3rem] p-8 md:p-12 shadow-[0_20px_60px_-15px_rgba(0,0,0,0.05)] stagger-item" style="animation-delay: 0.2s;">

        <form asp-action="Edit" method="post" class="space-y-8 relative">
            <div asp-validation-summary="ModelOnly" class="text-red-500 text-sm font-bold bg-red-50 p-4 rounded-2xl border border-red-100"></div>

            <input type="hidden" asp-for="Id" />
            <!-- Робимо поле ChecklistId прихованим, щоб його не можна було змінити -->
            <input type="hidden" asp-for="ChecklistId" />

            <!-- Поле: Назва речі -->
            <div class="group relative">
                <label asp-for="Content" class="block text-[11px] font-black uppercase tracking-widest text-slate-400 mb-2 ml-4">Назва речі *</label>
                <div class="relative flex items-center">
                    <div class="absolute left-5 text-slate-400 group-focus-within:text-emerald-500 transition-colors z-10">
                        <i class="bi bi-tag text-lg"></i>
                    </div>
                    <input asp-for="Content"
                           class="w-full bg-slate-50/50 hover:bg-slate-50 border-2 border-slate-100 rounded-3xl pl-14 pr-6 py-4
                                  text-slate-700 font-bold placeholder:text-slate-400 focus:bg-white
                                  focus:border-emerald-400 focus:ring-0 transition-all duration-300 shadow-sm focus:shadow-md outline-none"
                           placeholder="Наприклад: Паспорт" />
                </div>
                <span asp-validation-for="Content" class="text-rose-500 text-xs font-bold mt-2 ml-4 block absolute -bottom-6"></span>
            </div>

            <!-- Чекбокс: Зібрано -->
            <div class="mt-4 pt-4 border-t border-slate-100">
                <label class="relative flex items-center justify-between p-5 rounded-3xl border-2 border-slate-100 bg-slate-50/50 hover:bg-slate-50 cursor-pointer transition-all duration-300 group hover:border-emerald-200">
                    <div class="flex items-center gap-4">
                        <div class="w-12 h-12 rounded-full bg-emerald-100 flex items-center justify-center border border-emerald-200 shadow-inner group-hover:scale-105 transition-transform">
                            <i class="bi bi-check2-circle text-emerald-600 text-xl"></i>
                        </div>
                        <div>
                            <span class="block text-sm font-black text-slate-700 uppercase tracking-widest">Зібрано</span>
                            <span class="block text-xs text-slate-500 mt-0.5">Відмітьте, якщо річ вже у валізі</span>
                        </div>
                    </div>
                    <div class="relative">
                        <input asp-for="IsChecked" type="checkbox" class="sr-only peer" />
                        <div class="w-14 h-8 bg-slate-200 rounded-full peer peer-focus:ring-4 peer-focus:ring-emerald-300/30 peer-checked:bg-emerald-500 transition-all duration-300 shadow-inner"></div>
                        <div class="absolute left-1 top-1 w-6 h-6 bg-white rounded-full transition-all duration-300 peer-checked:translate-x-6 shadow-sm"></div>
                    </div>
                </label>
            </div>

            <!-- Кнопки керування -->
            <div class="flex flex-col sm:flex-row gap-4 pt-6">
                <!-- Кнопка повернення: використовуємо JS для повернення на попередню сторінку -->
                <button type="button" onclick="history.back()"
                        class="flex-1 px-6 py-4 rounded-full font-black text-slate-500 bg-white hover:bg-slate-50 border-2 border-slate-100 shadow-sm transition-all duration-300 text-xs uppercase tracking-widest text-center">
                    Скасувати
                </button>

                <button type="submit"
                        class="flex-[2] relative group overflow-hidden px-8 py-4 rounded-full font-black text-white bg-slate-900 shadow-xl hover:shadow-2xl hover:-translate-y-1 transition-all duration-300 text-xs uppercase tracking-widest flex items-center justify-center gap-3 border border-slate-800">
                    <span class="absolute inset-0 w-[200%] bg-gradient-to-r from-transparent via-white/20 to-transparent -translate-x-[150%] group-hover:animate-[shimmer_1.5s_infinite]"></span>
                    <span class="relative">Зберегти зміни</span>
                    <i class="bi bi-save2-fill relative text-sm"></i>
                </button>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}