@model IEnumerable<TravelManager.UI.Models.ViewModels.TripActivityListViewModel>

@{
    ViewData["Title"] = "Активності";
    // Групуємо за назвою поїздки
    var groupedActivities = Model.GroupBy(x => x.TripTitle ?? "Без назви подорожі").ToList();
}

<link href="https://fonts.googleapis.com/css2?family=Syne:wght@700;800;900&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">

<style>
    .act-root {
        font-family: 'DM Sans', sans-serif;
        padding: 2rem 0 4rem;
        position: relative;
    }

    .reveal {
        opacity: 0;
        transform: translateY(20px);
        animation: revUp 0.65s cubic-bezier(.16,1,.3,1) forwards;
    }

    @@keyframes revUp {
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .page-title {
        font-family: 'Syne', sans-serif;
        font-size: clamp(2rem,5vw,3.2rem);
        font-weight: 900;
        color: #0f172a;
    }

        .page-title span {
            background: linear-gradient(135deg, #f59e0b, #ef4444);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

    .add-btn {
        background: linear-gradient(135deg, #f59e0b, #ef4444);
        color: white;
        border-radius: 1.2rem;
        padding: 0.85rem 1.8rem;
        font-family: 'Syne', sans-serif;
        font-weight: 800;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        transition: all 0.3s;
    }

        .add-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 30px rgba(239,68,68,0.4);
            color: white;
        }

    /* Картка активності */
    .activity-card {
        background: rgba(255,255,255,0.7);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(255,255,255,0.8);
        border-radius: 1.5rem;
        padding: 1.5rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        transition: all 0.3s;
        box-shadow: 0 4px 20px rgba(0,0,0,0.05);
    }

        .activity-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 35px rgba(245,158,11,0.15);
            border-color: rgba(245,158,11,0.3);
        }

    .act-icon {
        width: 50px;
        height: 50px;
        border-radius: 1rem;
        background: linear-gradient(135deg, #fde68a, #fef3c7);
        color: #d97706;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        flex-shrink: 0;
    }
</style>

<div class="act-root">
    <div style="max-width:1100px; margin:0 auto; padding:0 1rem;">

        <div class="reveal" style="display:flex; justify-content:space-between; align-items:flex-end; flex-wrap:wrap; gap:1rem; margin-bottom:3rem;">
            <div>
                <h1 class="page-title">Плани та <span>Активності</span></h1>
                <p style="color:#64748b;font-weight:500;margin-top:0.4rem;">Екскурсії, музеї, ресторани та розваги</p>
            </div>
            <a asp-action="Create" class="add-btn">
                <i class="bi bi-plus-lg"></i> Додати активність
            </a>
        </div>

        @if (!Model.Any())
        {
            <div class="reveal" style="text-align: center; padding: 4rem; border: 2px dashed #fcd34d; border-radius: 2rem;">
                <span style="font-size: 3rem;">🎢</span>
                <h3 style="font-family:'Syne'; font-weight:800; margin-top:1rem;">Ще нічого не заплановано</h3>
                <p style="color:#64748b; margin-bottom: 1.5rem;">Додайте цікаві місця для відвідування!</p>
                <a asp-action="Create" class="add-btn"><i class="bi bi-plus-lg"></i> Додати</a>
            </div>
        }
        else
        {
            var animDelay = 0.15m;
            <div style="display:flex; flex-direction:column; gap:3rem;">

                @foreach (var group in groupedActivities)
                {
                    <div class="space-y-4 reveal" style="animation-delay: @(animDelay.ToString(System.Globalization.CultureInfo.InvariantCulture))s;">

                        <!-- Шапка групи подорожі -->
                        <div class="flex items-center gap-2 px-6 py-4 bg-white/40 backdrop-blur-md border border-slate-200/50 rounded-2xl mb-4">
                            <i class="bi bi-airplane-engines text-indigo-500"></i>
                            <h3 class="font-black text-slate-800 text-lg m-0">@group.Key</h3>
                        </div>

                        <!-- Список активностей -->
                        <div style="display:flex; flex-direction:column; gap:1rem;">
                            @foreach (var item in group)
                            {
                                <div class="activity-card">
                                    <div style="display:flex; align-items:center; gap:1.2rem;">
                                        <div class="act-icon"><i class="bi bi-ticket-perforated-fill"></i></div>
                                        <div>
                                            <h4 style="font-family:'Syne'; font-weight:800; font-size:1.2rem; color:#0f172a; margin:0;">@item.Title</h4>
                                            <div style="display:flex; gap:1rem; margin-top:0.3rem; font-size:0.85rem; color:#64748b; font-weight:500;">
                                                <span><i class="bi bi-calendar-event text-amber-500"></i> @item.Date.ToString("dd.MM.yyyy HH:mm")</span>
                                                @if (!string.IsNullOrEmpty(item.Location))
                                                {
                                                    <span><i class="bi bi-geo-alt-fill text-amber-500"></i> @item.Location</span>
                                                }
                                            </div>
                                        </div>
                                    </div>

                                    <div style="display:flex; gap:0.5rem;">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="w-10 h-10 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center hover:bg-indigo-600 hover:text-white transition-all">
                                            <i class="bi bi-pencil-fill"></i>
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Видалити?')">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="w-10 h-10 rounded-xl bg-rose-50 text-rose-600 flex items-center justify-center hover:bg-rose-600 hover:text-white transition-all border-0">
                                                <i class="bi bi-trash3-fill"></i>
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                    animDelay += 0.1m;
                }
            </div>
        }
    </div>
</div>